Private Sub MakeToolBar()
    Dim objButton As Button

    With tbMain
        Set .ImageList = imgTB
        Set .HotImageList = imgTB
        Set objButton = .Buttons.Add(, "addprop", , , "addprop")
        Set objButton = .Buttons.Add(, "delprop", , , "delprop")
        Set objButton = .Buttons.Add(, , , tbrSeparator)
        Set objButton = .Buttons.Add(, "delete", , , "delete")
        Set objButton = .Buttons.Add(, , , tbrSeparator)
        Set objButton = .Buttons.Add(, "copie", , , "copie")
        Set objButton = .Buttons.Add(, , , tbrSeparator)

        Select Case lngLanguage
            Case c2i_Langue_Français
                .Buttons("addprop").ToolTipText = "Ajouter une propriétée"
                .Buttons("delprop").ToolTipText = "Supprimer la propriété"
                .Buttons("delete").ToolTipText = "Remise à zéro"
                .Buttons("copie").ToolTipText = "Copier le code généré"
            Case Else
                .Buttons("addprop").ToolTipText = "Add a property"
                .Buttons("delprop").ToolTipText = "Delete property"
                .Buttons("delete").ToolTipText = "Delete all"
                .Buttons("copie").ToolTipText = "Copy generated code"
        End Select
    End With

    Set objButton = Nothing
End Sub

Private Sub UserDocument_Paint()
    On Error Resume Next
    txtName.SetFocus
End Sub

Private Sub tbMain_ButtonClick(ByVal Button As MSComctlLib.Button)
    Select Case Button.Key
        Case "addprop"
            AjouteProp
        Case "delprop"
            DelProp
        Case "delete"
            Effacer
        Case "copie"
            CopieCode
    End Select
End Sub

Private Sub CopieCode()
    If VBInstance.ActiveCodePane Is Nothing Then
        MsgBox "Aucune fenêtre de code active", vbInformation
    Else
        With VBInstance.ActiveCodePane.CodeModule
            .AddFromString txtCodeDeclarationView
            .InsertLines .CountOfLines + 1, txtCodeView
        End With
        Effacer
    End If

End Sub

Private Sub UserDocument_Resize()
    On Error Resume Next
    frameLstProp.Height = ScaleHeight - frameLstProp.Top - 120
    tvCode.Height = frameLstProp.Height - tvCode.Top - 120

    FrameCode.Height = ScaleHeight - FrameCode.Top - 120
    FrameCode.Width = ScaleWidth - FrameCode.Left - 120
    txtCodeDeclarationView.Width = FrameCode.Width - txtCodeDeclarationView.Left - 120
    txtCodeView.Width = txtCodeDeclarationView.Width
    txtCodeView.Height = FrameCode.Height - txtCodeView.Top - 120
End Sub
