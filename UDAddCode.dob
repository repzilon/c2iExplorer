Option Explicit

'Modifié par René Rhéaume le 28 juillet 2001
'Utilise un fichier INI et des fonctions API
Private Sub UserDocument_Initialize()
'    'Ancienne version
'    Dim fso As FileSystemObject, txtFile As TextStream
'    Dim c2iTypeFile As String
    'Commun aux deux versions
    Dim lngDeb As Long
    Dim sObj As String, sName As String, sType As String
    'Nouvelle version
    Dim chnContenuSectionTypes As String, tblSectionTypes() As String
    Dim I As Long, iPos As Long, iPos2 As Long

    On Error GoTo Fin
    
    'Nouvelle version
    lngDeb = GetPrivateProfileInt("General", "DefaultType", 6, c2iINIFile)
    chnContenuSectionTypes = LireSectionFichierINI("Types", c2iINIFile)
    SplitB chnContenuSectionTypes, tblSectionTypes(), vbNullChar
    
    For I = 0 To UBound(tblSectionTypes()) - 1
        iPos = InStr(1, tblSectionTypes(I), "=")
        sName = Trim$(Left$(tblSectionTypes(I), iPos - 1))
        cmbLstType.AddItem sName
        iPos2 = InStr(iPos + 1, tblSectionTypes(I), ";")
        sObj = Trim$(Mid$(tblSectionTypes(I), iPos + 1, iPos2 - iPos - 1))
        cmbObjV.AddItem sObj
        sType = Trim$(Right$(tblSectionTypes(I), Len(tblSectionTypes(I)) - iPos2))
        cmbLstDeb.AddItem sType
    Next I
    cmbLstType.ListIndex = lngDeb
    
'    'Ancienne version
'    c2iTypeFile = App.Path + "\data\types.txt"
'
'    Set fso = New FileSystemObject
'    Set txtFile = fso.OpenTextFile(c2iTypeFile)
'    lngDeb = CLng(txtFile.ReadLine)
'
'    With cmbLstType
'        Do Until txtFile.AtEndOfStream
'            LectureLigne sObj, sName, sType, txtFile.ReadLine
'            .AddItem sName
'            cmbLstDeb.AddItem sType
'            cmbObjV.AddItem sObj
'        Loop
'        txtFile.Close
'
'        .ListIndex = lngDeb
'    End With
'    Set txtFile = Nothing
'    Set fso = Nothing

    MakeToolBar
    If lngLanguage = c2i_Langue_Français Then
        FrameProp.Caption = "Propriété :"
        lblNom = "Nom :"
        frameLstProp.Caption = "Liste des propriétés"
        FrameCode.Caption = "Code généré"
    Else
        FrameProp.Caption = "Property :"
        lblNom = "Name :"
        frameLstProp.Caption = "Properties list"
        FrameCode.Caption = "Generated code"
    End If
    UserDocument_Resize
    Exit Sub
Fin:
    'Nouvelle version
    If lngLanguage = c2i_Langue_Français Then
        MsgBox "Erreur au chargement de " & c2iINIFile & vbCrLf & _
            "Numéro d'erreur : " & Err.Number & vbCrLf & _
            "Description : " & Err.Description & vbCrLf & _
            "Source : " & Err.Source, vbInformation
    Else
        MsgBox "Error when loading file" & c2iINIFile & vbCrLf & _
            "Error number : " & Err.Number & vbCrLf & _
            "Description : " & Err.Description & vbCrLf & _
            "Source : " & Err.Source, vbInformation
    End If
'    'Ancienne version
'    If lngLanguage = c2i_Langue_Français Then
'        MsgBox "Erreur au chargement de " & c2iTypeFile, vbInformation
'    Else
'        MsgBox "Error in loading document" & c2iTypeFile, vbInformation
'    End If
'    Set txtFile = Nothing
'    Set fso = Nothing
End Sub

Private Function ExtractName(ByVal sText As String) As String
    Dim lDeb As Long
    lDeb = InStr(1, sText, "(")
    ExtractName = Trim$(Left$(sText, lDeb - 1))
End Function

Private Function ExtractType(ByVal sText As String) As String
    Dim lDeb As Long
    lDeb = InStr(1, sText, "(")
    ExtractType = Mid$(sText, lDeb + 1, Len(sText) - lDeb - 1)
End Function

Private Sub AjouteProp()
    If txtName = "" Then Exit Sub
    If cmbLstType.ListIndex = -1 Then Exit Sub

    Dim mN As Node, mNFils As Node
    Dim sType As String

    On Error GoTo GestErr
    'ajoute la nouvelle propriété au treeview, si elle existe ->GestErr

    sType = txtName + " (" + cmbLstType.List(cmbLstType.ListIndex) + ")"
    If cmbObjV.List(cmbLstType.ListIndex) = "o" Then
        Set mN = tvCode.Nodes.Add(, , txtName, sType, "objet")
    Else
        Set mN = tvCode.Nodes.Add(, , txtName, sType, "prop")
    End If
    mN.Tag = cmbLstDeb.List(cmbLstType.ListIndex)

    'couleur suivant la portée
    If tb.Buttons("pub").Value = tbrPressed Then mN.ForeColor = vbBlue
    If tb.Buttons("priv").Value = tbrPressed Then mN.ForeColor = vbBlack
    If tb.Buttons("frie").Value = tbrPressed Then mN.ForeColor = vbRed

    'Lecture ecriture
    If tb.Buttons("lectureecriture").Value = tbrPressed Then
        If cmbObjV.List(cmbLstType.ListIndex) = "o" Then
            Set mNFils = tvCode.Nodes.Add(mN, tvwChild, , "Set", "set")
        Else
            Set mNFils = tvCode.Nodes.Add(mN, tvwChild, , "Let", "let")
        End If
        mNFils.ForeColor = mNFils.Parent.ForeColor

        Set mNFils = tvCode.Nodes.Add(mN, tvwChild, , "Get", "get")
        mNFils.ForeColor = mNFils.Parent.ForeColor
        Set mNFils = Nothing
        Set mN = Nothing
        VoirCode
        Exit Sub
    End If

    'lecture
    If tb.Buttons("lecture").Value = tbrPressed Then
        Set mNFils = tvCode.Nodes.Add(mN, tvwChild, , "Get", "get")
        mNFils.ForeColor = mNFils.Parent.ForeColor
        Set mNFils = Nothing
        Set mN = Nothing
        VoirCode
        Exit Sub
    End If

    'Lecture ecriture
    If tb.Buttons("ecriture").Value = tbrPressed Then
        If cmbObjV.List(cmbLstType.ListIndex) = "o" Then
            Set mNFils = tvCode.Nodes.Add(mN, tvwChild, , "Set", "set")
        Else
            Set mNFils = tvCode.Nodes.Add(mN, tvwChild, , "Let", "let")
        End If
        mNFils.ForeColor = mNFils.Parent.ForeColor
        Set mNFils = Nothing
        Set mN = Nothing
        VoirCode
        Exit Sub
    End If

GestErr:
    If Err.Number = 35602 Then
        MsgBox "Cette propriété existe déjà", vbInformation
    Else
        MsgBox "Erreur inconnue : " + CStr(Err.Description), vbCritical
    End If
End Sub

Private Sub Effacer()
    tvCode.Nodes.Clear
    VoirCode
End Sub

Private Sub DelProp()
    If tvCode.SelectedItem Is Nothing Then Exit Sub
    'vérif que ce n'est pas le dernier child
    If Not tvCode.SelectedItem.Parent Is Nothing Then
        If tvCode.SelectedItem.Parent.Children = 1 Then
            tvCode.Nodes.Remove tvCode.SelectedItem.Parent.Index
            VoirCode
            Exit Sub
        End If
    End If
    tvCode.Nodes.Remove tvCode.SelectedItem.Index
    VoirCode
End Sub

Private Sub VoirCode()
    Dim sDeclaration As String, sCode As String
    Dim mN As Node, mNFils As Node

    txtCodeDeclarationView = ""
    txtCodeView = ""

    If tvCode.Nodes.Count = 0 Then Exit Sub

    Set mN = tvCode.Nodes(1)
    Do Until mN Is Nothing
        'dans la zone déclaration
        sDeclaration = sDeclaration + "Private " + _
                mN.Tag + ExtractName(mN.Text) + _
                " As " + ExtractType(mN.Text) + vbCrLf
        'dans la zone code
        Set mNFils = mN.Child
        Do Until mNFils Is Nothing
            'détermination de la portée
            Select Case mN.ForeColor
                Case vbBlue                                'public
                    sCode = sCode + "Public Property "
                Case vbBlack                               'private
                    sCode = sCode + "Private Property "
                Case vbRed                                 'friend
                    sCode = sCode + "Friend Property "
            End Select
            Select Case mNFils.Text
                Case "Get"
                    sCode = sCode + mNFils.Text + " " + ExtractName(mN.Text) + "()"
                    sCode = sCode + " As " + ExtractType(mN.Text) + vbCrLf
                    If mN.Image = "prop" Then
                        sCode = sCode + ExtractName(mN.Text) + " = " + mN.Tag + ExtractName(mN.Text) + vbCrLf
                    Else
                        sCode = sCode + "Set " + ExtractName(mN.Text) + " = " + mN.Tag + ExtractName(mN.Text) + vbCrLf
                    End If
                Case "Set"
                    sCode = sCode + mNFils.Text + " " + ExtractName(mN.Text) + "(ByVal " + mN.Tag + ExtractName(mN.Text) + "A As " + ExtractType(mN.Text) + ")" + vbCrLf
                    sCode = sCode + "Set " + mN.Tag + ExtractName(mN.Text) + " = " + mN.Tag + ExtractName(mN.Text) + "A" + vbCrLf
                Case "Let"
                    sCode = sCode + mNFils.Text + " " + ExtractName(mN.Text) + "(ByVal " + mN.Tag + ExtractName(mN.Text) + "A As " + ExtractType(mN.Text) + ")" + vbCrLf
                    sCode = sCode + mN.Tag + ExtractName(mN.Text) + " = " + mN.Tag + ExtractName(mN.Text) + "A" + vbCrLf
            End Select
            sCode = sCode + "End Property" + vbCrLf + vbCrLf
            Set mNFils = mNFils.Next
        Loop

        Set mN = mN.Next
    Loop

    sDeclaration = "'//************Généré par c2iExplorer*******************" + vbCrLf + sDeclaration

    txtCodeDeclarationView = sDeclaration
    txtCodeView = sCode
    Set mNFils = Nothing
    Set mN = Nothing

    On Error Resume Next
    txtName = ""
    txtName.SetFocus

End Sub

