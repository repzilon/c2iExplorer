Private Sub MakeToolBar()
    Dim objButton As Button

    With tbMain
        Set .ImageList = imgTB
        Set .HotImageList = imgTB
        Set objButton = .Buttons.Add(, conAddprop, , , conAddprop)
        Set objButton = .Buttons.Add(, conDelprop, , , conDelprop)
        Set objButton = .Buttons.Add(, , , tbrSeparator)
        Set objButton = .Buttons.Add(, conDelete, , , conDelete)
        Set objButton = .Buttons.Add(, , , tbrSeparator)
        Set objButton = .Buttons.Add(, conCopie, , , conCopie)
        Set objButton = .Buttons.Add(, , , tbrSeparator)

        Select Case lngLanguage
            Case c2i_Langue_Anglais
                .Buttons(conAddprop).ToolTipText = "Add a property"
                .Buttons(conDelprop).ToolTipText = "Delete property"
                .Buttons(conDelete).ToolTipText = "Delete all"
                .Buttons(conCopie).ToolTipText = "Copy generated code"
            Case Else
                .Buttons(conAddprop).ToolTipText = "Ajouter une propriété"
                .Buttons(conDelprop).ToolTipText = "Supprimer la propriété"
                .Buttons(conDelete).ToolTipText = "Remise à zéro"
                .Buttons(conCopie).ToolTipText = "Copier le code généré"
        End Select
    End With

    Set objButton = Nothing
End Sub

Private Sub UserDocument_Paint()
    On Error Resume Next
    txtName.SetFocus
End Sub

Private Sub tbMain_ButtonClick(ByVal Button As MSComctlLib.Button)
    Select Case Button.Key
        Case conAddprop
            AjouteProp
        Case conDelprop
            DelProp
        Case conDelete
            Effacer
        Case conCopie
            CopieCode
    End Select
End Sub

Private Sub CopieCode()
    If (VBInstance.ActiveCodePane Is Nothing) Then
        MsgBox "Aucune fenêtre de code active", vbInformation
    Else
        With VBInstance.ActiveCodePane.CodeModule
            .AddFromString txtCodeDeclarationView
            .InsertLines .CountOfLines + 1, txtCodeView
        End With
        Effacer
    End If
End Sub

Private Sub UserDocument_Resize()
    Const conEspaceLibre As Single = 120
    Dim sngHauteurLstProp As Single
    Dim sngLargeurFraCode As Single
    Dim sngHauteurFraCode As Single
    Dim sngHauteurEchelle As Single
    Dim sngLargeurZoneCode As Single

    sngHauteurEchelle = ScaleHeight
    sngHauteurLstProp = sngHauteurEchelle - frameLstProp.Top - conEspaceLibre
    sngLargeurFraCode = ScaleWidth - FrameCode.Left - conEspaceLibre
    sngHauteurFraCode = sngHauteurEchelle - FrameCode.Top - conEspaceLibre
    sngLargeurZoneCode = sngLargeurFraCode - txtCodeDeclarationView.Left - conEspaceLibre

    On Error Resume Next
    frameLstProp.Height = sngHauteurLstProp
    tvCode.Height = sngHauteurLstProp - tvCode.Top - conEspaceLibre
    FrameCode.Height = sngHauteurFraCode
    FrameCode.Width = sngLargeurFraCode
    txtCodeDeclarationView.Width = sngLargeurFraCode - txtCodeDeclarationView.Left - conEspaceLibre
    txtCodeView.Width = sngLargeurZoneCode
    txtCodeView.Height = sngHauteurFraCode - txtCodeView.Top - conEspaceLibre
End Sub
