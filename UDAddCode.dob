Option Explicit

Private Const conObjet As String = "objet"
Private Const conProp As String = "prop"
Private Const conAddprop As String = "addprop"
Private Const conDelprop As String = "delprop"
Private Const conDelete As String = "delete"
Private Const conCopie As String = "copie"
Private strarCatDonnes() As String
Private strarPrefixes() As String

'Modifié par René Rhéaume le 28 juillet 2001
'Optimisé par René Rhéaume le 6 janvier 2002
'Utilise un fichier INI et des fonctions API
Private Sub UserDocument_Initialize()
    '    'Ancienne version
    '    Dim fso As FileSystemObject, txtFile As TextStream
    '    Dim c2iTypeFile As String
    'Commun aux deux versions
    Dim lngDeb As Long
    Dim sObj As String, sName As String, sType As String
    'Nouvelle version
    Dim chnContenuSectionTypes As String, tblSectionTypes() As String
    Dim I As Long, iPos As Long, iPos2 As Long
    Dim lngFinTab As Long
    On Error GoTo Fin

    'Nouvelle version
    lngDeb = GetPrivateProfileInt(conSecGen, "DefaultType", 6, c2iINIFile)
    chnContenuSectionTypes = LireSectionFichierINI("Types", c2iINIFile)
    SplitB chnContenuSectionTypes, tblSectionTypes(), vbNullChar

    lngFinTab = UBound(tblSectionTypes()) - 1
    ReDim strarCatDonnes(0 To lngFinTab)
    ReDim strarPrefixes(0 To lngFinTab)
    For I = 0 To lngFinTab
        iPos = InStr(1, tblSectionTypes(I), "=")
        sName = Trim$(Left$(tblSectionTypes(I), iPos - 1))
        cmbLstType.AddItem sName
        iPos2 = InStr(iPos + 1, tblSectionTypes(I), ";")
        sObj = Trim$(Mid$(tblSectionTypes(I), iPos + 1, iPos2 - iPos - 1))
        strarCatDonnes(I) = sObj
        sType = Trim$(Right$(tblSectionTypes(I), Len(tblSectionTypes(I)) - iPos2))
        strarPrefixes(I) = sType
    Next I
    cmbLstType.ListIndex = lngDeb

    '    'Ancienne version
    '    c2iTypeFile = strCheminApp + "\data\types.txt"
    '
    '    Set fso = New FileSystemObject
    '    Set txtFile = fso.OpenTextFile(c2iTypeFile)
    '    lngDeb = CLng(txtFile.ReadLine)
    '
    '    With cmbLstType
    '        Do Until txtFile.AtEndOfStream
    '            LectureLigne sObj, sName, sType, txtFile.ReadLine
    '            .AddItem sName
    '            cmbLstDeb.AddItem sType
    '            cmbObjV.AddItem sObj
    '        Loop
    '        txtFile.Close
    '
    '        .ListIndex = lngDeb
    '    End With
    '    Set txtFile = Nothing
    '    Set fso = Nothing

    MakeToolBar
    If (lngLanguage = c2i_Langue_Anglais) Then
        FrameProp.Caption = "Property :"
        lblNom = "Name :"
        frameLstProp.Caption = "Properties list"
        FrameCode.Caption = "Generated code"
    Else
        FrameProp.Caption = "Propriété :"
        lblNom = "Nom :"
        frameLstProp.Caption = "Liste des propriétés"
        FrameCode.Caption = "Code généré"
    End If
    UserDocument_Resize
    Exit Sub
Fin:
    If (lngLanguage = c2i_Langue_Anglais) Then
        MsgBox "Error when loading file" & c2iINIFile & vbCrLf & _
                "Error number : " & Err.Number & vbCrLf & _
                "Description : " & Err.Description & vbCrLf & _
                "Source : " & Err.Source, vbExclamation
    Else
        MsgBox "Erreur au chargement de " & c2iINIFile & vbCrLf & _
                "Numéro d'erreur : " & Err.Number & vbCrLf & _
                "Description : " & Err.Description & vbCrLf & _
                "Source : " & Err.Source, vbExclamation
    End If
    '    'Ancienne version
    '    Set txtFile = Nothing
    '    Set fso = Nothing
End Sub

Private Function ExtractName(ByVal sText As String) As String
    Dim lDeb As Long
    lDeb = InStr(1, sText, "(")
    ExtractName = Trim$(Left$(sText, lDeb - 1))
End Function

Private Function ExtractType(ByVal sText As String) As String
    Dim lDeb As Long
    lDeb = InStr(1, sText, "(")
    ExtractType = Mid$(sText, lDeb + 1, Len(sText) - lDeb - 1)
End Function

' Optimisé par René Rhéaume le 6 janvier 2002
Private Sub AjouteProp()
    ' -------------------- DÉCLARATION VARIABLES ---------------------
    Dim mN As Node, mNFils As Node
    Dim sType As String
    Dim blnLecture As Boolean
    Dim blnEcriture As Boolean
    Dim blnObjet As Boolean
    Dim lngIdxSel As Long
    Dim strNom As String
    Dim lngCouleur As Long
    ' ---------------------------- ENTRÉE ----------------------------
    strNom = txtName.Text
    lngIdxSel = cmbLstType.ListIndex
    ' -------------------------- TRAITEMENT --------------------------
    If (strNom <> vbNullString) Then
        If (lngIdxSel > -1) Then
            On Error GoTo GestErr
            sType = strNom & " (" & cmbLstType.List(lngIdxSel) & ")"
            blnObjet = (strarCatDonnes(lngIdxSel) = "o")

            'ajoute la nouvelle propriété au treeview, si elle existe ->GestErr
            If (blnObjet) Then
                Set mN = tvCode.Nodes.Add(, , strNom, sType, conObjet)
            Else
                Set mN = tvCode.Nodes.Add(, , strNom, sType, conProp)
            End If
            mN.Tag = strarPrefixes(lngIdxSel)

            'couleur suivant la portée
            Select Case tbrPressed
                Case tb.Buttons("pub").Value
                    lngCouleur = Mem_Public
                Case tb.Buttons("priv").Value
                    lngCouleur = Mem_Privee
                Case tb.Buttons("frie").Value
                    lngCouleur = Mem_Friend
            End Select
            mN.ForeColor = lngCouleur

            Select Case tbrPressed
                Case tb.Buttons("lectureecriture").Value
                    blnLecture = conVrai
                    blnEcriture = conVrai
                Case tb.Buttons("lecture").Value
                    blnLecture = conVrai
                Case tb.Buttons("ecriture").Value
                    blnEcriture = conVrai
            End Select

            If (blnEcriture) Then
                If (blnObjet) Then
                    Set mNFils = tvCode.Nodes.Add(mN, tvwChild, , conSet, conSet)
                Else
                    Set mNFils = tvCode.Nodes.Add(mN, tvwChild, , conLet, conLet)
                End If
                mNFils.ForeColor = lngCouleur
            End If
            If (blnLecture) Then
                Set mNFils = tvCode.Nodes.Add(mN, tvwChild, , conGet, conGet)
                mNFils.ForeColor = lngCouleur
            End If

            Set mNFils = Nothing
            Set mN = Nothing
            VoirCode
            Exit Sub
        End If
    End If

GestErr:
    Set mNFils = Nothing
    Set mN = Nothing
    If (Err.Number) = 35602 Then
        MsgBox "Cette propriété existe déjà", vbInformation
    Else
        MsgBox "Erreur inconnue : " & CStr(Err.Description), vbCritical
    End If
End Sub

Private Sub Effacer()
    tvCode.Nodes.Clear
    VoirCode
End Sub

Private Sub DelProp()
    '    If (tvCode.SelectedItem Is Nothing) Then Exit Sub
    '    'vérif que ce n'est pas le dernier child
    '    If (Not tvCode.SelectedItem.Parent Is Nothing) Then
    '        If (tvCode.SelectedItem.Parent.Children = 1) Then
    '            tvCode.Nodes.Remove tvCode.SelectedItem.Parent.Index
    '            VoirCode
    '            Exit Sub
    '        End If
    '    End If
    '    tvCode.Nodes.Remove tvCode.SelectedItem.Index
    '    VoirCode
    Dim nodSelection As Node
    Set nodSelection = tvCode.SelectedItem
    If (Not nodSelection Is Nothing) Then
        Select Case conVrai
            Case nodSelection.Parent Is Nothing, nodSelection.Parent.Children <> 1
                tvCode.Nodes.Remove nodSelection.Index
            Case Else
                tvCode.Nodes.Remove nodSelection.Parent.Index
        End Select
        VoirCode
    End If
    Set nodSelection = Nothing
End Sub

'Modifié par René Rhéaume le 2 mars 2002
'Le générateur n'ajoutait plus la portée pour le
'2e élément d'une propriété en lecture/écriture
Private Sub VoirCode()
    Const conEspace As String = " "
    Const conAs As String = " As "
    Const conEgal As String = " = "
    Const conSetEsp As String = conSet & conEspace
    Dim sDeclaration As String, sCode As String
    Dim mN As Node, mNFils As Node
    Dim strTagmN As String
    Dim strNom As String
    Dim strType As String
    Dim strTexteFils As String
    Dim strPorteeProp As String
    
    txtCodeDeclarationView = vbNullString
    txtCodeView = vbNullString

    If tvCode.Nodes.Count = 0 Then Exit Sub

    Set mN = tvCode.Nodes(1)
    Do Until mN Is Nothing
        strTagmN = mN.Tag
        strNom = ExtractName(mN.Text)
        strType = ExtractType(mN.Text)
        'dans la zone déclaration
        sDeclaration = sDeclaration & "Private " & strTagmN & strNom & _
                conAs & strType & vbCrLf
        'dans la zone code
        'détermination de la portée
        Select Case mN.ForeColor
            Case Mem_Public                                'public
                strPorteeProp = "Public Property "
            Case Mem_Privee                                'private
                strPorteeProp = "Private Property "
            Case Mem_Friend                                'friend
                strPorteeProp = "Friend Property "
        End Select
        Set mNFils = mN.Child
        Do Until mNFils Is Nothing
            ' Partie de l'en-tête
            strTexteFils = mNFils.Text
            sCode = sCode & strPorteeProp & strTexteFils & conEspace & strNom
            Select Case strTexteFils
                Case conGet
                    sCode = sCode & "()" & conAs & strType & vbCrLf
                    If (mN.Image = conObjet) Then
                        sCode = sCode & conSetEsp
                    End If
                    sCode = sCode & strNom & conEgal & strTagmN & strNom & vbCrLf
                Case conSet, conLet
                    sCode = sCode & "(ByVal " & strTagmN & strNom & "A As " & strType & ")" & vbCrLf
                    If (strTexteFils = conSet) Then
                        sCode = sCode & conSetEsp
                    End If
                    sCode = sCode & strTagmN & strNom & conEgal & strTagmN & strNom & "A" & vbCrLf
            End Select
            sCode = sCode & ("End Property" & (vbCrLf & vbCrLf))
            Set mNFils = mNFils.Next
        Loop

        Set mN = mN.Next
    Loop

    sDeclaration = "'//************Généré par c2iExplorer*******************" & vbCrLf & sDeclaration

    txtCodeDeclarationView = sDeclaration
    txtCodeView = sCode
    Set mNFils = Nothing
    Set mN = Nothing

    On Error Resume Next
    txtName = vbNullString
    txtName.SetFocus

End Sub

