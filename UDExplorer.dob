Private Sub tbGene_ButtonClick(ByVal Button As MSComctlLib.Button)
    Dim objPrj As VBIDE.VBProject
    Dim objCmp As VBIDE.VBComponent
    Dim objMember As Member
    Dim nodSelection As Node

    Select Case Button.Key
            'actualisation
        Case conActu
            Init conVrai

            'voir le designer
        Case conVoir
            Set nodSelection = tv.SelectedItem
            'Modification par René Rhéaume le 27 juillet 2001
            'Permet d'afficher le code d'un module standard au lieu du
            '«visualiseur de classes». Si c'est une autre sorte de
            'module, par exemple, un module de classe, il affichera
            'le visualiseur de classes. Si c'est une méthode, fait
            'la même chose qu'un double-clic.
            If (Not nodSelection Is Nothing) Then
                Select Case nodSelection.Tag
                    Case conTagComponent
                        Analyse_Component nodSelection, objPrj, objCmp
                        On Error Resume Next
                        If (Not objCmp.DesignerWindow Is Nothing) Then
                            objCmp.DesignerWindow.Visible = conVrai
                        Else
                            Select Case nodSelection.Parent.Text
                                Case conTexteModule
                                    If (Not objCmp.CodeModule Is Nothing) Then
                                        objCmp.CodeModule.CodePane.Show
                                    End If
                                Case Else
                                    objWindowClassViewer.Visible = conVrai
                                    objUDClassViewer.Init objCmp
                            End Select
                        End If
                    Case conTagMethode
                        Analyse_Methode nodSelection, objPrj, objCmp, objMember
                        ViewNode nodSelection
                    Case Else
                        ViewNode nodSelection
                End Select
            End If
            'Fin de modification
            Set objMember = Nothing
            Set objCmp = Nothing
            Set objPrj = Nothing
            Set nodSelection = Nothing

            'ajout de propriétés
        Case conProp
            Select Case sSelectedTBButton
                Case conBtnSelMsgBox
                    objWindowMsgBox.Visible = conVrai
                Case conBtnSelProp
                    objWindowAddCode.Visible = conVrai
                Case conBtnSelBiblio
                    objWindowBiblio.Visible = conVrai
                Case conBtnSelInfo
                    objWindowCompteur.Visible = conVrai
                Case conBtnSelInternet
                    ConnectionInternet "http://www.c2i.fr"
                Case conBtnSelCapture
                    Impression
            End Select
            'compilation
        Case conCompile
            'On s'assure qu'il y a un projet ouvert
            If (VBInstance.VBProjects.Count > 0) Then
                On Error Resume Next
                #If VersionVB = 5 Then
                    VBInstance.CommandBars(1).Controls(1).Controls(11).Execute
                #ElseIf VersionVB = 6 Then
                    VBInstance.CommandBars(1).Controls(1).Controls(13).Execute
                #End If
            End If

            'suppression
        Case conDelete
            Suppression SelectedNode
    End Select
End Sub

Public Function Impression()
    Dim objPrj As VBProject, objCmp As VBComponent, objMember As Member
    Dim nodSelection As Node, strDebTag As String
    Set nodSelection = tv.SelectedItem
    If (Not nodSelection Is Nothing) Then
        Load frmPrint
        strDebTag = Left$(nodSelection.Tag, 3)
        Select Case strDebTag
            Case conAbrTagCom, conAbrTagMet
                If (strDebTag = conAbrTagCom) Then
                    Analyse_Component nodSelection, objPrj, objCmp
                Else
                    Analyse_Methode nodSelection, objPrj, objCmp, objMember    'par référence
                End If
                If (Not objCmp Is Nothing) Then
                    frmPrint.ObjetSelectionnés Nothing, objCmp
                    frmPrint.Show vbModal
                End If
            Case conAbrTagPro
                Set objPrj = VBInstance.VBProjects(nodSelection.Key)
                If (Not objPrj Is Nothing) Then
                    frmPrint.ObjetSelectionnés objPrj, Nothing
                    frmPrint.Show vbModal
                End If
        End Select
    End If
    Set objMember = Nothing
    Set objCmp = Nothing
    Set objPrj = Nothing
    Set nodSelection = Nothing
End Function

