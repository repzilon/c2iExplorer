Option Explicit

'***********************************************
'CLE D'UN COMPONENT
' Nom du projet + \ + Nom du component
'TAG : Component
'***********************************************

'***********************************************
'CLE D'UNE REFERENCE
' Nom du projet + \ + Nom du component + \ + Nom du composant
'TAG : ref
'***********************************************

'***********************************************
'CLE D'UN MEMBRE
' Nom du projet + \ + Nom du component + \ + Nom du membre
'TAG Methode
'**************
'CLE D'UNE PROPRIETE
' Nom du projet + \ + Nom du component + \ + Nom du membre+Get Set ou Let
'TAG Met + Num Ligne
'***********************************************

'***********************************************
'CLE D'UN OCX
' Nom du projet + \ + Nom du component + \ + Nom du composant
'TAG : ocx
'***********************************************

'***********************************************
'CLE D'UN PROJET
' Nom du projet
'TAG : Projet
'***********************************************

'***********************************************
'CLE D'UN DOSSIER
' Nom du projet + .. + Feuille ou feuille Fille ou.....
'TAG : Dossier
'***********************************************

'***********************************************
'CLE D'UN DOSSIER REFERENCE
' Nom du projet + ..reference ou ..composant
'TAG : reference ou OCX
'***********************************************

Public SelectedNode As Node
Public sSelectedTBButton As String

'===========================================================================
'
'===========================================================================
Private Sub ActuMembreComponent()
    Dim objVBMember As VBIDE.Member
    Dim objVBPrj As VBIDE.VBProject, objVBCmp As VBIDE.VBComponent

    Work

    Analyse_Component tv.SelectedItem, objVBPrj, objVBCmp
    Do Until tv.SelectedItem.Children = 0
        tv.Nodes.Remove tv.SelectedItem.Child.Key
    Loop

    On Error Resume Next
    If objVBCmp.Type <> vbext_ct_ResFile Then              'on n'analyse pas les ressources files
        For Each objVBMember In objVBCmp.CodeModule.Members
            AjouteMembre tv.SelectedItem, objVBMember
        Next
    End If

    Work conFaux

    Set objVBPrj = Nothing
    Set objVBCmp = Nothing
    Set objVBMember = Nothing
End Sub

Private Sub AnalyseNode(ByVal Node As Node)
    Dim objVBPrj As VBIDE.VBProject, objCmp As VBIDE.VBComponent
    Dim objMember As Member

    'GENERE LORS D'UN SIMPLE CLICK
    On Error GoTo GestErr

    txtDescription = ""

    'on regarde sur quel type d'image on a cliqué
    Select Case Left$(Node.Tag, 3)
            'on clique sur un component
        Case "Com"
            Analyse_Component Node, objVBPrj, objCmp
            'VERIF QUE TOUT EXISTE
            'le projet a été supprimé, on ne sait pas pourquoi
            If objVBPrj Is Nothing Then
                tv.Nodes.Remove tv.SelectedItem.Parent.Parent.Key
                GoTo GestErr
            End If
            'le component a été supprimé
            If objCmp Is Nothing Then
                'vérif que ce n'est pas une ressource
                If Right$(Node.Key, 9) <> "Ressource" Then
                    tv.Nodes.Remove tv.SelectedItem.Key
                End If
                GoTo GestErr
            End If

            ActuMembreComponent

            txtDescription = objCmp.Description            'mise à jour de la description

            'on clique sur une méthode
        Case "Met"

            Analyse_Methode Node, objVBPrj, objCmp, objMember    'par référence

            'VERIF QUE TOUT EXISTE
            'le projet a été supprimé, on ne sait pas pourquoi
            If objVBPrj Is Nothing Then
                tv.Nodes.Remove tv.SelectedItem.Parent.Parent.Parent.Key
                GoTo GestErr
            End If
            'le component a été supprimé
            If objCmp Is Nothing Then
                tv.Nodes.Remove tv.SelectedItem.Parent.Key
                GoTo GestErr
            End If
            'le member a été supprimé
            If objMember Is Nothing Then
                tv.Nodes.Remove tv.SelectedItem.Key
                GoTo GestErr
            End If

            txtDescription = objMember.Description
    End Select

GestErr:
    Set objMember = Nothing
    Set objCmp = Nothing
    If Not objVBPrj Is Nothing Then
        Set VBPrjSelected = objVBPrj
    End If
    Set objVBPrj = Nothing

End Sub

Private Sub Suppression(ByVal mNode As Node)
    Dim sc2iMsgBox As VbMsgBoxResult
    Dim objVBPrj As VBIDE.VBProject, objCmp As VBIDE.VBComponent
    Dim objMember As Member

    On Error GoTo GestErr
    Select Case Left$(mNode.Tag, 3)
        Case "Pro"
            sc2iMsgBox = MsgBox("Etes-vous sur de vouloir supprimer " + mNode.Text + " ?", vbYesNo + vbDefaultButton2, "c2iExplorer")
            If sc2iMsgBox = vbYes Then
                VBInstance.VBProjects.Remove VBInstance.VBProjects(mNode.Key)
            End If
            Exit Sub
        Case "Com"
            sc2iMsgBox = MsgBox("Etes-vous sur de vouloir supprimer " + mNode.Text + " ?", vbYesNo + vbDefaultButton2, "c2iExplorer")
            If sc2iMsgBox = vbYes Then
                Analyse_Component mNode, objVBPrj, objCmp
                objVBPrj.VBComponents.Remove objCmp
                tv.Nodes.Remove mNode
            End If
            Exit Sub
        Case "Met"
            Analyse_Methode mNode, objVBPrj, objCmp, objMember    'par référence
            'suppression d'un membre
            Dim objCodeModule As VBIDE.CodeModule
            Dim lngStartLine As Long, lngNumCount As Long, lngType As Long

            On Error Resume Next
            Select Case mNode.Image
                Case "Get"
                    lngType = vbext_pk_Get
                Case "Set"
                    lngType = vbext_pk_Set
                Case "Let"
                    lngType = vbext_pk_Let
                Case "methode"
                    lngType = vbext_pk_Proc
            End Select
            Set objCodeModule = objMember.Collection.Parent
            lngStartLine = objCodeModule.ProcStartLine(objMember.Name, lngType)
            lngNumCount = objCodeModule.ProcCountLines(objMember.Name, lngType)
            If lngNumCount = 0 Then
                MsgBox "Suppression impossible", vbExclamation, "c2iExplorer"
            Else
                Clipboard.Clear
                Clipboard.SetText objCodeModule.Lines(lngStartLine, lngNumCount)
                objCodeModule.DeleteLines lngStartLine, lngNumCount
            End If
            Set objCodeModule = Nothing
            If mNode.Image = "Get" Or mNode.Image = "Set" Or mNode.Image = "Let" Then
                tv_NodeClick mNode.Parent.Parent
            Else
                tv_NodeClick mNode
            End If
    End Select
    Exit Sub
GestErr:
End Sub


Private Sub ViewNode(ByVal Node As Node)
    Dim objVBPrj As VBIDE.VBProject, objCmp As VBIDE.VBComponent
    Dim objMember As Member

    On Error GoTo GestErr


    'on regarde sur quel type d'image on a cliqué
    Select Case Left$(Node.Tag, 3)
            'on clique sur un component
        Case "Com"
            If Node.Tag <> "Component" Then
                Analyse_Component Node, objVBPrj, objCmp

                If Not objVBPrj Is VBInstance.ActiveVBProject Then
                    Set VBInstance.ActiveVBProject = objVBPrj    'on le met actif
                End If
                'connection pour l'ajout de références
                Set Connection.refEvent = VBInstance.Events.ReferencesEvents(objVBPrj)
                If Not objCmp.CodeModule.CodePane Is VBInstance.ActiveCodePane Then
                    Set VBInstance.ActiveCodePane = objCmp.CodeModule.CodePane    'on met le component actif
                End If
            End If

            'on clique sur une méthode
        Case "Met"

            Analyse_Methode Node, objVBPrj, objCmp, objMember    'par référence
            'VERIF QUE TOUT EXISTE

            If Not objVBPrj Is VBInstance.ActiveVBProject Then
                Set VBInstance.ActiveVBProject = objVBPrj  'on le met actif
            End If
            Set Connection.refEvent = VBInstance.Events.ReferencesEvents(objVBPrj)
            If Not objCmp.CodeModule.CodePane Is VBInstance.ActiveCodePane Then
                Set VBInstance.ActiveCodePane = objCmp.CodeModule.CodePane    'on met le codepane actif
            End If
            'objCmp.CodeModule.CodePane.TopLine = objMember.Collection.Parent.ProcBodyLine(objMember.Name, vbext_pk_Proc)
            On Error Resume Next
            Dim iRecherche As Long

            Select Case Node.Image
                Case "propriete"
                    If Node.Children <> 0 Then
                        objCmp.CodeModule.CodePane.TopLine = CLng(Right$(Node.Child.Tag, Len(Node.Child.Tag) - 3))
                        objCmp.CodeModule.CodePane.SetSelection CLng(Right$(Node.Child.Tag, Len(Node.Child.Tag) - 3)), 1, CLng(Right$(Node.Child.Tag, Len(Node.Child.Tag) - 3)) + 1, 1
                    End If
                    'on ne fait rien
                Case "Get", "Let", "Set"
                    objCmp.CodeModule.CodePane.TopLine = CLng(Right$(Node.Tag, Len(Node.Tag) - 3))
                    objCmp.CodeModule.CodePane.SetSelection CLng(Right$(Node.Tag, Len(Node.Tag) - 3)), 1, CLng(Right$(Node.Tag, Len(Node.Tag) - 3)) + 1, 1
                Case Else
                    iRecherche = vbext_pk_Proc
                    objCmp.CodeModule.CodePane.TopLine = objMember.Collection.Parent.ProcBodyLine(objMember.Name, iRecherche)
                    If Err.Number <> 0 Then
                        objCmp.CodeModule.CodePane.SetSelection 1, 1, 2, 1
                        Err.Clear
                    Else
                        objCmp.CodeModule.CodePane.SetSelection objMember.Collection.Parent.ProcBodyLine(objMember.Name, iRecherche), 1, objMember.Collection.Parent.ProcBodyLine(objMember.Name, iRecherche) + 1, 1
                    End If
            End Select

            txtDescription = objMember.Description
    End Select

GestErr:
    Set objMember = Nothing
    Set objCmp = Nothing
    Set objVBPrj = Nothing
End Sub

