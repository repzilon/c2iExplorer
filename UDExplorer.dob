    End If
End Sub

Private Sub tbGene_ButtonClick(ByVal Button As MSComctlLib.Button)
'    Dim nodSelection As Node

    Select Case Button.Key
        Case conActu 'actualisation
            Init conVrai
            
        Case conVoir 'voir le designer
'            Set nodSelection = tv.SelectedItem
            'Modification par René Rhéaume le 27 juillet 2001
            ' Permet d'afficher le code d'un module standard au lieu du
            ' «visualiseur de classes». Si c'est une autre sorte de
            ' module, par exemple, un module de classe, il affichera
            ' le visualiseur de classes. Si c'est une méthode, fait
            ' la même chose qu'un double-clic.
            'Modification par René Rhéaume le 14 juillet 2002
            ' ViewNode gère maintenant l'ouverture du concepteur.
            ' Comme le «visualiseur de classes» s'affiche sur un
            ' Ctrl+Clic de n'importe quel composant, le clic normal
            ' ouvrira maintenant la fenêtre de code pour les modules
            ' de classe.
'            If (Not nodSelection Is Nothing) Then
'                Select Case nodSelection.Tag
'                    Case conTagComponent
''                        Analyse_Component nodSelection, objPrj, objCmp
'                        ViewNode nodSelection
'                    Case conTagMethode
''                        Analyse_Methode nodSelection, objPrj, objCmp, objMember
'                        ViewNode nodSelection
'                    Case Else
'                        ViewNode nodSelection
'                End Select
'            End If
            If (Not SelectedNode Is Nothing) Then
                ViewNode SelectedNode
            End If
            'Fin de modification
'            Set nodSelection = Nothing

        Case conProp 'ajout de propriétés
            Select Case sSelectedTBButton
                Case conarClefBtnMenu(2)
                    objWindowMsgBox.Visible = conVrai
                Case conarClefBtnMenu(1)
                    objWindowAddCode.Visible = conVrai
                Case conarClefBtnMenu(3)
                    objWindowBiblio.Visible = conVrai
                Case conarClefBtnMenu(0)
                    objWindowCompteur.Visible = conVrai
                Case conarClefBtnMenu(4)
                    ConnectionInternet "http://www.sourceforge.net/projects/c2iexplorer"
                Case conarClefBtnMenu(5)
                    Impression
                Case conarClefBtnMenu(6)
                    frmOptions.Show 'vbModal
            End Select

        Case conCompile 'compilation
            On Error GoTo Fin
            VBInstance.ActiveVBProject.MakeCompiledFile

        Case conDelete 'suppression
            Suppression SelectedNode
    End Select
    
Fin:
'
End Sub

'Modifié par René Rhéaume le 19 décembre 2002
' Correction d'un plantage lorsqu'un composant est
' sélectionné dans l'explorateur
Public Sub Impression()
    Dim objPrj As VBProject, objCmp As VBComponent, objMember As Member
'    Dim nodSelection As Node
    Dim strDebTag As String
'    Set nodSelection = tv.SelectedItem

    If (Not SelectedNode Is Nothing) Then
        Load frmPrint
        strDebTag = Left$(SelectedNode.Tag, 3)
        Select Case strDebTag
            Case conAbrTagCom, conAbrTagMet
                If (IsSameString(strDebTag, conAbrTagCom)) Then
                    Analyse_Component SelectedNode, objPrj, objCmp
                Else
                    Analyse_Methode SelectedNode, objPrj, objCmp, objMember    'par référence
                End If
                If (Not objCmp Is Nothing) Then
                    frmPrint.ObjetSelectionnés Nothing, objCmp
                    frmPrint.Show vbModal
                End If
            Case conAbrTagPro
                Set objPrj = VBInstance.VBProjects(SelectedNode.Key)
                If (Not objPrj Is Nothing) Then
                    frmPrint.ObjetSelectionnés objPrj, Nothing
                    frmPrint.Show vbModal
                End If
        End Select
    End If
    
SortieProc:
    Set objMember = Nothing
    Set objCmp = Nothing
    Set objPrj = Nothing
'    Set nodSelection = Nothing
End Sub

