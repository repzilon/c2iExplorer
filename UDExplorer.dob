'Procédure modifiée par René Rhéaume le 16 juillet 2002
' Enlève vraiment le texte de description d'un membre
' si la zone de texte ne contient rien
'Procédure modifiée par René Rhéaume le 12 janvier 2002
Private Sub tbDescription_ButtonClick(ByVal Button As MSComctlLib.Button)
    Dim objVBPrj As VBIDE.VBProject, objCmp As VBIDE.VBComponent
    Dim objMember As Member
    Dim strDescription As String

    On Error GoTo Fin
'    If (Button.Key = conOK) Then
        If (Not SelectedNode Is Nothing) Then
            strDescription = txtDescription.Text
            Select Case Left$(SelectedNode.Tag, 3)
                Case conAbrTagCom 'on clique sur un component
                    Analyse_Component SelectedNode, objVBPrj, objCmp
                    If (Not objCmp Is Nothing) Then
                        objCmp.Description = strDescription
                    End If
                Case conAbrTagMet
                    Analyse_Methode SelectedNode, objVBPrj, objCmp, objMember    'par référence
                    If (Not objMember Is Nothing) Then
                        If (LenB(strDescription) > 0) Then
                            objMember.Description = strDescription
                        Else
                            objMember.Description = vbNullChar
                        End If
                    End If
            End Select
        End If
'    End If

SortieProc:
    Exit Sub
Fin:
    GererErrInattendue , "UDExplorer.tbDescription_ButtonClick"
    Resume SortieProc
End Sub

