' Ajout par René Rhéaume le 28 juillet 2001
'   Affiche le «visualiseur de classes» sur un Ctrl+Double-clic
'   (supposé être Ctrl+Clic) d'un formulaire, module, etc.
' Ajout le 1er février 2002
'   Contribution par Joël Guelluy implémentée par René Rhéaume
'   Ajout des menus contextuels.
' Modification par René Rhéaume le 23 février 2002
'   Le «visualiseur de classes» s'affiche sur un Ctrl+Clic,
'   comme il devait l'être à l'origine.
' Modification par René Rhéaume le 1er août 2002
'   Correction du bogue «la liste des méthodes, variables, constantes, etc.
'   se rétractait après avoir cliqué sur le + pour la dérouler».
' Modification par René Rhéaume le 3 janvier 2003
'  Correction de l'erreur 91 avec les fichiers de ressources
'  et les documents associés
' Optimisation par René Rhéaume le 12 janvier 2003
Private Sub tv_MouseUp(Button As Integer, Shift As Integer, X As Single, Y As Single)
#If (JGuelluyRightMenu = 1) Then
    #If (VersionVB = 6) Then
        Const conIdxMnuProj As Long = 30
        Const conIdxMnuForm As Long = 31
        Const conIdxMnuModule As Long = 32
    #ElseIf (VersionVB = 5) Then
        Const conIdxMnuProj As Long = 24
        Const conIdxMnuForm As Long = 25
        Const conIdxMnuModule As Long = 26
    #End If
#End If

    Dim objPrj As VBIDE.VBProject, objCmp As VBIDE.VBComponent
    Dim strTag As String
    Dim strImage As String
    Dim nodActif As Node
    
#If (JGuelluyRightMenu = 1) Then
    Dim strComponentName As String
    Dim lngTypeComponent As VBIDE.vbext_ComponentType
'    Dim strClefNoeud As String
#End If

    On Error Resume Next
    Set nodActif = tv.HitTest(X, Y)
    
    If (Not nodActif Is Nothing) Then
        On Error GoTo Fin
        AnalyseNode nodActif
        strTag = nodActif.Tag
        Select Case Button
            Case vbLeftButton
                strImage = nodActif.Image
                Select Case conFaux
                    Case Shift = vbCtrlMask, strTag = conTagComponent, _
                        Not IsSameString(strImage, conarClefTypeModule(5)), _
                        Not IsSameString(strImage, conarClefTypeModule(6))
                    Case Else
                        Analyse_Component nodActif, objPrj, objCmp
                        On Error Resume Next
                        objWindowClassViewer.Visible = conVrai
                        objUDClassViewer.Init objCmp
                End Select
#If (JGuelluyRightMenu = 1) Then
            Case vbRightButton
'                On Error GoTo Fin
                Select Case strTag
                    Case conTagComponent
'                        strClefNoeud = nodActif.Key
'                        strComponentName = Mid$(strClefNoeud, InStr(1, strClefNoeud, conBS, _
'                                            vbBinaryCompare) + 1)
                        strComponentName = nodActif.Text
                        Set objCmp = VBInstance.ActiveVBProject.VBComponents(strComponentName)
                        lngTypeComponent = objCmp.Type
                        Select Case lngTypeComponent
                            Case vbext_ct_VBForm, vbext_ct_UserControl, vbext_ct_DocObject, _
                                vbext_ct_VBMDIForm
                                AfficherMenuComposant objCmp, conIdxMnuForm
                            Case vbext_ct_StdModule, vbext_ct_ClassModule
                                AfficherMenuComposant objCmp, conIdxMnuModule
                        End Select
                    'Case conTagMethode
                    Case conTagProjet
                        VBInstance.CommandBars(conIdxMnuProj).ShowPopup
                End Select
#End If
        End Select
    End If

Fin:
    Select Case Err.Number
        Case 0, 9
        Case Else
            GererErrInattendue , "UDExplorer.tv_MouseUp"
    End Select
    Set objCmp = Nothing
    Set objPrj = Nothing
    Set nodActif = Nothing
End Sub

#If (JGuelluyRightMenu = 1) Then
'Procédure ajoutée par René Rhéaume le 16 juillet 2002
' Affiche le menu contextuel de VB du composant
' Problème : je ne suis pas capable de fermer le composant
'Procédure modifiée par René Rhéaume le 5 août 2002
' J'ai finalement trouvé le moyen de fermer la fenêtre de code.
' Il peut y avoir des petits accrocs parfois.
'Note par René Rhéaume le 17 décembre 2002
' Le bogue est réapparu et je n'ai pas trouvé un moyen pour
' l'éradiquer. Si je clique sur la fenêtre de code ouverte
' spécialement pour afficher le bon menu afin de masquer
' celui-ci, celle-ci ne se fermera pas car elle est devenue
' la fenêtre active. Aussi, masquer la fenêtre de code avant
' d'afficher la fenêtre alors qu'une fenêtre est dans
' l'espace de travail ne fonctionne pas car le «focus» est sur
' une autre fenêtre.
'Procédure modifiée par René Rhéaume le 12 janvier 2003
Private Sub AfficherMenuComposant(ByVal vbcComposant As VBIDE.VBComponent, ByVal lngIndiceMenu As Long)
    Dim strTitreFenetre As String
    Dim blnTrouve As Boolean
'    Dim I As Long, lngNbFenetres As Long
    Dim wndFenetre As VBIDE.Window

    ' Est-ce que la fenêtre de code était déjà visible ?
    strTitreFenetre = vbcComposant.Name & " (Code)"
'    I = 1
'    With VBInstance.Windows
'        lngNbFenetres = .Count
'
'        Do Until ((blnTrouve) Or (I > lngNbFenetres))
'            If (InStr(.Item(I).Caption, strTitreFenetre) > 0) Then
'                blnTrouve = conVrai
'            Else
'                I = I + 1
'            End If
'        Loop
'    End With
    
    For Each wndFenetre In VBInstance.Windows
        If (InStr(wndFenetre.Caption, strTitreFenetre) > 0) Then
            blnTrouve = conVrai
            Exit For
        End If
    Next

    With vbcComposant.CodeModule.CodePane
        .Show
        VBInstance.CommandBars(lngIndiceMenu).ShowPopup
        If (Not blnTrouve) Then
            .Window.Close
        End If
    End With
    
    Set wndFenetre = Nothing
End Sub
#End If

