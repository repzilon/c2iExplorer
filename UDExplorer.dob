Option Explicit

'***********************************************
'CLE D'UN COMPONENT
' Nom du projet + \ + Nom du component
'TAG : Component
'***********************************************

'***********************************************
'CLE D'UNE REFERENCE
' Nom du projet + \ + Nom du component + \ + Nom du composant
'TAG : ref
'***********************************************

'***********************************************
'CLE D'UN MEMBRE
' Nom du projet + \ + Nom du component + \ + Nom du membre
'TAG Methode
'**************
'CLE D'UNE PROPRIETE
' Nom du projet + \ + Nom du component + \ + Nom du membre+Get Set ou Let
'TAG Met + Num Ligne
'***********************************************

'***********************************************
'CLE D'UN OCX
' Nom du projet + \ + Nom du component + \ + Nom du composant
'TAG : ocx
'***********************************************

'***********************************************
'CLE D'UN PROJET
' Nom du projet
'TAG : Projet
'***********************************************

'***********************************************
'CLE D'UN DOSSIER
' Nom du projet + .. + Feuille ou feuille Fille ou.....
'TAG : Dossier
'***********************************************

'***********************************************
'CLE D'UN DOSSIER REFERENCE
' Nom du projet + ..reference ou ..composant
'TAG : reference ou OCX
'***********************************************
Private Const conAbrTagCom As String = "Com"
Private Const conAbrTagMet As String = "Met"
Private Const conAbrTagPro As String = "Pro"
Private Const conClefRessource As String = "Ressource"
Private Const conImgComposant As String = "composant"
Private Const conTagComponent As String = "Component"
Private Const conTagMethode As String = "Methode"
Private Const conTagProjet As String = "Projet"
Private Const conTagOcx As String = "ocx"
Private Const conActu As String = "actu"
Private Const conVoir As String = "voir"
Private Const conProp As String = "prop"
Private Const conCompile As String = "compile"
Private Const conDelete As String = "delete"
Private Const conOK As String = "ok"
Private Const conClefDossReference As String = "..reference"
Private Const conClefDossComposant As String = "..composant"
Private Const conErrVarObjIndefinie As Long = 91
Private Const conNomUD As String = "UDExplorer"

Private conarClefBtnMenu() As String

Private blnAffDesc As Boolean
Private blnAffFiltres As Boolean
Public SelectedNode As Node
Public sSelectedTBButton As String

Private Sub ActuMembreComponent()
    Dim objVBMember As VBIDE.Member
    Dim objVBPrj As VBIDE.VBProject, objVBCmp As VBIDE.VBComponent
    Dim nodSelection As Node

    Work

    Set nodSelection = tv.SelectedItem
    Analyse_Component nodSelection, objVBPrj, objVBCmp
    Do Until nodSelection.Children = 0
        tv.Nodes.Remove nodSelection.Child.Key
    Loop

    On Error GoTo GestErr
    If (objVBCmp.Type <> vbext_ct_ResFile) Then
        For Each objVBMember In objVBCmp.CodeModule.Members
            AjouteMembre nodSelection, objVBMember
        Next
    End If

    Work conFaux

SortieProc:
    Set objVBPrj = Nothing
    Set objVBCmp = Nothing
    Set objVBMember = Nothing
    Set nodSelection = Nothing
    Exit Sub
GestErr:
    Select Case Err.Number
        Case conErrVarObjIndefinie, 92
            Resume Next
        Case Else
            GererErrInattendue , "UDExplorer.ActuMembreComponent"
            Resume SortieProc
    End Select
End Sub

Private Sub AnalyseNode(ByVal Node As Node)
    Dim objVBPrj As VBIDE.VBProject, objCmp As VBIDE.VBComponent
    Dim objMember As Member

    'GENERE LORS D'UN SIMPLE CLICK
    On Error GoTo GestErr

    txtDescription = vbNullString

    'on regarde sur quel type d'image on a cliqué
    Select Case Left$(Node.Tag, 3)
            'on clique sur un component
        Case conAbrTagCom
            Analyse_Component Node, objVBPrj, objCmp
            'VERIF QUE TOUT EXISTE
            'le projet a été supprimé, on ne sait pas pourquoi
            If (objVBPrj Is Nothing) Then
                ' Note par René Rhéaume, le 8 janvier 2002
                ' Ce ne serait pas plutôt Node au lieu de tv.SelectedItem
                tv.Nodes.Remove tv.SelectedItem.Parent.Parent.Key
                GoTo GestErr
            End If
            'le component a été supprimé
            If (objCmp Is Nothing) Then
                'vérif que ce n'est pas une ressource
                If (Right$(Node.Key, 9) <> conClefRessource) Then
                    tv.Nodes.Remove tv.SelectedItem.Key
                End If
                GoTo GestErr
            End If

            ActuMembreComponent

            txtDescription = objCmp.Description            'mise à jour de la description

            'on clique sur une méthode
        Case conAbrTagMet

            Analyse_Methode Node, objVBPrj, objCmp, objMember    'par référence

            'VERIF QUE TOUT EXISTE
            'le projet a été supprimé, on ne sait pas pourquoi
            If (objVBPrj Is Nothing) Then
                tv.Nodes.Remove tv.SelectedItem.Parent.Parent.Parent.Key
                GoTo GestErr
            End If
            'le component a été supprimé
            If (objCmp Is Nothing) Then
                tv.Nodes.Remove tv.SelectedItem.Parent.Key
                GoTo GestErr
            End If
            'le member a été supprimé
            If (objMember Is Nothing) Then
                tv.Nodes.Remove tv.SelectedItem.Key
                GoTo GestErr
            End If

            txtDescription = objMember.Description
    End Select

GestErr:
    Select Case Err.Number
        Case ccElemNotFound, ccNonUniqueKey, conErrVarObjIndefinie
            Err.Clear
        Case Is <> 0
            GererErrInattendue , "UDExplorer.AnalyseNode"
    End Select
    Set objMember = Nothing
    Set objCmp = Nothing
    If (Not objVBPrj Is Nothing) Then
        Set VBPrjSelected = objVBPrj
    End If
    Set objVBPrj = Nothing
End Sub

'Procédure modifiée par René Rhéaume le 21 juin 2002
' Support multilingue
Private Sub Suppression(ByVal mNode As Node)
    Const conClefL10nSuppr As String = "Code.Suppression."
    Static mlgMsgConfirm As String
    Static mlgMsgSupprImpossible As String
    Static blnLangOK As Boolean
    If (Not blnLangOK) Then
        mlgMsgConfirm = LireChaineLocalisee(conNomUD, _
            conClefL10nSuppr & "mlgMsgConfirm", "Êtes-vous sur de vouloir supprimer ")
        mlgMsgSupprImpossible = LireChaineLocalisee(conNomUD, _
            conClefL10nSuppr & "mlgMsgSupprImpossible", "Suppression impossible")
        blnLangOK = conVrai
    End If

    Const conBoutons As Long = vbYesNo + vbDefaultButton2 + vbQuestion
    Dim sc2iMsgBox As VbMsgBoxResult
    Dim objVBPrj As VBIDE.VBProject, objCmp As VBIDE.VBComponent
    Dim objMember As Member
    Dim strConfirmation As String, strDebTag As String

    On Error GoTo GestErr
    strDebTag = Left$(mNode.Tag, 3)
    Select Case (strDebTag)
        Case conAbrTagPro, conAbrTagCom
            strConfirmation = mlgMsgConfirm & " " & mNode.Text & " ?"
    End Select
    Select Case (strDebTag)
        Case conAbrTagPro
            sc2iMsgBox = MsgBox(strConfirmation, conBoutons)
            If (sc2iMsgBox = vbYes) Then
                VBInstance.VBProjects.Remove VBInstance.VBProjects(mNode.Key)
            End If
        Case conAbrTagCom
            sc2iMsgBox = MsgBox(strConfirmation, conBoutons)
            If (sc2iMsgBox = vbYes) Then
                Analyse_Component mNode, objVBPrj, objCmp
                objVBPrj.VBComponents.Remove objCmp
                tv.Nodes.Remove mNode
            End If
        Case conAbrTagMet
            Analyse_Methode mNode, objVBPrj, objCmp, objMember    'par référence
            'suppression d'un membre
            Dim objCodeModule As VBIDE.CodeModule
            Dim lngStartLine As Long, lngNumCount As Long, lngType As Long

            On Error Resume Next
            Select Case mNode.Image
                Case conGet
                    lngType = vbext_pk_Get
                Case conSet
                    lngType = vbext_pk_Set
                Case conLet
                    lngType = vbext_pk_Let
                Case conarClefTypeMembre(2)
                    lngType = vbext_pk_Proc
            End Select
            Set objCodeModule = objMember.Collection.Parent
            lngStartLine = objCodeModule.ProcStartLine(objMember.Name, lngType)
            lngNumCount = objCodeModule.ProcCountLines(objMember.Name, lngType)
            If (lngNumCount = 0) Then
                MsgBox mlgMsgSupprImpossible, vbExclamation
            Else
                Clipboard.Clear
                Clipboard.SetText objCodeModule.Lines(lngStartLine, lngNumCount)
                objCodeModule.DeleteLines lngStartLine, lngNumCount
            End If
            Set objCodeModule = Nothing
            Select Case mNode.Image
                Case conGet, conSet, conLet
                    tv_NodeClick mNode.Parent.Parent
                Case Else
                    tv_NodeClick mNode
            End Select
    End Select

GestErr:
    Set objVBPrj = Nothing
    Set objCmp = Nothing
    Set objMember = Nothing
End Sub

Private Sub ViewNode(ByVal Node As Node)
    Dim objVBPrj As VBIDE.VBProject, objCmp As VBIDE.VBComponent
    Dim objMember As Member
    Dim lngPos As Long

    On Error GoTo GestErr

    'on regarde sur quel type d'image on a cliqué
    Select Case Left$(Node.Tag, 3)
            'on clique sur un component
        Case conAbrTagCom
            If (Node.Tag <> conTagComponent) Then
                Analyse_Component Node, objVBPrj, objCmp

                If (Not objVBPrj Is VBInstance.ActiveVBProject) Then
                    Set VBInstance.ActiveVBProject = objVBPrj    'on le met actif
                End If
                'connection pour l'ajout de références
                Set Connection.refEvent = VBInstance.Events.ReferencesEvents(objVBPrj)
                If (Not objCmp.CodeModule.CodePane Is VBInstance.ActiveCodePane) Then
                    Set VBInstance.ActiveCodePane = objCmp.CodeModule.CodePane    'on met le component actif
                End If
            End If

            'on clique sur une méthode
        Case conAbrTagMet

            Analyse_Methode Node, objVBPrj, objCmp, objMember    'par référence
            'VERIF QUE TOUT EXISTE

            If (Not objVBPrj Is VBInstance.ActiveVBProject) Then
                Set VBInstance.ActiveVBProject = objVBPrj  'on le met actif
            End If
            Set Connection.refEvent = VBInstance.Events.ReferencesEvents(objVBPrj)
            If (Not objCmp.CodeModule.CodePane Is VBInstance.ActiveCodePane) Then
                Set VBInstance.ActiveCodePane = objCmp.CodeModule.CodePane    'on met le codepane actif
            End If
            'objCmp.CodeModule.CodePane.TopLine = objMember.Collection.Parent.ProcBodyLine(objMember.Name, vbext_pk_Proc)
            On Error Resume Next

            Select Case Node.Image
                Case conarClefTypeMembre(4)
                    If (Node.Children <> 0) Then
                        lngPos = CLng(Right$(Node.Child.Tag, Len(Node.Child.Tag) - 3))
                        objCmp.CodeModule.CodePane.TopLine = lngPos
                        objCmp.CodeModule.CodePane.SetSelection lngPos, 1, lngPos + 1, 1
                    End If
                    'on ne fait rien
                Case conGet, conLet, conSet
                    lngPos = CLng(Right$(Node.Tag, Len(Node.Tag) - 3))
                    objCmp.CodeModule.CodePane.TopLine = lngPos
                    objCmp.CodeModule.CodePane.SetSelection lngPos, 1, lngPos + 1, 1
                Case Else
                    lngPos = objMember.Collection.Parent.ProcBodyLine(objMember.Name, _
                                vbext_pk_Proc)
                    objCmp.CodeModule.CodePane.TopLine = lngPos
                    If (Err.Number <> 0) Then
                        objCmp.CodeModule.CodePane.SetSelection 1, 1, 2, 1
                        Err.Clear
                    Else
                        objCmp.CodeModule.CodePane.SetSelection lngPos, 1, lngPos + 1, 1
                    End If
            End Select

            txtDescription = objMember.Description
    End Select

GestErr:
    Set objMember = Nothing
    Set objCmp = Nothing
    Set objVBPrj = Nothing
End Sub

