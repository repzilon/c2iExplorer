Private Sub UserDocument_Resize()
    Dim lngHauteurTV As Long
    Dim lngLargeurBtnDesc As Long

    On Error Resume Next
    lngHauteurTV = ScaleHeight - tbGene.Height
    If (blnAffDesc) Then
        lngHauteurTV = lngHauteurTV - tbDescription.Height
    End If
    If (blnAffFiltres) Then
        lngHauteurTV = lngHauteurTV - tbFiltre.Height
    End If
        
    tv.Move 0, tbGene.Height, tbFiltre.Width, lngHauteurTV

    If (blnAffDesc) Then
        lngLargeurBtnDesc = tbDescription.Buttons(1).Width
        txtDescription.Move lngLargeurBtnDesc, 0, ScaleWidth - lngLargeurBtnDesc, _
            lngLargeurBtnDesc
    End If
End Sub

Public Sub Init(Optional ByVal bClear As Boolean = conFaux)
    Dim objVBPrj As VBIDE.VBProject

    If (bClear) Then
        With tv
            .Visible = conFaux
            .Nodes.Clear
            .Visible = conVrai
        End With
    End If

    On Error Resume Next
    For Each objVBPrj In VBInstance.VBProjects
        AjouteProjet objVBPrj
    Next

    Set objVBPrj = Nothing
End Sub

Public Sub AjouteProjet(ByVal objVBPrj As VBIDE.VBProject)
    Dim sKey As String, sImageKey As String
    Dim mNodePrj As Node
    Dim objVBCmp As VBIDE.VBComponent

    Set Connection.refEvent = VBInstance.Events.ReferencesEvents(objVBPrj)

    '***********************************************
    'CLE D'UN PROJET
    ' Nom du projet
    'TAG
    'Projet
    '***********************************************
    tv.Sorted = conFaux
    'ajout des projets
    sKey = objVBPrj.Name
    sImageKey = ExtraitIconeProjet(objVBPrj)
    Set mNodePrj = tv.Nodes.Add(, , sKey, objVBPrj.Name, sImageKey)
    mNodePrj.Tag = conTagProjet
    mNodePrj.Sorted = conVrai
    If (objVBPrj Is objVBPrj.Collection.StartProject) Then
        mNodePrj.Bold = conVrai
    End If

    'ajout des composants du projet

    tv.Enabled = conFaux
    tv.Visible = conFaux

    '    'Modification FredJust
    '    'Permet d'avoir les dossiers toujours dans le meme ordre
    '    Dim Neu As Node
    '    Set Neu = tv.Nodes.Add(tv.Nodes(objVBPrj.Name), tvwChild, objVBPrj.Name + ".." + "VBForm", "Feuilles", "dVBForm")
    '    Neu.Tag = "Dossier"
    '    Neu.Bold = conVrai
    '
    '    Set Neu = tv.Nodes.Add(tv.Nodes(objVBPrj.Name), tvwChild, objVBPrj.Name + ".." + "StdModule", "Modules", "dStdModule")
    '    Neu.Tag = "Dossier"
    '    Neu.Bold = conVrai
    '
    '
    '    Set Neu = tv.Nodes.Add(tv.Nodes(objVBPrj.Name), tvwChild, objVBPrj.Name + ".." + "ClassModule", "Modules de classe", "dClassModule")
    '    Neu.Tag = "Dossier"
    '    Neu.Bold = conVrai
    '    'Fin de modification
    For Each objVBCmp In objVBPrj.VBComponents
        AjouteComponent objVBCmp
    Next

    mNodePrj.Sorted = conFaux
    InitReferences objVBPrj
    tv.Enabled = conVrai
    tv.Visible = conVrai

    Set tv.SelectedItem = mNodePrj
    Set SelectedNode = mNodePrj
    Set mNodePrj = Nothing
    Set objVBCmp = Nothing
End Sub

Public Sub RetireProjet(ByVal objVBPrj As VBIDE.VBProject)
    On Error Resume Next
    tv.Nodes.Remove objVBPrj.Name
End Sub

'Optimisé par René Rhéaume le 18 mai 2002
'Modifié par René Rhéaume le 3 janvier 2003
' Support des documents associés
Public Sub AjouteComponent(ByVal objVBCmp As VBIDE.VBComponent)
    Dim mNodePrj As Node, mNodeCmp As Node
    Dim sKey As String
    Dim sImageKey As String
    Dim strNomProjet As String
    Dim strLibelle As String

    On Error GoTo GestErr

    '***********************************************
    'CLE D'UN COMPONENT
    ' Nom du projet + \ + Nom du component
    'TAG
    'Component
    '***********************************************
    strNomProjet = objVBCmp.Collection.Parent.Name
    Set mNodePrj = tv.Nodes(strNomProjet)
    sImageKey = ExtraitIconeComponent(objVBCmp)
    Select Case objVBCmp.Type
        Case vbext_ct_ResFile
            sKey = strNomProjet & conBS & conClefRessource
            strLibelle = objVBCmp.FileNames(1)
        Case vbext_ct_RelatedDocument
            ' Remplacer «\» par «/» pour la dernière partie de la clé
            sKey = strNomProjet & conBS & ChangerCaractere(objVBCmp.FileNames(1), _
                conCodeBackSlash, conCodeSlash)
            strLibelle = objVBCmp.FileNames(1)
        Case Else
            sKey = strNomProjet & conBS & objVBCmp.Name
            strLibelle = objVBCmp.Name
    End Select
    
    Set mNodeCmp = tv.Nodes.Add(NodeTypeFeuille(strNomProjet, sImageKey), tvwChild, sKey, _
        strLibelle, sImageKey)
    Select Case objVBCmp.Type
        Case vbext_ct_ResFile, vbext_ct_RelatedDocument
        Case Else
            mNodeCmp.EnsureVisible
    End Select
    mNodeCmp.Tag = conTagComponent
    mNodeCmp.Sorted = conVrai

GestErr:
    Set mNodePrj = Nothing
    Set mNodeCmp = Nothing
End Sub

Private Function ChangerCaractere(ByVal strChaine As String, ByVal lngCarAv As Long, lngCarAp As Long) As String
    Dim strCarAv As String, strCarAp As String
    Dim lngPos As Long
    
    If (LenB(strChaine) > 0) Then
        ChangerCaractere = strChaine
        strCarAv = Chr$(lngCarAv)
        strCarAp = Chr$(lngCarAp)
        lngPos = InStr(1, strChaine, strCarAv, vbBinaryCompare)
        Do Until (lngPos = 0)
            Mid$(ChangerCaractere, lngPos, 1) = strCarAp
            lngPos = InStr(lngPos + 1, strChaine, strCarAv, vbBinaryCompare)
        Loop
    End If
End Function

'Procédure modifiée par René Rhéaume le 21 juin 2002
' Support multilingue
'Procédure modifiée par René Rhéaume le 14 janvier 2003
' On peut maintenant supprimer des documents associés
' et des fichiers de ressources.
' Le message d'erreur s'affichera plus rarement.
Public Sub RetireComposant(objVBCmp As VBIDE.VBComponent, Optional ByVal sOldName As String)
    Static mlgMsgActualiser As String
    If (LenB(mlgMsgActualiser) = 0) Then
        mlgMsgActualiser = LireChaineLocalisee(conNomUD, _
            "Code.RetireComposant.mlgMsgActualiser", "Cliquez sur le bouton Actualiser")
    End If
    
    Dim sKeyParent As String, sName As String, strClef As String

    If (LenB(sOldName) = 0) Then
        Select Case objVBCmp.Type
            Case vbext_ct_RelatedDocument, vbext_ct_ResFile
                sName = ChangerCaractere(objVBCmp.FileNames(1), conCodeBackSlash, conCodeSlash)
            Case Else
                sName = objVBCmp.Name
        End Select
    Else
        sName = sOldName
    End If

    On Error GoTo GestErr
    strClef = objVBCmp.Collection.Parent.Name & conBS & sName
    With tv.Nodes
        sKeyParent = .Item(strClef).Parent.Key
        .Remove strClef
    
        If (.Item(sKeyParent).Children = 0) Then
            .Remove sKeyParent
        End If
    End With
    
    Exit Sub
GestErr:
    MsgBox mlgMsgActualiser, vbInformation
End Sub

Public Sub AjouteMembre(ByRef mNodeCmp As Node, ByRef objVBMember As VBIDE.Member)
    #If OldC2iStyle <> 1 Then
    Const conCmd As String = "cmd"
    #End If
    Dim sImageKey As String, lngCouleurPortee As Long, sKey As String
    Dim mNodeMember As Node
    #If OldC2iStyle <> 1 Then
    Dim Neu As Node
    #End If
    
    '***********************************************
    'CLE D'UN MEMBRE
    ' Nom du projet + \ + Nom du component + \ + Nom du membre
    'TAG Methode
    '***********************************************
    'CLE D'UNE PROPRIETE
    ' Nom du projet + \ + Nom du component + \ + Nom du membre+Get Set ou Let
    'TAG Met + Num Ligne
    '***********************************************
    On Error Resume Next
    If AfficheMembre(objVBMember) Then                     'on l'affiche ?
        sImageKey = ExtraitIconeMembre(objVBMember, lngCouleurPortee)    'détermination de l'icone
        'Modifié par René Rhéaume le 9 janvier 2002
        'Modifié par René Rhéaume le 16 juin 2002
        ' Optimisation de la modification de FredJust
        'Modifié par René Rhéaume le 20 juin 2002
        ' Ajout d'un titre de dossier plus élégant avec support multilingue

        #If OldC2iStyle = 1 Then
            With objVBMember.Collection.Parent.Parent
                sKey = .Collection.Parent.Name & conBS & .Name & conBS & objVBMember.Name
                Set mNodeMember = tv.Nodes.Add(mNodeCmp, tvwChild, sKey, objVBMember.Name, sImageKey)
            End With
        #Else
            '//-------------------------------------------------------------//
            'Modifications de FredJust le 10/10/2000 16:44:42
            'Ajout d'un Node pour le dossier
            With objVBMember.Collection.Parent.Parent
                sKey = .Collection.Parent.Name & conBS & .Name & conBS
                Select Case conFaux
                    Case objVBMember.Type = vbext_mt_Method, InStr(1, objVBMember.Name, "_") <> 0
                        Set Neu = tv.Nodes(sKey & sImageKey)
                        Set Neu = tv.Nodes.Add(mNodeCmp, tvwChild, sKey & sImageKey, _
                                ObtenirDossierMembre(objVBMember), "d" & sImageKey)
                    Case Else ' Si c'est une procédure événementielle
                        Set Neu = tv.Nodes(sKey & conCmd)
                        Set Neu = tv.Nodes.Add(mNodeCmp, tvwChild, sKey & conCmd, _
                                mlgarTypeMembres(0), "dcmd")
                End Select
                sKey = sKey & objVBMember.Name
                Set mNodeMember = tv.Nodes.Add(Neu, tvwChild, sKey, objVBMember.Name, sImageKey)
            End With
            'Fin de modification
            '//-------------------------------------------------------------//
        #End If
        ' Fin de la modification de René Rhéaume
        mNodeMember.Tag = conTagMethode
        mNodeMember.ForeColor = lngCouleurPortee

        'ajout des Set, Get, Let
        'Modifié par René Rhéaume le 5 juillet 2002
        If (objVBMember.Type = vbext_mt_Property) Then
            AjouterPropriete objVBMember, mNodeMember, vbext_pk_Get, conGet
            If (Not (AjouterPropriete(objVBMember, mNodeMember, vbext_pk_Let, conLet))) Then
                AjouterPropriete objVBMember, mNodeMember, vbext_pk_Set, conSet
            End If
        End If
    End If
    Set mNodeMember = Nothing
End Sub

#If OldC2iStyle <> 1 Then
'Fonction ajoutée par René Rhéaume le 20 juin 2002
' Pour obtenir le nom d'un dossier de membre
Private Function ObtenirDossierMembre(ByVal objMember As VBIDE.Member) As String
    Dim lngIdxIcone As Long
    
    lngIdxIcone = ExtraireNoIconeMembre(objMember)
    If (lngIdxIcone = -1) Then
        ObtenirDossierMembre = mlgTitreInconnu
    Else
        ObtenirDossierMembre = mlgarTypeMembres(lngIdxIcone + 1)
    End If
End Function
#End If

'Fonction ajoutée par René Rhéaume le 5 juillet 2002
Private Function AjouterPropriete(ByVal vbmMembre As VBIDE.Member, _
        ByVal nodMembre As Node, ByVal lngTypeProc As vbext_ProcKind, _
        ByVal strLibelle As String) As Boolean
    Dim lngProp As Long
    Dim nodProp As Node
    
    With vbmMembre
        lngProp = .Collection.Parent.ProcBodyLine(.Name, lngTypeProc)
    End With
    If (lngProp <> 0) Then
        AjouterPropriete = conVrai
        Set nodProp = tv.Nodes.Add(nodMembre, tvwChild, nodMembre.Key & strLibelle, strLibelle, strLibelle)
        nodProp.Tag = conAbrTagMet & CStr(lngProp)
    End If
    Set nodProp = Nothing
End Function

'Optimisé par René Rhéaume le 20 mai 2002
' Une variable objet en moins
'Procédure modifiée par René Rhéaume le 21 juin 2002
' Support multilingue
Public Sub InitReferences(objVBPrj As VBIDE.VBProject)
    Const conClefL10nInitRef As String = "Code.InitReferences."
    Static mlgTitreReferences As String
    Static mlgTitreComposants As String
    Static blnLangOK As Boolean
    If (Not blnLangOK) Then
        mlgTitreReferences = LireChaineLocalisee(conNomUD, _
            conClefL10nInitRef & "mlgTitreReferences", "Références")
        mlgTitreComposants = LireChaineLocalisee(conNomUD, _
            conClefL10nInitRef & "mlgTitreComposants", "Composants")
        blnLangOK = conVrai
    End If

    Dim nodDossier As Node, mNodePrj As Node
    Dim objRef As VBIDE.Reference

    '***********************************************
    'CLE D'UN DOSSIER REFERENCE
    ' Nom du projet + ..reference ou ..composant
    'TAG
    'reference ou OCX
    '***********************************************
    On Error GoTo GestErr

    Set mNodePrj = tv.Nodes(objVBPrj.Name)
    Set nodDossier = tv.Nodes.Add(mNodePrj, tvwChild, mNodePrj.Key & conClefDossReference, _
            mlgTitreReferences, "dreference")
    nodDossier.Tag = "Reference"
    'nodDossier.ForeColor = RGB(0, 0, 255)
    nodDossier.Bold = conVrai
    Set nodDossier = tv.Nodes.Add(mNodePrj, tvwChild, mNodePrj.Key & conClefDossComposant, _
            mlgTitreComposants, "dcomposant")
    nodDossier.Tag = "OCX"
    'nodDossier.ForeColor = RGB(0, 0, 255)
    nodDossier.Bold = conVrai

    For Each objRef In objVBPrj.References
        AjouteReference objVBPrj, objRef
    Next

SortieProc:
    Set mNodePrj = Nothing
    Set nodDossier = Nothing
    Set objRef = Nothing
    Exit Sub

GestErr:
    GererErrInattendue , "UDExplorer.InitReferences"
    Resume SortieProc
End Sub

'Modifié par René Rhéaume le 20 mai 2002
' Fusion avec AjouteOCX et AjouteBibliotheque
Public Sub AjouteReference(ByRef objVBPrj As VBIDE.VBProject, ByRef objRef As VBIDE.Reference)
    '***********************************************
    'CLE D'UNE REFERENCE
    ' Nom du projet + \ + Nom du component + \ + Nom du composant
    'TAG
    'ref
    '***********************************************
    '***********************************************
    'CLE D'UN OCX
    ' Nom du projet + \ + Nom du component + \ + Nom du composant
    'TAG
    'ocx
    '***********************************************
    Dim nodParent As Node, nodAjout As Node
    Dim strTag As String, strClefImg As String
    
    Err.Clear
    On Error Resume Next
    Select Case conVrai
        Case (Right$(objRef.FullPath, 3) = conExtOca), Err
            Err.Clear
            Set nodParent = tv.Nodes(objVBPrj.Name & conClefDossComposant)
            strTag = conTagOcx
            strClefImg = conImgComposant
'            AjouteOCX objRef, tv.Nodes(objVBPrj.Name & conClefDossComposant)
        Case Else
            Set nodParent = tv.Nodes(objVBPrj.Name & conClefDossReference)
            strTag = "ref"
            strClefImg = "reference"
'            AjouteBibliotheque objRef, tv.Nodes(objVBPrj.Name & conClefDossReference)
    End Select
    
    Set nodAjout = tv.Nodes.Add(nodParent, tvwChild, nodParent.Key & objRef.Name, _
                    objRef.Description & " (" & CStr(objRef.Major) + "." & CStr(objRef.Minor) & conPF, _
                    strClefImg)
    nodAjout.Tag = strTag
    If (objRef.IsBroken) Then
        nodAjout.ForeColor = vbRed                             'lien cassé
    Else
        If (objRef.BuiltIn) Then
            nodAjout.ForeColor = vbBlue                        'ne peut être supprimé
        End If
    End If

    Set nodAjout = Nothing
    Set nodParent = Nothing
End Sub

' Procédure ajoutée par René Rhéaume le 11 janvier 2003
Public Sub RetireReference(objRef As VBIDE.Reference)
    Dim strClefParent As String
    Dim strClef As String
    
    strClefParent = objRef.Collection.Parent.Name
    On Error Resume Next
    Select Case conVrai
        Case IsSameString(Right$(objRef.FullPath, 3), conExtOca), Err
            Err.Clear
            strClefParent = strClefParent & conClefDossComposant
        Case Else
            strClefParent = strClefParent & conClefDossReference
    End Select
    
    On Error GoTo Fin
    strClef = strClefParent & objRef.Name
    
    With tv.Nodes
        .Remove strClef
    
        If (.Item(strClefParent).Children = 0) Then
            .Remove strClefParent
        End If
    End With
    
Fin:

End Sub

'Fonction optimisée par René Rhéaume le 19 juin 2002
' Recherche dichotomique
'Procédure modifiée par René Rhéaume le 21 juin 2002
' Support multilingue
'Procédure modifiée par René Rhéaume le 30 juillet 2002
' Correction de la recherche dichotomique
'Note par René Rhéaume le 24 août 2002
' J'avais oublié d'écrire que j'avais modifié cette
' fonction le 30 juillet dernier
Private Function NodeTypeFeuille(ByVal sNomProjet As String, sImageKey As String) As Node
    Const conClefL10nTypeMod As String = "Code.NodeTypeFeuille.mlgarTitreTypeModule("
    Static mlgarTitreTypeModule() As String
    Static blnLangOK As Boolean
    Dim I As Long
    If (Not blnLangOK) Then
        StrArray mlgarTitreTypeModule, _
            "Concepteur(s) ActiveX", "Module(s) de classe", "Document(s) utilisateur", _
            "Formulaire(s) MSForms", "Page(s) de propriétés", "Document(s) associé(s)", _
            "Ressources externes", "Module(s)", "Contrôle(s) utilisateur", _
            "Fenêtre(s) enfant MDI", "Formulaire(s)", "Fenêtre MDI mère"
        If (blnMultilingueActive) Then
            For I = 0 To 11
                mlgarTitreTypeModule(I) = LireChaineLocalisee(conNomUD, _
                        conClefL10nTypeMod & I & conPF, mlgarTitreTypeModule(I))
            Next I
        End If
        blnLangOK = conVrai
    End If
    
    'ajoute un type de feuille
    On Error GoTo GestErr

    '***********************************************
    'CLE D'UN DOSSIER
    ' Nom du projet + .. + Feuille ou feuille Fille ou.....
    'TAG
    'Dossier
    '***********************************************
    Set NodeTypeFeuille = tv.Nodes(sNomProjet & ".." & sImageKey)
    Exit Function

GestErr:
    'le type n'a pas été ajouté
    Dim sNomType As String
    Dim lngIdxInf As Long, lngIdxSup As Long, lngIdxMed As Long
    Dim blnTrouve As Boolean
    'blnTrouve = conFaux 'auto-initialisation de VB
    'lngIdxInf = 0 'auto-initialisation de VB
    lngIdxSup = UBound(conarClefTypeModule) + 1
    lngIdxMed = ((lngIdxInf + lngIdxSup) \ 2)
    
    Do Until ((blnTrouve) Or ((lngIdxSup - lngIdxInf) < 1))
        Select Case (sImageKey)
            Case conarClefTypeModule(lngIdxMed)
                blnTrouve = conVrai
            Case Is > conarClefTypeModule(lngIdxMed)
                lngIdxInf = lngIdxMed
            Case Else
                lngIdxSup = lngIdxMed
        End Select
        lngIdxMed = ((lngIdxInf + lngIdxSup) \ 2)
    Loop
    
    If (blnTrouve) Then
        sNomType = mlgarTitreTypeModule(lngIdxMed)
    Else
        sNomType = mlgTitreInconnu
    End If

    Err.Clear
    Set NodeTypeFeuille = tv.Nodes.Add(tv.Nodes(sNomProjet), tvwChild, _
                            sNomProjet & ".." & sImageKey, sNomType, "d" & sImageKey)
    NodeTypeFeuille.Tag = "Dossier"
    'NodeTypeFeuille.ForeColor = RGB(0, 0, 255)
    NodeTypeFeuille.Bold = conVrai
End Function

'Procédure modifiée par René Rhéaume le 15 juillet 2002
' Corrigé l'erreur 9 lorsqu'on clique sur un fichier .res
'Procédure modifiée par René Rhéaume le 3 janvier 2002
' Support des documents associés
Private Sub Analyse_Component(ByVal mNode As Node, ByRef objPrj As VBIDE.VBProject, _
                                ByRef objCmp As VBIDE.VBComponent)
    Dim sKey As String, strClefPrj As String

'    On Error GoTo GestErr                           'à cause des Resfile qui ont une clé =vbNullString et n'ont pas de Designer
    strClefPrj = mNode.Parent.Parent.Key
    Set objPrj = VBInstance.VBProjects(strClefPrj) 'on recherche le projet
    sKey = Right$(mNode.Key, Len(mNode.Key) - Len(strClefPrj) - 1)    'clé du component
    Select Case mNode.Image
        Case conarClefTypeModule(5), conarClefTypeModule(6)
        Case Else
            Set objCmp = objPrj.VBComponents(sKey)
    End Select
    
'    Exit Sub
'GestErr:
'    GererErrInattendue , "UDExplorer.Analyse_Component"
End Sub

Private Sub Analyse_Methode(ByVal mNode As Node, ByRef objPrj As VBIDE.VBProject, _
                            ByRef objCmp As VBIDE.VBComponent, ByRef objMember As Member)
    Dim sKey As String, mNodeRecherche As Node
    Dim strClefPrj As String, strClefPar As String
    Dim lngLenCPar As String

    Select Case mNode
        Case conGet, conLet, conSet
            Set mNodeRecherche = mNode.Parent
        Case Else
            Set mNodeRecherche = mNode
    End Select
    'Set objPrj = VBInstance.VBProjects(mNodeRecherche.Parent.Parent.Parent.Key)    'on recherche le projet
    With mNodeRecherche.Parent.Parent
        strClefPrj = .Parent.Parent.Key
        strClefPar = .Key
    End With
    lngLenCPar = Len(strClefPar)
    Set objPrj = VBInstance.VBProjects(strClefPrj)         'on recherche le projet
    sKey = Right$(strClefPar, lngLenCPar - Len(strClefPrj) - 1)    'clé du component
    Set objCmp = objPrj.VBComponents(sKey)
    sKey = Right$(mNodeRecherche.Key, Len(mNodeRecherche.Key) - lngLenCPar - 1)    'clé du membre
    On Error Resume Next
    Set objMember = objCmp.CodeModule.Members(sKey)
End Sub

Private Sub UserDocument_Show()
    UserDocument_Resize
End Sub

'Procédure modifiée par René Rhéaume le 19 juin 2002
Private Sub InitToolbar()
    InitialiserTbFiltre
    InitialiserTbGene
    InitialiserTbDescription
End Sub

'Procédure ajoutée par René Rhéaume le 19 juin 2002
Private Sub InitialiserTbFiltre()
    Dim objButton As Button
    Dim I As Long
    With tbFiltre
        For I = 0 To 8
            Set objButton = .Buttons.Add(, conarClefTypeMembre(I), , , conarClefTypeMembre(I))
            objButton.ToolTipText = mlgarTypeMembres(I + 1)
        Next I
    End With
    Set objButton = Nothing
End Sub

'Procédure ajoutée par René Rhéaume le 19 juin 2002
Private Sub InitialiserTbGene()
    Const conL10nTbGene As String = "Obj.tbGene.Buttons("
    Dim strarNomsBtnMenu() As String
    Dim objButton As Button
    Dim I As Long

    StrArray conarClefBtnMenu, _
            "info", "propgene", "msgboxgene", "biblio", "internet", "capture", "options"
    StrArray strarNomsBtnMenu, _
            "Durée du développement", "Générateur de propriétés", "Générateur de MsgBox", _
            "Bibliothèque de code", "c2iExplorer sur le Web", "Imprimer un rapport", "Options"
            
    With tbGene
'        Set .ImageList = ImgTBGene
'        Set .HotImageList = ImgTBGene

        Set objButton = .Buttons.Add(, conActu, , , conActu)
        objButton.ToolTipText = mlgLibelActu

        Set objButton = .Buttons.Add(, conVoir, , , conVoir)
        objButton.ToolTipText = LireChaineLocalisee(conNomUD, _
                conL10nTbGene & "2-->'voir').ToolTipText", "Voir")

        Set objButton = .Buttons.Add(, conDelete, , , conDelete)
        objButton.ToolTipText = mlgLibelDelete

        Set objButton = .Buttons.Add(, conProp, , tbrDropdown, conarClefBtnMenu(0))
        For I = 0 To 6
            objButton.ButtonMenus.Add , conarClefBtnMenu(I), _
                    LireChaineLocalisee(conNomUD, _
                            "Obj.tbGene.Buttons(4-->'prop').ButtonMenus(" & (I + 1) & ").Text", _
                            strarNomsBtnMenu(I))
        Next I
        objButton.ToolTipText = objButton.ButtonMenus(1).Text
        sSelectedTBButton = conarClefBtnMenu(0)

        Set objButton = .Buttons.Add(, "nul1", , tbrSeparator)

        Set objButton = .Buttons.Add(, conCompile, , , conCompile)
        objButton.ToolTipText = LireChaineLocalisee(conNomUD, _
                conL10nTbGene & "6-->'compile').ToolTipText", "Compiler")
    End With
    
    Set objButton = Nothing
End Sub

'Procédure ajoutée par René Rhéaume le 19 juin 2002
Private Sub InitialiserTbDescription()
    Dim objButton As Button

    With tbDescription
'        Set .ImageList = ImgTbDescription
'        Set .HotImageList = ImgTbDescription
        Set objButton = .Buttons.Add(, conOK, , , conOK)
        objButton.ToolTipText = LireChaineLocalisee(conNomUD, _
                "Obj.tbDescription.Buttons(1-->'ok').ToolTipText", "Appliquer la description")
    End With

    Set objButton = Nothing
End Sub

'Procédure modiifée par René Rhéaume le 12 janvier 2003
Public Sub Work(Optional ByVal bWork As Boolean = conVrai)
    With tbGene.Buttons(conActu)
        If (bWork) Then
            .Image = "actuwork"
        Else
            .Image = conActu
        End If
    End With
    DoEvents
End Sub

Private Sub UserDocument_Terminate()
    'Modifié par René Rhéaume, 3 août 2001
    sSelectedTBButton = vbNullString
    Set SelectedNode = Nothing
    Set ElementsBiblio = Nothing

    'Modifié par René Rhéaume 29 juillet 2001
    WritePrivateProfileString conSecGen, conValData, c2iCurrentDataFileName, c2iINIFile
    
    'Modifié par René Rhéaume le 22 janvier 2003
    'Les préférences d'affichage sont maintenant sauvegardées
    WritePrivateProfileString conSecGen, conValDescBar, CStr(Abs(blnAffDesc)), c2iINIFile
    WritePrivateProfileString conSecGen, conValFltBar, CStr(Abs(blnAffFiltres)), c2iINIFile
End Sub

' Procédure ajoutée par René Rhéaume le 13 janvier 2003
Private Sub ChercherDocAssocie(nodDocAssocie As Node, ByRef vbpProjet As VBIDE.VBProject, _
ByRef vbcDocAssocie As VBIDE.VBComponent)
    Dim I As Long
    Dim lngNbComposants As Long
    Dim blnTrouve As Boolean
    Set vbpProjet = VBInstance.VBProjects(nodDocAssocie.Parent.Parent.Key)
    I = 1
    
    With vbpProjet.VBComponents
        lngNbComposants = .Count
        
        Do Until ((blnTrouve) Or (I > lngNbComposants))
            If (IsSameString(.Item(I).FileNames(1), nodDocAssocie.Text)) Then
                blnTrouve = conVrai
                Set vbcDocAssocie = .Item(I)
            Else
                I = I + 1
            End If
        Loop
    End With
End Sub
