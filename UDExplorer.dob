Private Sub tbDescription_ButtonClick(ByVal Button As MSComctlLib.Button)
    Dim objVBPrj As VBIDE.VBProject, objCmp As VBIDE.VBComponent
    Dim objMember As Member
    Dim nodSelection As Node

    On Error GoTo Fin
    If (Button.Key = conOK) Then
        Set nodSelection = tv.SelectedItem
        If (Not nodSelection Is Nothing) Then
            Select Case Left$(nodSelection.Tag, 3)
                Case conAbrTagCom 'on clique sur un component
                    Analyse_Component nodSelection, objVBPrj, objCmp
                    If (Not objCmp Is Nothing) Then
                        objCmp.Description = txtDescription
                    End If
                Case conAbrTagMet
                    Analyse_Methode nodSelection, objVBPrj, objCmp, objMember    'par référence
                    If (Not objMember Is Nothing) Then
                        objMember.Description = txtDescription
                    End If
            End Select
        End If
    End If

SortieProc:
    Set nodSelection = Nothing
    Exit Sub
Fin:
    GererErrInattendue , "UDExplorer.tbDescription_ButtonClick"
    '    Debug.Assert conFaux
    Resume SortieProc
End Sub

' Ajout par René Rhéaume le 2 août 2001
Private Sub tbDescription_MouseUp(Button As Integer, Shift As Integer, X As Single, Y As Single)
    If Button = vbRightButton Then
        PopupMenu mnuAffichage, , X + tbDescription.Left, Y + tbDescription.Top
    End If
End Sub

Private Sub tbFiltre_ButtonClick(ByVal Button As MSComctlLib.Button)
    Const conDebClefMasquer As String = "n-"
    'mise à jour des images
    If Left$(Button.Image, 2) = conDebClefMasquer Then
        Button.Image = Right$(Button.Image, Len(Button.Image) - 2)
    Else
        Button.Image = conDebClefMasquer & Button.Image
    End If
    Select Case Button.Key
        Case conarClefTypeMembre(0)
            bAfficheVariable = Not bAfficheVariable
        Case conarClefTypeMembre(1)
            bAfficheConstante = Not bAfficheConstante
        Case conarClefTypeMembre(2)
            bAfficheMethode = Not bAfficheMethode
        Case conarClefTypeMembre(3)
            bAfficheEvenement = Not bAfficheEvenement
        Case conarClefTypeMembre(4)
            bAffichePropriete = Not bAffichePropriete
        Case conarClefTypeMembre(5)
            bAfficheAPI = Not bAfficheAPI
        Case conarClefTypeMembre(6)
            bAffichePublic = Not bAffichePublic
        Case conarClefTypeMembre(7)
            bAffichePrive = Not bAffichePrive
        Case conarClefTypeMembre(8)
            bAfficheFriend = Not bAfficheFriend
    End Select
End Sub

