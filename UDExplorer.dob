'(supposé être Ctrl+Clic) d'un formulaire, module, etc.
Private Sub tv_MouseUp(Button As Integer, Shift As Integer, X As Single, Y As Single)
    Dim objPrj As VBIDE.VBProject, objCmp As VBIDE.VBComponent
    
    If Button = vbLeftButton Then
        If Shift = vbCtrlMask Then
            Select Case tv.SelectedItem.Tag
                Case "Component"
                    Analyse_Component tv.SelectedItem, objPrj, objCmp
                    On Error Resume Next
                    objWindowClassViewer.Visible = conVrai
                    objUDClassViewer.Init objCmp
            End Select
        End If
    End If
