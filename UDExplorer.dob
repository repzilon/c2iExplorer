'    Set tv.ImageList = ImgLSttv
    'par défaut, on affiche tout
    bAfficheConstante = conVrai
    bAfficheVariable = conVrai
    bAffichePropriete = conVrai
    bAfficheMethode = conVrai
    bAfficheEvenement = conVrai
    bAfficheAPI = conVrai
    bAfficheFriend = conVrai
    bAffichePrive = conVrai
    bAffichePublic = conVrai

    blnAffDesc = CBool(GetPrivateProfileInt(conSecGen, conValDescBar, 1, c2iINIFile))
    blnAffFiltres = CBool(GetPrivateProfileInt(conSecGen, conValFltBar, 1, c2iINIFile))

    Set ElementsBiblio = New cElements
    InitToolbar
    
    If (blnMultilingueActive) Then
        mnuAffichageBarreDescription.Caption = LireChaineLocalisee(conNomUD, _
                "Obj.mnuAffichageBarreDescription.Caption", _
                mnuAffichageBarreDescription.Caption)
        mnuAffichageBarreFiltres.Caption = LireChaineLocalisee(conNomUD, _
                "Obj.mnuAffichageBarreFiltres.Caption", mnuAffichageBarreFiltres.Caption)
    End If
    
'    ExtraireImageList ImgLstFilter, "UDExplorer.ImgLstFilter"
'    ExtraireImageList ImgLSttv, "UDExplorer.ImgLSttv"
'    ExtraireImageList ImgTbDescription, "UDExplorer.ImgTbDescription"
