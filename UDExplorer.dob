Private Sub tbDescription_ButtonClick(ByVal Button As MSComctlLib.Button)
    Dim objVBPrj As VBIDE.VBProject, objCmp As VBIDE.VBComponent
    Dim objMember As Member

    On Error GoTo Fin
    If Button.Key = "ok" Then
        If tv.SelectedItem Is Nothing Then Exit Sub
        Select Case Left$(tv.SelectedItem.Tag, 3)
            'on clique sur un component
            Case "Com"
                Analyse_Component tv.SelectedItem, objVBPrj, objCmp
                If Not objCmp Is Nothing Then
                    objCmp.Description = txtDescription
                End If
            Case "Met"
                Analyse_Methode tv.SelectedItem, objVBPrj, objCmp, objMember    'par référence
                If Not objMember Is Nothing Then
                    objMember.Description = txtDescription
                End If
        End Select
    End If
    Exit Sub
Fin:
    MsgBox "Erreur no " & Err.Number & vbCrLf & Err.Description & vbCrLf & Err.Source, vbExclamation
    Debug.Assert conFaux
End Sub

