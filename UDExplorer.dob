    End If
End Sub

' Optimisation par René Rhéaume le 13 janvier 2003
Private Sub tbFiltre_ButtonClick(ByVal Button As MSComctlLib.Button)
    Const conDebClefMasquer As String = "n-"
    Dim strImgBouton As String
    
    strImgBouton = Button.Image
    'mise à jour des images
    If (IsSameString(Left$(strImgBouton, 2), conDebClefMasquer)) Then
        strImgBouton = Right$(strImgBouton, Len(strImgBouton) - 2)
    Else
        strImgBouton = conDebClefMasquer & strImgBouton
    End If
    Button.Image = strImgBouton
    
    Select Case Button.Key
        Case conarClefTypeMembre(0)
            bAfficheVariable = Not bAfficheVariable
        Case conarClefTypeMembre(1)
            bAfficheConstante = Not bAfficheConstante
        Case conarClefTypeMembre(2)
            bAfficheMethode = Not bAfficheMethode
        Case conarClefTypeMembre(3)
            bAfficheEvenement = Not bAfficheEvenement
        Case conarClefTypeMembre(4)
            bAffichePropriete = Not bAffichePropriete
        Case conarClefTypeMembre(5)
            bAfficheAPI = Not bAfficheAPI
        Case conarClefTypeMembre(6)
            bAffichePublic = Not bAffichePublic
        Case conarClefTypeMembre(7)
            bAffichePrive = Not bAffichePrive
        Case conarClefTypeMembre(8)
            bAfficheFriend = Not bAfficheFriend
    End Select
End Sub

' Ajout par René Rhéaume le 2 août 2001
