Private Sub UserDocument_Resize()
    Dim lngHauteurTV As Long
    Dim lngLargeurBtnDesc As Long

    On Error Resume Next
    lngHauteurTV = ScaleHeight - tbGene.Height
    If (blnAffDesc) Then
        lngHauteurTV = lngHauteurTV - tbDescription.Height
    End If
    If (blnAffFiltres) Then
        lngHauteurTV = lngHauteurTV - tbFiltre.Height
    End If
        
    tv.Move 0, tbGene.Height, tbFiltre.Width, lngHauteurTV

    If (blnAffDesc) Then
        lngLargeurBtnDesc = tbDescription.Buttons(1).Width
        txtDescription.Move lngLargeurBtnDesc, 0, ScaleWidth - lngLargeurBtnDesc, lngLargeurBtnDesc
    End If
End Sub

Public Sub Init(Optional ByVal bClear As Boolean = conFaux)
    Dim objVBPrj As VBIDE.VBProject

    If (bClear) Then
        With tv
            .Visible = conFaux
            .Nodes.Clear
            .Visible = conVrai
        End With
    End If

    On Error Resume Next
    For Each objVBPrj In VBInstance.VBProjects
        AjouteProjet objVBPrj
    Next

    Set objVBPrj = Nothing
End Sub

Public Sub AjouteProjet(ByVal objVBPrj As VBIDE.VBProject)
    Dim sKey As String, sImageKey As String
    Dim mNodePrj As Node
    Dim objVBCmp As VBIDE.VBComponent

    Set Connection.refEvent = VBInstance.Events.ReferencesEvents(objVBPrj)

    '***********************************************
    'CLE D'UN PROJET
    ' Nom du projet
    'TAG
    'Projet
    '***********************************************
    tv.Sorted = conFaux
    'ajout des projets
    sKey = objVBPrj.Name
    sImageKey = ExtraitIconeProjet(objVBPrj)
    Set mNodePrj = tv.Nodes.Add(, , sKey, objVBPrj.Name, sImageKey)
    mNodePrj.Tag = conTagProjet
    mNodePrj.Sorted = conVrai
    If (objVBPrj Is objVBPrj.Collection.StartProject) Then
        mNodePrj.Bold = conVrai
    End If

    'ajout des composants du projet

    tv.Enabled = conFaux
    tv.Visible = conFaux

    '    'Modification FredJust
    '    'Permet d'avoir les dossiers toujours dans le meme ordre
    '    Dim Neu As Node
    '    Set Neu = tv.Nodes.Add(tv.Nodes(objVBPrj.Name), tvwChild, objVBPrj.Name + ".." + "VBForm", "Feuilles", "dVBForm")
    '    Neu.Tag = "Dossier"
    '    Neu.Bold = conVrai
    '
    '    Set Neu = tv.Nodes.Add(tv.Nodes(objVBPrj.Name), tvwChild, objVBPrj.Name + ".." + "StdModule", "Modules", "dStdModule")
    '    Neu.Tag = "Dossier"
    '    Neu.Bold = conVrai
    '
    '
    '    Set Neu = tv.Nodes.Add(tv.Nodes(objVBPrj.Name), tvwChild, objVBPrj.Name + ".." + "ClassModule", "Modules de classe", "dClassModule")
    '    Neu.Tag = "Dossier"
    '    Neu.Bold = conVrai
    '    'Fin de modification
    For Each objVBCmp In objVBPrj.VBComponents
        AjouteComponent objVBCmp
    Next

    mNodePrj.Sorted = conFaux
    InitReferences objVBPrj
    tv.Enabled = conVrai
    tv.Visible = conVrai

    Set tv.SelectedItem = mNodePrj
    Set mNodePrj = Nothing
    Set objVBCmp = Nothing
End Sub

Public Sub RetireProjet(ByVal objVBPrj As VBIDE.VBProject)
    On Error Resume Next
    tv.Nodes.Remove objVBPrj.Name
End Sub

'Optimisé par René Rhéaume le 18 mai 2002
Public Sub AjouteComponent(ByVal objVBCmp As VBIDE.VBComponent)
    Dim mNodePrj As Node, mNodeCmp As Node
    Dim sKey As String
    Dim sImageKey As String
    Dim strNomProjet As String

    On Error GoTo GestErr

    '***********************************************
    'CLE D'UN COMPONENT
    ' Nom du projet + \ + Nom du component
    'TAG
    'Component
    '***********************************************
    strNomProjet = objVBCmp.Collection.Parent.Name
    Set mNodePrj = tv.Nodes(strNomProjet)
    sImageKey = ExtraitIconeComponent(objVBCmp)
    If (objVBCmp.Type = vbext_ct_ResFile) Then
        sKey = strNomProjet & conBS & conClefRessource
        Set mNodeCmp = tv.Nodes.Add(NodeTypeFeuille(strNomProjet, sImageKey), tvwChild, sKey, objVBCmp.FileNames(1), sImageKey)
    Else
        sKey = strNomProjet & conBS & objVBCmp.Name
        Set mNodeCmp = tv.Nodes.Add(NodeTypeFeuille(strNomProjet, sImageKey), tvwChild, sKey, objVBCmp.Name, sImageKey)
        mNodeCmp.EnsureVisible
    End If
    mNodeCmp.Tag = conTagComponent
    mNodeCmp.Sorted = conVrai

GestErr:
    Set mNodePrj = Nothing
    Set mNodeCmp = Nothing
End Sub

Public Sub RetireComposant(ByVal objVBCmp As VBIDE.VBComponent, Optional ByVal sOldName As String)
    Dim sKeyParent As String, sName As String, strClef As String

    If (sOldName = vbNullString) Then
        sName = objVBCmp.Name
    Else
        sName = sOldName
    End If
    On Error GoTo GestErr
    strClef = objVBCmp.Collection.Parent.Name & conBS & sName
    sKeyParent = tv.Nodes(strClef).Parent.Key
    tv.Nodes.Remove strClef

    If (tv.Nodes(sKeyParent).Children = 0) Then
        tv.Nodes.Remove sKeyParent
    End If
    Exit Sub

GestErr:
    MsgBox "Cliquez sur le bouton Actualiser", vbInformation
End Sub

Public Function AjouteMembre(ByRef mNodeCmp As Node, ByRef objVBMember As VBIDE.Member)
    #If OldC2iStyle <> 1 Then
        Const conCmd As String = "cmd"
    #End If
    Dim sImageKey As String, lngCouleurPortee As Long, sKey As String
    Dim mNodeMember As Node, mNodeProp As Node
    #If OldC2iStyle <> 1 Then
        Dim Neu As Node
    #End If
    
    '***********************************************
    'CLE D'UN MEMBRE
    ' Nom du projet + \ + Nom du component + \ + Nom du membre
    'TAG Methode
    '***********************************************
    'CLE D'UNE PROPRIETE
    ' Nom du projet + \ + Nom du component + \ + Nom du membre+Get Set ou Let
    'TAG Met + Num Ligne
    '***********************************************
    On Error Resume Next
    If AfficheMembre(objVBMember) Then                     'on l'affiche ?
        sImageKey = ExtraitIconeMembre(objVBMember, lngCouleurPortee)    'détermination de l'icone
        ' Modifié par René Rhéaume le 9 janvier 2002
        ' Optimisation de la modification de FredJust

        #If OldC2iStyle = 1 Then
            With objVBMember.Collection.Parent.Parent
                sKey = .Collection.Parent.Name & conBS & .Name & conBS & objVBMember.Name
                Set mNodeMember = tv.Nodes.Add(mNodeCmp, tvwChild, sKey, objVBMember.Name, sImageKey)
            End With
        #Else
            '//-------------------------------------------------------------//
            'Modifications de FredJust le 10/10/2000 16:44:42
            'Ajout d'un Node pour le dossier
            With objVBMember.Collection.Parent.Parent
                sKey = .Collection.Parent.Name & conBS & .Name & conBS
                Set Neu = tv.Nodes(sKey & sImageKey)
                Set Neu = tv.Nodes.Add(mNodeCmp, tvwChild, sKey & sImageKey, sImageKey, "d" & sImageKey)
                Select Case conFaux
                    Case objVBMember.Type = vbext_mt_Method, InStr(1, objVBMember.Name, "_") <> 0
                    Case Else
                        Set Neu = tv.Nodes(sKey & conCmd)
                        Set Neu = tv.Nodes.Add(mNodeCmp, tvwChild, sKey & conCmd, "Objets", "dcmd")
                End Select
                sKey = sKey & objVBMember.Name
                Set mNodeMember = tv.Nodes.Add(Neu, tvwChild, sKey, objVBMember.Name, sImageKey)
            End With
            'Fin de modification
            '//-------------------------------------------------------------//
        #End If
        ' Fin de la modification de René Rhéaume
        mNodeMember.Tag = conTagMethode
        mNodeMember.ForeColor = lngCouleurPortee

        'ajout des Set, Get, Let
        If (objVBMember.Type = vbext_mt_Property) Then
            Dim iGet As Long, iLet As Long, iSet As Long
            With objVBMember.Collection.Parent
                'recherche du Get
                iGet = .ProcBodyLine(objVBMember.Name, vbext_pk_Get)
                If (iGet <> 0) Then
                    Set mNodeProp = tv.Nodes.Add(mNodeMember, tvwChild, mNodeMember.Key + conGet, conGet, conGet)
                    mNodeProp.Tag = conAbrTagMet & CStr(iGet)
                End If
                'recherche du Let
                iLet = .ProcBodyLine(objVBMember.Name, vbext_pk_Let)
                If (iLet <> 0) Then
                    Set mNodeProp = tv.Nodes.Add(mNodeMember, tvwChild, mNodeMember.Key + conLet, conLet, conLet)
                    mNodeProp.Tag = conAbrTagMet & CStr(iLet)
                Else
                    'recherche du Set
                    iSet = .ProcBodyLine(objVBMember.Name, vbext_pk_Set)
                    If (iSet <> 0) Then
                        Set mNodeProp = tv.Nodes.Add(mNodeMember, tvwChild, mNodeMember.Key + conSet, conSet, conSet)
                        mNodeProp.Tag = conAbrTagMet & CStr(iSet)
                    End If
                End If
            End With
            Set mNodeProp = Nothing
        End If
    End If
    Set mNodeMember = Nothing
End Function

'Optimisé par René Rhéaume le 20 mai 2002
' Une variable objet en moins
Public Sub InitReferences(objVBPrj As VBIDE.VBProject)
    Dim nodDossier As Node, mNodePrj As Node
    Dim objRef As VBIDE.Reference

    '***********************************************
    'CLE D'UN DOSSIER REFERENCE
    ' Nom du projet + ..reference ou ..composant
    'TAG
    'reference ou OCX
    '***********************************************
    On Error GoTo GestErr

    Set mNodePrj = tv.Nodes(objVBPrj.Name)
    Set nodDossier = tv.Nodes.Add(mNodePrj, tvwChild, mNodePrj.Key & conClefDossReference, "Références", "dreference")
    nodDossier.Tag = "Reference"
    'nodDossier.ForeColor = RGB(0, 0, 255)
    nodDossier.Bold = conVrai
    Set nodDossier = tv.Nodes.Add(mNodePrj, tvwChild, mNodePrj.Key & conClefDossComposant, "Composants", "dcomposant")
    nodDossier.Tag = "OCX"
    'nodDossier.ForeColor = RGB(0, 0, 255)
    nodDossier.Bold = conVrai

    For Each objRef In objVBPrj.References
        AjouteReference objVBPrj, objRef
    Next

SortieProc:
    Set mNodePrj = Nothing
    Set nodDossier = Nothing
    Set objRef = Nothing
    Exit Sub

GestErr:
    GererErrInattendue , "UDExplorer.InitReferences"
    Resume SortieProc
End Sub

'Modifié par René Rhéaume le 20 mai 2002
' Fusion avec AjouteOCX et AjouteBibliotheque
Public Sub AjouteReference(ByRef objVBPrj As VBIDE.VBProject, ByRef objRef As VBIDE.Reference)
    '***********************************************
    'CLE D'UNE REFERENCE
    ' Nom du projet + \ + Nom du component + \ + Nom du composant
    'TAG
    'ref
    '***********************************************
    '***********************************************
    'CLE D'UN OCX
    ' Nom du projet + \ + Nom du component + \ + Nom du composant
    'TAG
    'ocx
    '***********************************************
    Dim nodParent As Node, nodAjout As Node
    Dim strTag As String, strClefImg As String
    
    Err.Clear
    On Error Resume Next
    Select Case conVrai
        Case (Right$(objRef.FullPath, 3) = "oca"), Err
            Err.Clear
            Set nodParent = tv.Nodes(objVBPrj.Name & conClefDossComposant)
            strTag = conTagOcx
            strClefImg = conImgComposant
'            AjouteOCX objRef, tv.Nodes(objVBPrj.Name & conClefDossComposant)
        Case Else
            Set nodParent = tv.Nodes(objVBPrj.Name & conClefDossReference)
            strTag = "ref"
            strClefImg = "reference"
'            AjouteBibliotheque objRef, tv.Nodes(objVBPrj.Name & conClefDossReference)
    End Select
    
    Set nodAjout = tv.Nodes.Add(nodParent, tvwChild, nodParent.Key & objRef.Name, _
                    objRef.Description & " (" & CStr(objRef.Major) + "." & CStr(objRef.Minor) & ")", _
                    strClefImg)
    nodAjout.Tag = strTag
    If (objRef.IsBroken) Then
        nodAjout.ForeColor = vbRed                             'lien cassé
    Else
        If (objRef.BuiltIn) Then
            nodAjout.ForeColor = vbBlue                        'ne peut être supprimé
        End If
    End If

    Set nodAjout = Nothing
    Set nodParent = Nothing
End Sub

Private Function NodeTypeFeuille(ByVal sNomProjet As String, sImageKey As String) As Node
    'ajoute un type de feuille
    On Error GoTo GestErr

    '***********************************************
    'CLE D'UN DOSSIER
    ' Nom du projet + .. + Feuille ou feuille Fille ou.....
    'TAG
    'Dossier
    '***********************************************
    Set NodeTypeFeuille = tv.Nodes(sNomProjet & ".." & sImageKey)
    Exit Function

GestErr:
    'le type n'a pas été ajouté
    Dim sNomType As String

    If lngLanguage = c2i_Langue_Français Then
        Select Case sImageKey
            Case conActiveXDesigner
                sNomType = "Concepteur(s) ActiveX"
            Case conClassModule
                sNomType = "Module(s) de classe"
            Case conDocObject
                sNomType = "Document(s) utilisateur"
            Case conMSForm
                sNomType = "Formulaire(s) MSForms"
            Case conPropPage
                sNomType = "Page(s) de propriétés"
            Case conRelatedDocument
                sNomType = "Document(s) associé(s)"
            Case conResFile
                sNomType = "Ressources externes"
            Case conStdModule
                'Note par René Rhéaume 27 julllet 2001 8h53 HAE
                'Si vous changez ce nom, il faudra aussi le changer dans
                'cette chaîne Sub tbGene_ButtonClick de ce document
                'utilisateur. Si les noms en français et en anglais ne
                'sont plus les mêmes, il faudra changer le
                '«Case "<Nom>"» par «Case "<Nom français>", "<English Name>"»
                sNomType = conTexteModule
            Case conUserControl
                sNomType = "Contrôle(s) utilisateur"
            Case conVBChildForm
                sNomType = "Fenêtre(s) enfant MDI"
            Case conVBForm
                sNomType = "Formulaire(s)"
                sImageKey = "VBForm"
            Case conVBMDIForm
                sNomType = "Fenêtre MDI mère"
            Case Else
                sNomType = conInconnu
        End Select
    Else
        Select Case sImageKey
            Case conActiveXDesigner
                sNomType = "ActiveX Designer(s)"
            Case conClassModule
                sNomType = "Class module(s)"
            Case conDocObject
                sNomType = "User document(s)"
            Case conMSForm
                sNomType = "MS Form"
            Case conPropPage
                sNomType = "Property page(s)"
            Case conRelatedDocument
                sNomType = "Associated document(s)"
            Case conResFile
                sNomType = "Ressource file"
            Case conStdModule
                'Note par René Rhéaume 27 julllet 2001 8h53 HAE
                'Si vous changez ce nom, il faudra aussi le changer dans
                'cette chaîne Sub tbGene_ButtonClick de ce document
                'utilisateur. Si les noms en français et en anglais ne
                'sont plus les même, il faudra changer le
                '«Case "<Nom>"» par «Case "<Nom français>", "<English Name>"»
                sNomType = conTexteModule
            Case conUserControl
                sNomType = "User Control(s)"
            Case conVBChildForm
                sNomType = "Child Form(s)"
            Case conVBForm
                sNomType = "Form(s)"
            Case conVBMDIForm
                sNomType = "MDI Form"
            Case Else
                sNomType = "Unknown"
        End Select
    End If
    Err.Clear
    Set NodeTypeFeuille = tv.Nodes.Add(tv.Nodes(sNomProjet), tvwChild, sNomProjet + ".." + sImageKey, sNomType, "d" & sImageKey)
    NodeTypeFeuille.Tag = "Dossier"
    'NodeTypeFeuille.ForeColor = RGB(0, 0, 255)
    NodeTypeFeuille.Bold = conVrai
End Function

Private Sub Analyse_Component(ByVal mNode As Node, ByRef objPrj As VBIDE.VBProject, ByRef objCmp As VBIDE.VBComponent)
    Dim sKey As String, strClefPrj As String

    On Error Resume Next                                   'à cause des Resfile qui ont une clé =vbNullString et n'ont pas de Designer
    strClefPrj = mNode.Parent.Parent.Key
    Set objPrj = VBInstance.VBProjects(strClefPrj)    'on recherche le projet
    sKey = Right$(mNode.Key, Len(mNode.Key) - Len(strClefPrj) - 1)    'clé du component
    Set objCmp = objPrj.VBComponents(sKey)
End Sub

Private Sub Analyse_Methode(ByVal mNode As Node, ByRef objPrj As VBIDE.VBProject, ByRef objCmp As VBIDE.VBComponent, ByRef objMember As Member)
    Dim sKey As String, mNodeRecherche As Node
    Dim strClefPrj As String, strClefPar As String
    Dim lngLenCPar As String

    Select Case mNode
        Case conGet, conLet, conSet
            Set mNodeRecherche = mNode.Parent
        Case Else
            Set mNodeRecherche = mNode
    End Select
    'Set objPrj = VBInstance.VBProjects(mNodeRecherche.Parent.Parent.Parent.Key)    'on recherche le projet
    With mNodeRecherche.Parent.Parent
        strClefPrj = .Parent.Parent.Key
        strClefPar = .Key
    End With
    lngLenCPar = Len(strClefPar)
    Set objPrj = VBInstance.VBProjects(strClefPrj)         'on recherche le projet
    sKey = Right$(strClefPar, lngLenCPar - Len(strClefPrj) - 1)    'clé du component
    Set objCmp = objPrj.VBComponents(sKey)
    sKey = Right$(mNodeRecherche.Key, Len(mNodeRecherche.Key) - lngLenCPar - 1)    'clé du membre
    On Error Resume Next
    Set objMember = objCmp.CodeModule.Members(sKey)
End Sub

Private Sub UserDocument_Show()
    UserDocument_Resize
End Sub

Private Sub InitToolbar()
    Const conLanguage As String = "Language"
    Const conIdxResFlt As Integer = 1100
    Const conIdxResGen As Integer = 1000
    Dim objButton As Button, objButtonMenu As ButtonMenu
    Dim lngLanguageTemp As Long
    Dim intIdxRes As Integer

    'Sélection de la langue
    lngLanguageTemp = GetPrivateProfileInt(conSecGen, conLanguage, 1, c2iINIFile)
    Select Case lngLanguageTemp
        Case 1, 2
            lngLanguage = lngLanguageTemp
        Case Else
            lngLanguage = c2i_Langue_Français
            WritePrivateProfileString conSecGen, conLanguage, "1", c2iINIFile
    End Select

    intIdxRes = conIdxResFlt * lngLanguage
    With tbFiltre
'        .ImageList = ImgLstFilter

        Set objButton = .Buttons.Add(, conVariable, , , conVariable)
        objButton.ToolTipText = LoadResString(intIdxRes)

        Set objButton = .Buttons.Add(, conConstante, , , conConstante)
        objButton.ToolTipText = LoadResString(intIdxRes + 1)

        Set objButton = .Buttons.Add(, conMethode, , , conMethode)
        objButton.ToolTipText = LoadResString(intIdxRes + 2)

        Set objButton = .Buttons.Add(, conEvenement, , , conEvenement)
        objButton.ToolTipText = LoadResString(intIdxRes + 3)

        Set objButton = .Buttons.Add(, conPropriete, , , conPropriete)
        objButton.ToolTipText = LoadResString(intIdxRes + 4)

        Set objButton = .Buttons.Add(, conAPI, , , conAPI)
        objButton.ToolTipText = LoadResString(intIdxRes + 5)

        Set objButton = .Buttons.Add(, conPublic, , , conPublic)
        objButton.ToolTipText = LoadResString(intIdxRes + 6)

        Set objButton = .Buttons.Add(, conPrive, , , conPrive)
        objButton.ToolTipText = LoadResString(intIdxRes + 7)

        Set objButton = .Buttons.Add(, conFriend, , , conFriend)
        objButton.ToolTipText = LoadResString(intIdxRes + 8)
    End With
    
    intIdxRes = conIdxResGen * lngLanguage
    With tbGene
'        Set .ImageList = ImgTBGene
'        Set .HotImageList = ImgTBGene

        Set objButton = .Buttons.Add(, conActu, , , conActu)
        objButton.ToolTipText = LoadResString(intIdxRes)

        Set objButton = .Buttons.Add(, conVoir, , , conVoir)
        objButton.ToolTipText = LoadResString(intIdxRes + 1)

        Set objButton = .Buttons.Add(, conDelete, , , conDelete)
        objButton.ToolTipText = "Supprimer"

        Set objButton = .Buttons.Add(, conProp, , tbrDropdown, conBtnSelInfo)
        objButton.ToolTipText = "Durée du développement"
        objButton.ButtonMenus.Add , conBtnSelInfo, "Durée du développement"
        objButton.ButtonMenus.Add , conBtnSelProp, "Générateur de propriétés"
        objButton.ButtonMenus.Add , conBtnSelMsgBox, "Générateur de MsgBox"
        objButton.ButtonMenus.Add , conBtnSelBiblio, "Bibliothèque de code"
        objButton.ButtonMenus.Add , conBtnSelInternet, "c2iExplorer sur le Web"
        objButton.ButtonMenus.Add , conBtnSelCapture, "Imprimer"
        sSelectedTBButton = conBtnSelInfo

        Set objButton = .Buttons.Add(, "nul1", , tbrSeparator)

        Set objButton = .Buttons.Add(, conCompile, , , conCompile)
        objButton.ToolTipText = LoadResString(intIdxRes + 6)
    End With

    With tbDescription
'        Set .ImageList = ImgTbDescription
'        Set .HotImageList = ImgTbDescription
        Set objButton = .Buttons.Add(, conOK, , , conOK)
        If lngLanguage = c2i_Langue_Anglais Then
            objButton.ToolTipText = "Apply description"
        Else
            objButton.ToolTipText = "Appliquer la description"
        End If
    End With

    Set objButton = Nothing
    Set objButtonMenu = Nothing
End Sub

Public Function Work(Optional ByVal bWork As Boolean = conVrai)
    If (bWork) Then
        tbGene.Buttons(conActu).Image = "actuwork"
    Else
        tbGene.Buttons(conActu).Image = conActu
    End If
    DoEvents
End Function

