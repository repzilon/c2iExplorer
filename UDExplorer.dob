Attribute VB_Name = "UDExplorer"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = True
Option Explicit

'***********************************************
'CLE D'UN COMPONENT
' Nom du projet + \ + Nom du component
'TAG : Component
'***********************************************

'***********************************************
'CLE D'UNE REFERENCE
' Nom du projet + \ + Nom du component + \ + Nom du composant
'TAG : ref
'***********************************************

'***********************************************
'CLE D'UN MEMBRE
' Nom du projet + \ + Nom du component + \ + Nom du membre
'TAG Methode
'**************
'CLE D'UNE PROPRIETE
' Nom du projet + \ + Nom du component + \ + Nom du membre+Get Set ou Let
'TAG Met + Num Ligne
'***********************************************

'***********************************************
'CLE D'UN OCX
' Nom du projet + \ + Nom du component + \ + Nom du composant
'TAG : ocx
'***********************************************

'***********************************************
'CLE D'UN PROJET
' Nom du projet
'TAG : Projet
'***********************************************

'***********************************************
'CLE D'UN DOSSIER
' Nom du projet + .. + Feuille ou feuille Fille ou.....
'TAG : Dossier
'***********************************************

'***********************************************
'CLE D'UN DOSSIER REFERENCE
' Nom du projet + ..reference ou ..composant
'TAG : reference ou OCX
'***********************************************

Public SelectedNode As Node
Public sSelectedTBButton As String

Private bSimpleClick As Boolean


'===========================================================================
'
'===========================================================================
Private Function ActuMembreComponent()
    Dim objVBMember As VBIDE.Member
    Dim objVBPrj As VBIDE.VBProject, objVBCmp As VBIDE.VBComponent

    Work

    Analyse_Component tv.SelectedItem, objVBPrj, objVBCmp
    Do Until tv.SelectedItem.Children = 0
        tv.Nodes.Remove tv.SelectedItem.Child.Key
    Loop

    On Error Resume Next
    If objVBCmp.Type <> vbext_ct_ResFile Then              'on n'analyse pas les ressources files
        For Each objVBMember In objVBCmp.CodeModule.Members
            AjouteMembre tv.SelectedItem, objVBMember
        Next
    End If

    Work False

    Set objVBPrj = Nothing
    Set objVBCmp = Nothing
    Set objVBMember = Nothing
End Function



Private Function AnalyseNode(ByVal Node As Node)
    Dim objVBPrj As VBIDE.VBProject, objCmp As VBIDE.VBComponent
    Dim objMember As Member

    'GENERE LORS D'UN SIMPLE CLICK
    On Error GoTo GestErr

    txtDescription = ""

    'on regarde sur quel type d'image on a cliqué
    Select Case Left(Node.Tag, 3)
            'on clique sur un component
        Case "Com"
            Analyse_Component Node, objVBPrj, objCmp
            'VERIF QUE TOUT EXISTE
            'le projet a été supprimé, on ne sait pas pourquoi
            If objVBPrj Is Nothing Then
                tv.Nodes.Remove tv.SelectedItem.Parent.Parent.Key
                GoTo GestErr
            End If
            'le component a été supprimé
            If objCmp Is Nothing Then
                'vérif que ce n'est pas une ressource
                If Right(Node.Key, 9) <> "Ressource" Then
                    tv.Nodes.Remove tv.SelectedItem.Key
                End If
                GoTo GestErr
            End If

            ActuMembreComponent

            txtDescription = objCmp.Description            'mise à jour de la description

            'on clique sur une méthode
        Case "Met"

            Analyse_Methode Node, objVBPrj, objCmp, objMember    'par référence

            'VERIF QUE TOUT EXISTE
            'le projet a été supprimé, on ne sait pas pourquoi
            If objVBPrj Is Nothing Then
                tv.Nodes.Remove tv.SelectedItem.Parent.Parent.Parent.Key
                GoTo GestErr
            End If
            'le component a été supprimé
            If objCmp Is Nothing Then
                tv.Nodes.Remove tv.SelectedItem.Parent.Key
                GoTo GestErr
            End If
            'le member a été supprimé
            If objMember Is Nothing Then
                tv.Nodes.Remove tv.SelectedItem.Key
                GoTo GestErr
            End If

            txtDescription = objMember.Description
    End Select

GestErr:
    Set objMember = Nothing
    Set objCmp = Nothing
    If Not objVBPrj Is Nothing Then
        Set VBPrjSelected = objVBPrj
    End If
    Set objVBPrj = Nothing

End Function


Private Function Suppression(ByVal mNode As Node)
    Dim sc2iMsgBox As VbMsgBoxResult
    Dim objVBPrj As VBIDE.VBProject, objCmp As VBIDE.VBComponent
    Dim objMember As Member

    On Error GoTo GestErr
    Select Case Left(mNode.Tag, 3)
        Case "Pro"
            sc2iMsgBox = MsgBox("Etes-vous sur de vouloir supprimer " + mNode.Text + " ?", vbYesNo + vbDefaultButton2, "c2iExplorer")
            If sc2iMsgBox = vbYes Then
                VBInstance.VBProjects.Remove VBInstance.VBProjects(mNode.Key)
            End If
            Exit Function
        Case "Com"
            sc2iMsgBox = MsgBox("Etes-vous sur de vouloir supprimer " + mNode.Text + " ?", vbYesNo + vbDefaultButton2, "c2iExplorer")
            If sc2iMsgBox = vbYes Then
                Analyse_Component mNode, objVBPrj, objCmp
                objVBPrj.VBComponents.Remove objCmp
                tv.Nodes.Remove mNode
            End If
            Exit Function
        Case "Met"
            Analyse_Methode mNode, objVBPrj, objCmp, objMember    'par référence
            'suppression d'un membre
            Dim objCodeModule As VBIDE.CodeModule
            Dim lngStartLine As Long, lngNumCount As Long, lngType As Long

            On Error Resume Next
            Select Case mNode.Image
                Case "Get"
                    lngType = vbext_pk_Get
                Case "Set"
                    lngType = vbext_pk_Set
                Case "Let"
                    lngType = vbext_pk_Let
                Case "methode"
                    lngType = vbext_pk_Proc
            End Select
            Set objCodeModule = objMember.Collection.Parent
            lngStartLine = objCodeModule.ProcStartLine(objMember.Name, lngType)
            lngNumCount = objCodeModule.ProcCountLines(objMember.Name, lngType)
            If lngNumCount = 0 Then
                MsgBox "Suppression impossible", vbExclamation, "c2iExplorer"
            Else
                Clipboard.Clear
                Clipboard.SetText objCodeModule.Lines(lngStartLine, lngNumCount)
                objCodeModule.DeleteLines lngStartLine, lngNumCount
            End If
            Set objCodeModule = Nothing
            If mNode.Image = "Get" Or mNode.Image = "Set" Or mNode.Image = "Let" Then
                tv_NodeClick mNode.Parent.Parent
            Else
                tv_NodeClick mNode
            End If
    End Select
    Exit Function
GestErr:
End Function


Private Function ViewNode(ByVal Node As Node)
    Dim objVBPrj As VBIDE.VBProject, objCmp As VBIDE.VBComponent
    Dim objMember As Member

    On Error GoTo GestErr


    'on regarde sur quel type d'image on a cliqué
    Select Case Left(Node.Tag, 3)
            'on clique sur un component
        Case "Com"
            If Node.Tag <> "Component" Then
                Analyse_Component Node, objVBPrj, objCmp

                If Not objVBPrj Is VBInstance.ActiveVBProject Then
                    Set VBInstance.ActiveVBProject = objVBPrj    'on le met actif
                End If
                'connection pour l'ajout de références
                Set Connection.refEvent = VBInstance.Events.ReferencesEvents(objVBPrj)
                If Not objCmp.CodeModule.CodePane Is VBInstance.ActiveCodePane Then
                    Set VBInstance.ActiveCodePane = objCmp.CodeModule.CodePane    'on met le component actif
                End If
            End If

            'on clique sur une méthode
        Case "Met"

            Analyse_Methode Node, objVBPrj, objCmp, objMember    'par référence
            'VERIF QUE TOUT EXISTE

            If Not objVBPrj Is VBInstance.ActiveVBProject Then
                Set VBInstance.ActiveVBProject = objVBPrj  'on le met actif
            End If
            Set Connection.refEvent = VBInstance.Events.ReferencesEvents(objVBPrj)
            If Not objCmp.CodeModule.CodePane Is VBInstance.ActiveCodePane Then
                Set VBInstance.ActiveCodePane = objCmp.CodeModule.CodePane    'on met le codepane actif
            End If
            '    objCmp.CodeModule.CodePane.TopLine = objMember.Collection.Parent.ProcBodyLine(objMember.Name, vbext_pk_Proc)
            On Error Resume Next
            Dim iRecherche As Long

            Select Case Node.Image
                Case "propriete"
                    If Node.Children <> 0 Then
                        objCmp.CodeModule.CodePane.TopLine = CLng(Right(Node.Child.Tag, Len(Node.Child.Tag) - 3))
                        objCmp.CodeModule.CodePane.SetSelection CLng(Right(Node.Child.Tag, Len(Node.Child.Tag) - 3)), 1, CLng(Right(Node.Child.Tag, Len(Node.Child.Tag) - 3)) + 1, 1
                    End If
                    'on ne fait rien
                Case "Get"
                    objCmp.CodeModule.CodePane.TopLine = CLng(Right(Node.Tag, Len(Node.Tag) - 3))
                    objCmp.CodeModule.CodePane.SetSelection CLng(Right(Node.Tag, Len(Node.Tag) - 3)), 1, CLng(Right(Node.Tag, Len(Node.Tag) - 3)) + 1, 1
                Case "Let"
                    objCmp.CodeModule.CodePane.TopLine = CLng(Right(Node.Tag, Len(Node.Tag) - 3))
                    objCmp.CodeModule.CodePane.SetSelection CLng(Right(Node.Tag, Len(Node.Tag) - 3)), 1, CLng(Right(Node.Tag, Len(Node.Tag) - 3)) + 1, 1
                Case "Set"
                    objCmp.CodeModule.CodePane.TopLine = CLng(Right(Node.Tag, Len(Node.Tag) - 3))
                    objCmp.CodeModule.CodePane.SetSelection CLng(Right(Node.Tag, Len(Node.Tag) - 3)), 1, CLng(Right(Node.Tag, Len(Node.Tag) - 3)) + 1, 1
                Case Else
                    iRecherche = vbext_pk_Proc
                    objCmp.CodeModule.CodePane.TopLine = objMember.Collection.Parent.ProcBodyLine(objMember.Name, iRecherche)
                    If Err.Number <> 0 Then
                        objCmp.CodeModule.CodePane.SetSelection 1, 1, 2, 1
                        Err.Clear
                    Else
                        objCmp.CodeModule.CodePane.SetSelection objMember.Collection.Parent.ProcBodyLine(objMember.Name, iRecherche), 1, objMember.Collection.Parent.ProcBodyLine(objMember.Name, iRecherche) + 1, 1
                    End If
            End Select

            txtDescription = objMember.Description
    End Select

GestErr:
    Set objMember = Nothing
    Set objCmp = Nothing
    Set objVBPrj = Nothing

End Function




Private Sub tbDescription_ButtonClick(ByVal Button As MSComctlLib.Button)
    Dim objVBPrj As VBIDE.VBProject, objCmp As VBIDE.VBComponent
    Dim objMember As Member

    On Error GoTo Fin
    If Button.Key = "ok" Then
        If tv.SelectedItem Is Nothing Then Exit Sub
        Select Case Left(tv.SelectedItem.Tag, 3)
                'on clique sur un component
            Case "Com"
                Analyse_Component tv.SelectedItem, objVBPrj, objCmp
                If Not objCmp Is Nothing Then
                    objCmp.Description = txtDescription
                End If
            Case "Met"
                Analyse_Methode tv.SelectedItem, objVBPrj, objCmp, objMember    'par référence
                If Not objMember Is Nothing Then
                    objMember.Description = txtDescription
                End If
        End Select
    End If
    Exit Sub
Fin:
    Debug.Print Err.Description
    Debug.Assert False
End Sub

Private Sub tbFiltre_ButtonClick(ByVal Button As MSComctlLib.Button)
    'mise à jour des images
    If Left(Button.Image, 2) = "n-" Then
        Button.Image = Right(Button.Image, Len(Button.Image) - 2)
    Else
        Button.Image = "n-" + Button.Image
    End If
    Select Case Button.Key
        Case "variable"
            bAfficheVariable = Not bAfficheVariable
        Case "constante"
            bAfficheConstante = Not bAfficheConstante
        Case "methode"
            bAfficheMethode = Not bAfficheMethode
        Case "evenement"
            bAfficheEvenement = Not bAfficheEvenement
        Case "propriete"
            bAffichePropriete = Not bAffichePropriete
        Case "api"
            bAfficheAPI = Not bAfficheAPI
        Case "public"
            bAffichePublic = Not bAffichePublic
        Case "prive"
            bAffichePrive = Not bAffichePrive
        Case "friend"
            bAfficheFriend = Not bAfficheFriend
    End Select
End Sub

Private Sub tbGene_ButtonClick(ByVal Button As MSComctlLib.Button)
    Dim objPrj As VBIDE.VBProject, objCmp As VBIDE.VBComponent, objMember As Member

    Select Case Button.Key
            'actualisation
        Case "actu"
            Init True

            'voir le designer
        Case "voir"
            If tv.SelectedItem Is Nothing Then Exit Sub
            Select Case tv.SelectedItem.Tag
                Case "Component"
                    Analyse_Component tv.SelectedItem, objPrj, objCmp
                    On Error Resume Next
                    If Not objCmp.DesignerWindow Is Nothing Then
                        objCmp.DesignerWindow.Visible = True
                    Else
                        objWindowClassViewer.Visible = True
                        objUDClassViewer.Init objCmp
                    End If
                Case "Methode"
                    Analyse_Methode tv.SelectedItem, objPrj, objCmp, objMember
                    On Error Resume Next
                    If Not objCmp.DesignerWindow Is Nothing Then
                        objCmp.DesignerWindow.Visible = True
                    Else
                        objWindowClassViewer.Visible = True
                        objUDClassViewer.Init objCmp
                        'frmClassViewer.Show vbModal
                    End If
            End Select
            Set objMember = Nothing
            Set objCmp = Nothing
            Set objPrj = Nothing


            'ajout de propriétés
        Case "prop"
            Select Case sSelectedTBButton
                Case "msgboxgene"
                    objWindowMsgBox.Visible = True
                Case "propgene"
                    objWindowAddCode.Visible = True
                Case "biblio"
                    objWindowBiblio.Visible = True
                Case "info"
                    objWindowCompteur.Visible = True
                Case "internet"
                    ConnectionInternet "http://www.c2i.fr"
                Case "capture"
                    Impression
            End Select
            'compilation
        Case "compile"
            VBInstance.CommandBars(1).Controls(1).Controls(13).Execute

            'suppression
        Case "delete"
            Suppression SelectedNode
    End Select

    Set objPrj = Nothing
    Set objCmp = Nothing
    Set objMember = Nothing

End Sub

Public Function Impression()
    Dim objPrj As VBProject, objCmp As VBComponent, objMember As Member
    If tv.SelectedItem Is Nothing Then Exit Function
    Load frmPrint
    Select Case Left(tv.SelectedItem.Tag, 3)
        Case "Com"
            Analyse_Component tv.SelectedItem, objPrj, objCmp
            If Not objCmp Is Nothing Then
                frmPrint.ObjetSelectionnés Nothing, objCmp
                frmPrint.Show vbModal
            End If
        Case "Met"
            Analyse_Methode tv.SelectedItem, objPrj, objCmp, objMember    'par référence
            If Not objCmp Is Nothing Then
                frmPrint.ObjetSelectionnés Nothing, objCmp
                frmPrint.Show vbModal
            End If
        Case "Pro"
            Set objPrj = VBInstance.VBProjects(tv.SelectedItem.Key)
            If Not objPrj Is Nothing Then
                frmPrint.ObjetSelectionnés objPrj, Nothing
                frmPrint.Show vbModal
            End If
    End Select
End Function
Private Sub tbGene_ButtonMenuClick(ByVal ButtonMenu As MSComctlLib.ButtonMenu)
    tbGene.Buttons("prop").Image = ButtonMenu.Key
    sSelectedTBButton = ButtonMenu.Key
    tbGene.Buttons("prop").ToolTipText = ButtonMenu.Text
    tbGene_ButtonClick tbGene.Buttons("prop")
End Sub



Private Sub tv_DblClick()
    ViewNode SelectedNode
End Sub


Private Sub tv_NodeClick(ByVal Node As MSComctlLib.Node)
    Set SelectedNode = Node
    AnalyseNode SelectedNode
End Sub

Private Sub UserDocument_Initialize()
    Set tv.ImageList = ImgLSttv
    'par default, on affiche tout
    bAfficheConstante = True
    bAfficheVariable = True
    bAffichePropriete = True
    bAfficheMethode = True
    bAfficheEvenement = True
    bAfficheAPI = True
    bAfficheFriend = True
    bAffichePrive = True
    bAffichePublic = True

    c2iHTMLFile = App.Path + "\html\prev.htm"
    c2iHeadFile = App.Path + "\html\head.txt"
    c2iProjectFile = App.Path + "\html\projects.txt"
    c2iComponentFile = App.Path + "\html\components.txt"
    c2iTableFile = App.Path + "\html\table.txt"
    c2iMemberFile = App.Path + "\html\members.txt"
    c2iDescriptionFile = App.Path + "\html\descriptions.txt"
    c2iLineFile = App.Path + "\html\lines.txt"
    c2iDataFileNameOrigine = App.Path + "\data\base.c2i"

    Set Explorer = New cExplorer

    InitToolbar
End Sub

Private Sub UserDocument_Resize()
On Error Resume Next
    With tv
        .Left = 0
        .Width = tbFiltre.Width
        .Height = ScaleHeight - (tbGene.Height + tbFiltre.Height + tbDescription.Height)
        .Top = tbGene.Top + tbGene.Height
   End With
    With txtDescription
        .Width = ScaleX(ScaleWidth, vbPixels, vbTwips) - ScaleX(tbDescription.Buttons(1).Width, vbPixels, vbTwips)
        .Height = ScaleY(tbDescription.Height, vbPixels, vbTwips)
        .Left = ScaleX(tbDescription.Buttons(1).Width, vbPixels, vbTwips)
        .Top = 0
    End With
End Sub

Public Function Init(Optional bClear As Boolean = False)
    Dim objVBPrj As VBIDE.VBProject

    If bClear Then
        With tv
            .Visible = False
            .Nodes.Clear
            .Visible = True
        End With
    End If
    
    On Error Resume Next
    For Each objVBPrj In VBInstance.VBProjects
        AjouteProjet objVBPrj
    Next
    
    Set objVBPrj = Nothing
End Function

Public Function AjouteProjet(ByVal objVBPrj As VBIDE.VBProject)
    Dim sImage As String
    Dim sKey As String
    Dim sImageKey As String


    Dim mNodePrj As Node
    Dim objVBCmp As VBIDE.VBComponent, mNodeCmp As Node
    Dim objRef As VBIDE.Reference, mNodeRef As Node, mNodeComposant As Node
    Dim mRef As Node, mCmp As Node
    Dim lngCouleurPortee As Long

    Set Connection.refEvent = VBInstance.Events.ReferencesEvents(objVBPrj)

    '***********************************************
    'CLE D'UN PROJET
    ' Nom du projet
    'TAG
    'Projet
    '***********************************************
    tv.Sorted = False
    'ajout des projets
    sKey = objVBPrj.Name
    sImageKey = ExtraitIconeProjet(objVBPrj)
    Set mNodePrj = tv.Nodes.Add(, , sKey, objVBPrj.Name, sImageKey)
    mNodePrj.Tag = "Projet"
    If objVBPrj Is objVBPrj.Collection.StartProject Then
        mNodePrj.Bold = True
    End If

    'ajout des composants du projet

    tv.Enabled = False
    tv.Visible = False
    
'    'Modification FredJust
'    'Permet d'avoir les dossiers toujours dans le meme ordre
'    Dim Neu As Node
'    Set Neu = tv.Nodes.Add(tv.Nodes(objVBPrj.Name), tvwChild, objVBPrj.Name + ".." + "VBForm", "Feuilles", "dVBForm")
'    Neu.Tag = "Dossier"
'    Neu.Bold = True
'
'    Set Neu = tv.Nodes.Add(tv.Nodes(objVBPrj.Name), tvwChild, objVBPrj.Name + ".." + "StdModule", "Modules", "dStdModule")
'    Neu.Tag = "Dossier"
'    Neu.Bold = True
'
'
'    Set Neu = tv.Nodes.Add(tv.Nodes(objVBPrj.Name), tvwChild, objVBPrj.Name + ".." + "ClassModule", "Modules de classe", "dClassModule")
'    Neu.Tag = "Dossier"
'    Neu.Bold = True
'    'Fin de modification
    For Each objVBCmp In objVBPrj.VBComponents
        AjouteComponent objVBCmp
    Next

    InitReferences objVBPrj
    tv.Enabled = True
    tv.Visible = True

    Set tv.SelectedItem = mNodePrj
    Set mNodePrj = Nothing

End Function

Public Function RetireProjet(ByVal objVBPrj As VBIDE.VBProject)
    On Error Resume Next
    tv.Nodes.Remove objVBPrj.Name

End Function


Public Function AjouteComponent(ByVal objVBCmp As VBIDE.VBComponent)
    Dim mNodePrj As Node, mNodeCmp As Node
    Dim sKey As String
    Dim sImageKey As String

    On Error GoTo GestErr

    '***********************************************
    'CLE D'UN COMPONENT
    ' Nom du projet + \ + Nom du component
    'TAG
    'Component
    '***********************************************
    Set mNodePrj = tv.Nodes(objVBCmp.Collection.Parent.Name)

    If objVBCmp.Type = vbext_ct_ResFile Then
        sKey = objVBCmp.Collection.Parent.Name + "\" + "Ressource"
        sImageKey = ExtraitIconeComponent(objVBCmp)
        Set mNodeCmp = tv.Nodes.Add(NodeTypeFeuille(objVBCmp.Collection.Parent.Name, sImageKey), tvwChild, sKey, "( Ressource)", sImageKey)
    Else
        sKey = objVBCmp.Collection.Parent.Name + "\" + objVBCmp.Name
        sImageKey = ExtraitIconeComponent(objVBCmp)
        Set mNodeCmp = tv.Nodes.Add(NodeTypeFeuille(objVBCmp.Collection.Parent.Name, sImageKey), tvwChild, sKey, objVBCmp.Name, sImageKey)
    End If
    mNodeCmp.Tag = "Component"
    mNodeCmp.Sorted = True
    mNodeCmp.EnsureVisible

GestErr:
    Set mNodePrj = Nothing
    Set mNodeCmp = Nothing


End Function

Public Function RetireComposant(ByVal objVBCmp As VBIDE.VBComponent, Optional sOldName As String)
    Dim sKeyParent As String, sName As String

    If sOldName = "" Then
        sName = objVBCmp.Name
    Else
        sName = sOldName
    End If
    On Error GoTo GestErr
    sKeyParent = tv.Nodes(objVBCmp.Collection.Parent.Name + "\" + sName).Parent.Key
    tv.Nodes.Remove objVBCmp.Collection.Parent.Name + "\" + sName

    If tv.Nodes(sKeyParent).Children = 0 Then tv.Nodes.Remove sKeyParent
    Exit Function

GestErr:
    MsgBox "Cliquez sur le bouton actualiser", vbInformation
End Function

'==================================================================================
'
'==================================================================================
Public Function AjouteMembre(ByRef mNodeCmp As Node, ByRef objVBMember As VBIDE.Member)
    Dim sImageKey As String, lngCouleurPortee As Long, sKey As String
    Dim mNodeMember As Node, mNodeProp As Node, Neu As Node

    '***********************************************
    'CLE D'UN MEMBRE
    ' Nom du projet + \ + Nom du component + \ + Nom du membre
    'TAG Methode
    '***********************************************
    'CLE D'UNE PROPRIETE
    ' Nom du projet + \ + Nom du component + \ + Nom du membre+Get Set ou Let
    'TAG Met + Num Ligne
    '***********************************************
    On Error Resume Next
    If AfficheMembre(objVBMember) Then                     'on l'affiche ?
        sImageKey = ExtraitIconeMembre(objVBMember, lngCouleurPortee) 'détermination de l'icone
        Dim sAff As String
        sAff = ""   'si vous souhaitez l'ancienne présentation, mettez sAff à c2i comme valeur
        If sAff = "c2i" Then
            sKey = objVBMember.Collection.Parent.Parent.Collection.Parent.Name + "\" + objVBMember.Collection.Parent.Parent.Name + "\" + objVBMember.Name
            Set mNodeMember = tv.Nodes.Add(mNodeCmp, tvwChild, sKey, objVBMember.Name, sImageKey)
        Else
'//-------------------------------------------------------------//
            'Modifications de FredJust le 10/10/2000 16:44:42
            'Ajout d'un Node pour le dossier
            Set Neu = tv.Nodes(objVBMember.Collection.Parent.Parent.Collection.Parent.Name + "\" + objVBMember.Collection.Parent.Parent.Name + "\" + sImageKey)
            Set Neu = tv.Nodes.Add(mNodeCmp, tvwChild, objVBMember.Collection.Parent.Parent.Collection.Parent.Name + "\" + objVBMember.Collection.Parent.Parent.Name + "\" + sImageKey, sImageKey, "d" & sImageKey)
            If objVBMember.Type = 1 And InStr(1, objVBMember.Name, "_") <> 0 Then
                Set Neu = tv.Nodes(objVBMember.Collection.Parent.Parent.Collection.Parent.Name + "\" + objVBMember.Collection.Parent.Parent.Name + "\cmd")
                Set Neu = tv.Nodes.Add(mNodeCmp, tvwChild, objVBMember.Collection.Parent.Parent.Collection.Parent.Name + "\" + objVBMember.Collection.Parent.Parent.Name + "\cmd", "Objets", "dcmd")
            End If
            sKey = objVBMember.Collection.Parent.Parent.Collection.Parent.Name + "\" + objVBMember.Collection.Parent.Parent.Name + "\" + objVBMember.Name
            Set mNodeMember = tv.Nodes.Add(Neu, tvwChild, sKey, objVBMember.Name, sImageKey)
            'Fin de modification
'//-------------------------------------------------------------//
        End If
        mNodeMember.Tag = "Methode"
        mNodeMember.ForeColor = lngCouleurPortee

        'ajout des Set, Get, Let
        If objVBMember.Type = vbext_mt_Property Then
            'recherche du Get
            Dim iGet As Long, iLet As Long, iSet As Long
            iGet = objVBMember.Collection.Parent.ProcBodyLine(objVBMember.Name, vbext_pk_Get)
            If iGet <> 0 Then
                Set mNodeProp = tv.Nodes.Add(mNodeMember, tvwChild, mNodeMember.Key + "Get", "Get", "Get")
                mNodeProp.Tag = "Met" + CStr(iGet)
            End If
            'recherche du Let
            iLet = objVBMember.Collection.Parent.ProcBodyLine(objVBMember.Name, vbext_pk_Let)
            If iLet <> 0 Then
                Set mNodeProp = tv.Nodes.Add(mNodeMember, tvwChild, mNodeMember.Key + "Let", "Let", "Let")
                mNodeProp.Tag = "Met" + CStr(iLet)
            Else
                'recherche du Set
                iSet = objVBMember.Collection.Parent.ProcBodyLine(objVBMember.Name, vbext_pk_Set)
                If iSet <> 0 Then
                    Set mNodeProp = tv.Nodes.Add(mNodeMember, tvwChild, mNodeMember.Key + "Set", "Set", "Set")
                    mNodeProp.Tag = "Met" + CStr(iSet)
                End If
            End If
            Set mNodeProp = Nothing
        End If
    End If
    Set mNodeMember = Nothing
End Function

Public Function InitReferences(objVBPrj As VBIDE.VBProject)
    Dim mNodeRef As Node, mNodeComposant As Node, mNodePrj As Node
    Dim objRef As VBIDE.Reference

    '***********************************************
    'CLE D'UN DOSSIER REFERENCE
    ' Nom du projet + ..reference ou ..composant
    'TAG
    'reference ou OCX
    '***********************************************
    On Error GoTo GestErr
    Set mNodePrj = tv.Nodes(objVBPrj.Name)
    Set mNodeRef = tv.Nodes.Add(mNodePrj, tvwChild, mNodePrj.Key + "..reference", "Références", "dreference")
    mNodeRef.Tag = "Reference"
    'mNodeRef.ForeColor = RGB(0, 0, 255)
    mNodeRef.Bold = True
    Set mNodeComposant = tv.Nodes.Add(mNodePrj, tvwChild, mNodePrj.Key + "..composant", "Composants", "dcomposant")
    mNodeComposant.Tag = "OCX"
    'mNodeComposant.ForeColor = RGB(0, 0, 255)
    mNodeComposant.Bold = True
    For Each objRef In objVBPrj.References
        AjouteReference objVBPrj, objRef
    Next

    Set mNodePrj = Nothing
    Set mNodeRef = Nothing
    Set mNodeComposant = Nothing
    Exit Function

GestErr:
    MsgBox "Erreur dans la lecture des Références", vbInformation
    Set mNodePrj = Nothing
    Set mNodeRef = Nothing
    Set mNodeComposant = Nothing

End Function

Public Function AjouteReference(ByRef objVBPrj As VBIDE.VBProject, ByRef objRef As VBIDE.Reference)

    On Error GoTo Fin
    If Right(objRef.FullPath, 3) = "oca" Then
        AjouteOCX objRef, tv.Nodes(objVBPrj.Name + "..composant")
    Else
        AjouteBibliotheque objRef, tv.Nodes(objVBPrj.Name + "..reference")
    End If

    Exit Function
Fin:
    'lien interne, groupe de projet
    Dim mCmp As Node
    On Error Resume Next
    Set mCmp = tv.Nodes.Add(tv.Nodes(objVBPrj.Name + "..composant"), tvwChild, tv.Nodes(objVBPrj.Name + "..composant").Key + objRef.Name, objRef.Name + " (" + CStr(objRef.Major) + "." + CStr(objRef.Minor) + " )", "composant")
    mCmp.Tag = "ocx"
    If objRef.BuiltIn Then
        mCmp.ForeColor = vbBlue                            'ne peut être supprimé
    End If
    If objRef.IsBroken Then
        mCmp.ForeColor = vbRed                             'lien cassé
    End If

    Set mCmp = Nothing
End Function

Private Function AjouteOCX(ByRef objRef As VBIDE.Reference, ByRef mNodeComposant As Node)
    Dim mCmp As Node

    '***********************************************
    'CLE D'UN OCX
    ' Nom du projet + \ + Nom du component + \ + Nom du composant
    'TAG
    'ocx
    '***********************************************
    On Error Resume Next
    Set mCmp = tv.Nodes.Add(mNodeComposant, tvwChild, mNodeComposant.Key + objRef.Name, objRef.Description + " (" + CStr(objRef.Major) + "." + CStr(objRef.Minor) + " )", "composant")
    mCmp.Tag = "ocx"
    If objRef.BuiltIn Then
        mCmp.ForeColor = vbBlue                            'ne peut être supprimé
    End If
    If objRef.IsBroken Then
        mCmp.ForeColor = vbRed                             'lien cassé
    End If

    Set mCmp = Nothing
End Function
Private Function AjouteBibliotheque(ByRef objRef As VBIDE.Reference, ByRef mNodeRef As Node)
    Dim mRef As Node

    '***********************************************
    'CLE D'UNE REFERENCE
    ' Nom du projet + \ + Nom du component + \ + Nom du composant
    'TAG
    'ref
    '***********************************************
    On Error Resume Next
    Set mRef = tv.Nodes.Add(mNodeRef, tvwChild, mNodeRef.Key + objRef.Name, objRef.Description + " (" + CStr(objRef.Major) + "." + CStr(objRef.Minor) + " )", "reference")
    mRef.Tag = "ref"
    If objRef.BuiltIn Then
        mRef.ForeColor = vbBlue                            'ne peut être supprimé
    End If
    If objRef.IsBroken Then
        mRef.ForeColor = vbRed                             'lien cassé
    End If

    Set mRef = Nothing
End Function

Private Function NodeTypeFeuille(ByVal sNomProjet As String, sImageKey As String) As Node
    'ajoute un type de feuille
    On Error GoTo GestErr

    '***********************************************
    'CLE D'UN DOSSIER
    ' Nom du projet + .. + Feuille ou feuille Fille ou.....
    'TAG
    'Dossier
    '***********************************************
    Set NodeTypeFeuille = tv.Nodes(sNomProjet + ".." + sImageKey)
    Exit Function

GestErr:
    'le type n'a pas été ajouté
    Dim sNomType As String

    If lngLanguage = c2i_Langue_Français Then
        Select Case sImageKey
            Case "ActiveXDesigner"
                sNomType = "ActiveXDesigner"
            Case "ClassModule"
                sNomType = "Module de classe"
            Case "DocObject"
                sNomType = "Document utilisateur"
            Case "MSForm"
                sNomType = "Feuille MS"
            Case "PropPage"
                sNomType = "Page de propriété"
            Case "RelatedDocument"
                sNomType = "Document associé"
            Case "ResFile"
                sNomType = "Fichier de ressource"
            Case "StdModule"
                sNomType = "Module"
            Case "UserControl"
                sNomType = "Contrôle utilisateur"
            Case "VBChildForm"
                sNomType = "Feuille fille"
            Case "VBForm"
                sNomType = "Feuille"
                sImageKey = "VBForm"
            Case "VBMDIForm"
                sNomType = "Feuille MDI"
            Case Else
                sNomType = "Inconnu"
        End Select
    Else
        Select Case sImageKey
            Case "ActiveXDesigner"
                sNomType = "ActiveXDesigner"
            Case "ClassModule"
                sNomType = "Class module"
            Case "DocObject"
                sNomType = "User document"
            Case "MSForm"
                sNomType = "MS Form"
            Case "PropPage"
                sNomType = "Property page"
            Case "RelatedDocument"
                sNomType = "Associated document"
            Case "ResFile"
                sNomType = "Ressource file"
            Case "StdModule"
                sNomType = "Module"
            Case "UserControl"
                sNomType = "User Control"
            Case "VBChildForm"
                sNomType = "Child Form"
            Case "VBForm"
                sNomType = "Form"
            Case "VBMDIForm"
                sNomType = "MDI Form"
            Case Else
                sNomType = "Unknown"
        End Select
    End If
    Err.Clear
    Set NodeTypeFeuille = tv.Nodes.Add(tv.Nodes(sNomProjet), tvwChild, sNomProjet + ".." + sImageKey, sNomType, "d" & sImageKey)
    NodeTypeFeuille.Tag = "Dossier"
    'NodeTypeFeuille.ForeColor = RGB(0, 0, 255)
    NodeTypeFeuille.Bold = True
End Function

Private Sub Analyse_Component(ByVal mNode As Node, ByRef objPrj As VBIDE.VBProject, ByRef objCmp As VBIDE.VBComponent)
    Dim sKey As String

    On Error Resume Next                                   'à cause des Resfile qui ont une clé ="" et n'ont pas de Designer
    Set objPrj = VBInstance.VBProjects(mNode.Parent.Parent.Key)    'on recherche le projet
    sKey = Right(mNode.Key, Len(mNode.Key) - Len(mNode.Parent.Parent.Key) - 1)    'clé du component
    Set objCmp = objPrj.VBComponents(sKey)
End Sub

Private Sub Analyse_Methode(ByVal mNode As Node, ByRef objPrj As VBIDE.VBProject, ByRef objCmp As VBIDE.VBComponent, ByRef objMember As Member)
    Dim sKey As String, mNodeRecherche As Node

    If mNode = "Get" Or mNode = "Let" Or mNode = "Set" Then
        Set mNodeRecherche = mNode.Parent
    Else
        Set mNodeRecherche = mNode
    End If
    'Set objPrj = VBInstance.VBProjects(mNodeRecherche.Parent.Parent.Parent.Key)    'on recherche le projet
    Set objPrj = VBInstance.VBProjects(mNodeRecherche.Parent.Parent.Parent.Parent.Key)    'on recherche le projet
    sKey = Right(mNodeRecherche.Parent.Parent.Key, Len(mNodeRecherche.Parent.Parent.Key) - Len(mNodeRecherche.Parent.Parent.Parent.Parent.Key) - 1)    'clé du component
    Set objCmp = objPrj.VBComponents(sKey)
    sKey = Right(mNodeRecherche.Key, Len(mNodeRecherche.Key) - Len(mNodeRecherche.Parent.Parent.Key) - 1)    'clé du membre
    On Error Resume Next
    Set objMember = objCmp.CodeModule.Members(sKey)
End Sub


Private Sub UserDocument_Show()
    UserDocument_Resize
End Sub

Private Function AfficheMembre(objMember As VBIDE.Member) As Boolean
    '=========================================
    'Détermine si l'on affiche le membre sélectionné
    'en fonction du filtre général
    '=========================================
    '
    AfficheMembre = False                                  'on n'affiche pas par default
    Select Case objMember.Type
        Case vbext_mt_Const
            AfficheMembre = bAfficheConstante
        Case vbext_mt_Event
            AfficheMembre = bAfficheEvenement
        Case vbext_mt_Method
            'extraction de la ligne de code
            If objMember.Collection.Parent.ProcBodyLine(objMember.Name, vbext_pk_Proc) <> 1 Then
                AfficheMembre = bAfficheMethode
            Else
                AfficheMembre = bAfficheAPI
            End If
        Case vbext_mt_Property
            AfficheMembre = bAffichePropriete
        Case vbext_mt_Variable
            AfficheMembre = bAfficheVariable
        Case Else
            AfficheMembre = True
    End Select

    Select Case objMember.Scope
        Case vbext_Friend
            If Not bAfficheFriend Then AfficheMembre = False
        Case vbext_Private
            If Not bAffichePrive Then AfficheMembre = False
        Case vbext_Public
            If Not bAffichePublic Then AfficheMembre = False
    End Select

End Function

Private Function InitToolbar()
    Dim objButton As Button, objButtonMenu As ButtonMenu

    lngLanguage = c2i_Langue_Français

    With tbFiltre
        .ImageList = ImgLstFilter

        Set objButton = .Buttons.Add(, "variable", , , "variable")
        objButton.ToolTipText = LoadResString(1100 * lngLanguage)

        Set objButton = .Buttons.Add(, "constante", , , "constante")
        objButton.ToolTipText = LoadResString(1100 * lngLanguage + 1)

        Set objButton = .Buttons.Add(, "methode", , , "methode")
        objButton.ToolTipText = LoadResString(1100 * lngLanguage + 2)

        Set objButton = .Buttons.Add(, "evenement", , , "evenement")
        objButton.ToolTipText = LoadResString(1100 * lngLanguage + 3)

        Set objButton = .Buttons.Add(, "propriete", , , "propriete")
        objButton.ToolTipText = LoadResString(1100 * lngLanguage + 4)

        Set objButton = .Buttons.Add(, "api", , , "api")
        objButton.ToolTipText = LoadResString(1100 * lngLanguage + 5)

        Set objButton = .Buttons.Add(, "public", , , "public")
        objButton.ToolTipText = LoadResString(1100 * lngLanguage + 6)

        Set objButton = .Buttons.Add(, "prive", , , "prive")
        objButton.ToolTipText = LoadResString(1100 * lngLanguage + 7)

        Set objButton = .Buttons.Add(, "friend", , , "friend")
        objButton.ToolTipText = LoadResString(1100 * lngLanguage + 8)
    End With

    With tbGene
        Set .ImageList = ImgTBGene
        Set .HotImageList = ImgTBGene

        Set objButton = .Buttons.Add(, "actu", , , "actu")
        objButton.ToolTipText = LoadResString(1000 * lngLanguage)

        Set objButton = .Buttons.Add(, "voir", , , "voir")
        objButton.ToolTipText = LoadResString(1000 * lngLanguage + 1)

        Set objButton = .Buttons.Add(, "delete", , , "delete")
        objButton.ToolTipText = "Supprimer"

        Set objButton = .Buttons.Add(, "prop", , tbrDropdown, "info")
        objButton.ToolTipText = "Durée du développement"
        objButton.ButtonMenus.Add , "info", "Durée du développement"
        objButton.ButtonMenus.Add , "propgene", "Générateur de propriétés"
        objButton.ButtonMenus.Add , "msgboxgene", "Générateur de MsgBox"
        objButton.ButtonMenus.Add , "biblio", "Bibliothèque de code"
        objButton.ButtonMenus.Add , "internet", "c2iExplorer sur le Web"
        objButton.ButtonMenus.Add , "capture", "Imprimer"
        sSelectedTBButton = "info"

        Set objButton = .Buttons.Add(, "nul1", , tbrSeparator)

        Set objButton = .Buttons.Add(, "compile", , , "compile")
        objButton.ToolTipText = LoadResString(1000 * lngLanguage + 6)
    End With

    With tbDescription
        Set .ImageList = ImgTbDescription
        Set .HotImageList = ImgTbDescription
        Set objButton = .Buttons.Add(, "ok", , , "ok")
        If lngLanguage = c2i_Langue_Français Then
            objButton.ToolTipText = "Appliquer la description"
        Else
            objButton.ToolTipText = "Apply description"
        End If
    End With


    Set objButton = Nothing
    Set objButtonMenu = Nothing
End Function

Public Function Work(Optional bWork As Boolean = True)
    If bWork Then
        tbGene.Buttons("actu").Image = "actuwork"
    Else
        tbGene.Buttons("actu").Image = "actu"
    End If
    DoEvents
End Function

Private Sub UserDocument_Terminate()
    Set Explorer = Nothing
    If NombreInstancesClasses <> 0 Then
        DétailInstancesClasses
        Debug.Assert NombreInstancesClasses = 0
    End If
    SaveSetting "MesCompléments", App.Title, "Data", c2iCurrentDataFileName
End Sub




