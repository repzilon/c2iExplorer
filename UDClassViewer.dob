Option Explicit
Private Const conActu As String = "actu"
Private Const conDescro As String = "descro"
Private Const conPrint As String = "print"
Private mobjCmp As VBIDE.VBComponent

Private Sub UserDocument_Initialize()
'    Set lvProp.SmallIcons = imgListView
    lvProp.View = lvwReport

'    Set tbMain.ImageList = ImgTBGene
'    Set tbMain.HotImageList = ImgTBGene
    MakeToolBar

    UserDocument_Resize
'    ExtraireImageList imgListView, "UDClassViewer.imgListView"
'    ExtraireImageList ImgTBGene, "UDClassViewer.ImgTBGene"
End Sub

Private Sub MakeToolBar()
    Dim objButton As Button
    With tbMain.Buttons
        Set objButton = .Add(, , , tbrSeparator)
        Set objButton = .Add(, conActu, , , conActu)
        Set objButton = .Add(, conDescro, , tbrPressed, conDescro)
        Set objButton = .Add(, , , tbrSeparator)
        Set objButton = .Add(, conPrint, , , conPrint)

        Select Case lngLanguage
            Case c2i_Langue_Anglais
                .Item(conActu).ToolTipText = "Refresh"
                .Item(conDescro).ToolTipText = conLibelDescrpt
                .Item(conPrint).ToolTipText = "Print"
            Case Else
                .Item(conActu).ToolTipText = "Actualisation"
                .Item(conDescro).ToolTipText = conLibelDescrpt
                .Item(conPrint).ToolTipText = "Imprimer"
        End Select
    End With

    Set objButton = Nothing
End Sub

Private Sub UserDocument_Resize()
    Dim sngHautEchelle As Single
    Dim sngLargEchelle As Single
    Dim sngHautLblInt As Single
    Dim sngLargLvProp As Single
    sngHautEchelle = ScaleHeight
    sngLargEchelle = ScaleWidth
    On Error Resume Next
    With lblInt
        sngHautLblInt = sngHautEchelle - .Top - 10
        .Height = sngHautLblInt
    End With
    With lvProp
        sngLargLvProp = sngLargEchelle - .Left
        .Width = sngLargLvProp
        .Height = sngHautLblInt
        .ColumnHeaders(1).Width = sngLargLvProp * 0.9
    End With
    With PicSource
        .Width = sngLargEchelle
        .Height = sngHautEchelle - tbMain.Height
    End With
End Sub

Public Sub Init(ByVal objCmp As VBIDE.VBComponent)
    Const conPropgetlet As String = "propgetlet"
    Const conProplet As String = "proplet"
    Const conPropget As String = "propget"
    Const conProppublic As String = "proppublic"

    Dim objMember As VBIDE.Member, lngColor As Long, lItem As ListItem
    Dim iGet As Long, iLet As Long, iSet As Long
    Dim sTexte As String
    Dim blnAjoutProp As Boolean, strImgLV As String, strDescription As String

    lvProp.ListItems.Clear
    lblInt = vbNullString

    Set mobjCmp = objCmp

    lblClassName = mobjCmp.Name
    For Each objMember In mobjCmp.CodeModule.Members
        sTexte = objMember.Name
        If (tbMain.Buttons(conDescro).Value = tbrPressed) Then
            On Error Resume Next
            strDescription = Trim$(objMember.Description)
            On Error GoTo 0
            If (strDescription <> vbNullString) Then
                sTexte = sTexte & " (" & strDescription & ")"
            End If
        End If

        Select Case ExtraitIconeMembre(objMember, lngColor)
            Case conMethode
                If (lngColor <> Mem_Privee) Then
                    Set lItem = lvProp.ListItems.Add(, , sTexte, conMethode, conMethode)
                    lItem.ForeColor = lngColor
                End If

            Case conPropriete
                If (lngColor <> Mem_Privee) Then
                    blnAjoutProp = conFaux
                    iGet = 0
                    iLet = 0
                    iSet = 0
                    On Error Resume Next
                    With objMember.Collection.Parent
                        iGet = .ProcBodyLine(objMember.Name, vbext_pk_Get)
                        iLet = .ProcBodyLine(objMember.Name, vbext_pk_Let)
                        iSet = .ProcBodyLine(objMember.Name, vbext_pk_Set)
                    End With

                    Select Case conVrai
                        Case iLet <> 0, iSet <> 0
                            blnAjoutProp = conVrai
                            If (iGet <> 0) Then
                                strImgLV = conPropgetlet
                            Else
                                strImgLV = conProplet
                            End If
                        Case iGet <> 0
                            blnAjoutProp = conVrai
                            strImgLV = conPropget
                    End Select
                End If

                If (blnAjoutProp) Then
                    Set lItem = lvProp.ListItems.Add(, , sTexte, strImgLV, strImgLV)
                    lItem.ForeColor = lngColor
                End If

            Case "variable"
                If (lngColor = Mem_Public) Then
                    Set lItem = lvProp.ListItems.Add(, , sTexte, conProppublic, conProppublic)
                    lItem.ForeColor = lngColor
                Else
                    lblInt = lblInt & objMember.Name & vbCrLf
                End If
        End Select
    Next

    Set objMember = Nothing
    Set lvProp.SelectedItem = Nothing
End Sub

Private Sub tbMain_ButtonClick(ByVal Button As MSComctlLib.Button)
    Select Case Button.Key
        Case conActu
            Init mobjCmp
        Case conPrint
            Imprime
        Case conDescro
            Init mobjCmp
    End Select
End Sub

Private Sub Imprime()
    Dim lngDC As Long

    On Error GoTo GestErr
    lngDC = GetDC(UserDocument.hwnd)
    BitBlt PicSource.hdc, 0, 0, UserDocument.ScaleWidth, UserDocument.ScaleHeight - tbMain.Height, lngDC, 0, tbMain.Height, vbSrcCopy
    ReleaseDC UserDocument.hwnd, lngDC
    PicSource.Refresh
    Printer.PaintPicture PicSource.Image, 0, 0
    Printer.EndDoc

SortieProc:
    Exit Sub
GestErr:
    GererErrInattendue , "UDClassViewer.Imprime"
    Resume SortieProc
End Sub

Private Sub UserDocument_Terminate()
    Set mobjCmp = Nothing
End Sub
