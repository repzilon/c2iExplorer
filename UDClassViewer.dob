Option Explicit

Private mobjCmp As VBIDE.VBComponent

Private Sub UserDocument_Initialize()
    Set lvProp.SmallIcons = imgListView
    lvProp.View = lvwReport
    
    Set tbMain.ImageList = ImgTBGene
    Set tbMain.HotImageList = ImgTBGene
    MakeToolBar
    
    UserDocument_Resize
End Sub

Private Sub MakeToolBar()
    Dim objButton As Button
    Set objButton = tbMain.Buttons.Add(, , , tbrSeparator)
    Set objButton = tbMain.Buttons.Add(, "actu", , , "actu")
    Set objButton = tbMain.Buttons.Add(, "descro", , tbrPressed, "descro")
    Set objButton = tbMain.Buttons.Add(, , , tbrSeparator)
    Set objButton = tbMain.Buttons.Add(, "print", , , "print")

    With tbMain.Buttons
        Select Case lngLanguage
            Case c2i_Langue_Français
                .Item("actu").ToolTipText = "Actualisation"
                .Item("descro").ToolTipText = "Description"
                .Item("print").ToolTipText = "Imprimer"
            Case Else
                .Item("actu").ToolTipText = "Refresh"
                .Item("descro").ToolTipText = "Description"
                .Item("print").ToolTipText = "Print"
        End Select
    End With

    Set objButton = Nothing
End Sub

Private Sub UserDocument_Resize()
    On Error Resume Next
    With lblInt
        .Height = ScaleHeight - .Top - 10
    End With
    With lvProp
        .Width = ScaleWidth - .Left
        .Height = lblInt.Height
        .ColumnHeaders(1).Width = .Width * 0.9
    End With
    With PicSource
        .Width = ScaleWidth
        .Height = ScaleHeight - tbMain.Height
    End With
End Sub

Public Sub Init(ByVal objCmp As VBIDE.VBComponent)
    Dim objMember As VBIDE.Member, lngColor As Long, lItem As ListItem
    Dim iGet As Long, iLet As Long, iSet As Long
    Dim sTexte As String


    lvProp.ListItems.Clear
    lblInt = ""

    Set mobjCmp = objCmp

    lblClassName = mobjCmp.Name
    For Each objMember In mobjCmp.CodeModule.Members
        sTexte = objMember.Name
        If tbMain.Buttons("descro").Value = tbrUnpressed Then
            If Trim$(objMember.Description) <> "" Then
                sTexte = sTexte + " (" + Trim$(objMember.Description) + ")"
            End If
        End If

        Select Case ExtraitIconeMembre(objMember, lngColor)
            Case "methode"
                If lngColor <> Mem_Privee Then
                    Set lItem = lvProp.ListItems.Add(, , sTexte, "methode", "methode")
                    lItem.ForeColor = lngColor
                End If
            Case "propriete"
                If lngColor <> Mem_Privee Then
                    iGet = 0
                    iLet = 0
                    iSet = 0
                    On Error Resume Next
                    iGet = objMember.Collection.Parent.ProcBodyLine(objMember.Name, vbext_pk_Get)
                    If iGet <> 0 Then
                        Set lItem = lvProp.ListItems.Add(, , sTexte, "propget", "propget")
                        lItem.ForeColor = lngColor
                    End If
                    iLet = objMember.Collection.Parent.ProcBodyLine(objMember.Name, vbext_pk_Let)
                    If iLet <> 0 Then
                        If iGet <> 0 Then
                            lItem.Icon = "propgetlet"
                            lItem.SmallIcon = "propgetlet"
                        Else
                            Set lItem = lvProp.ListItems.Add(, , sTexte, "proplet", "proplet")
                            lItem.ForeColor = lngColor
                        End If
                    End If
                    iSet = objMember.Collection.Parent.ProcBodyLine(objMember.Name, vbext_pk_Set)
                    If iSet <> 0 Then
                        If iGet <> 0 Then
                            lItem.Icon = "propgetlet"
                            lItem.SmallIcon = "propgetlet"
                        Else
                            Set lItem = lvProp.ListItems.Add(, , sTexte, "proplet", "proplet")
                            lItem.ForeColor = lngColor
                        End If
                    End If
                End If

            Case "variable"
                If lngColor = Mem_Public Then
                    Set lItem = lvProp.ListItems.Add(, , sTexte, "proppublic", "proppublic")
                    lItem.ForeColor = lngColor
                Else
                    lblInt = lblInt + objMember.Name + vbCrLf
                End If
        End Select
    Next
    Set objMember = Nothing

    Set lvProp.SelectedItem = Nothing

End Sub

Private Sub tbMain_ButtonClick(ByVal Button As MSComctlLib.Button)
    Select Case Button.Key
        Case "actu"
            Init mobjCmp
        Case "print"
            Imprime
        Case "descro"
            Init mobjCmp
    End Select
End Sub

Private Sub Imprime()
    Dim lngDC As Long

    On Error GoTo GestErr
    lngDC = GetDC(UserDocument.hwnd)
    BitBlt PicSource.hdc, 0, 0, UserDocument.ScaleWidth, UserDocument.ScaleHeight - tbMain.Height, lngDC, 0, tbMain.Height, vbSrcCopy
    ReleaseDC UserDocument.hwnd, lngDC
    PicSource.Refresh
    Printer.PaintPicture PicSource.Image, 0, 0
    Printer.EndDoc
    
SortieProc:
    Exit Sub
GestErr:
    MsgBox "Erreur no " & Err.Number & vbCrLf & Err.Description & vbCrLf & Err.Source, vbExclamation
    Resume SortieProc
End Sub

Private Sub UserDocument_Terminate()
    Set mobjCmp = Nothing
End Sub
