Attribute VB_Name = "UDCompteur"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = True
Option Explicit
Private lngDureeSauve As Long
Private bSauve As Boolean

Private Function ExtraitFileTitle(ByVal sFileName As String) As String
    Dim sM As String, iPos As Long, iDummy As Long
    On Error GoTo GestErr
    sM = sFileName
    iPos = 1
    Do Until iPos = 0
        iPos = InStr(1, sM, "\")
        If iPos = 0 Then Exit Do
        sM = Right(sM, Len(sM) - iPos)
    Loop
    ExtraitFileTitle = sM
    Exit Function

GestErr:
    ExtraitFileTitle = sFileName
End Function

Private Sub lv_ColumnClick(ByVal ColumnHeader As MSComctlLib.ColumnHeader)
    lv.SortKey = ColumnHeader.Index - 1
    lv.Sorted = True
End Sub


Private Sub tb_ButtonClick(ByVal Button As MSComctlLib.Button)
    Select Case Button.Key
        Case "actu"
            ActuCompteur
        Case "delete"
            SupprimeCompteur
        Case "addprj"
            AjouteProjet
        Case "prop"
            ModifDuree
    End Select
End Sub

Private Function ModifDuree()

    On Error Resume Next
    If lv.SelectedItem Is Nothing Then Exit Function
    Load frmDuree
    frmDuree.lblProjectName = lv.SelectedItem.SubItems(2)

    Dim lngTime As String
    Dim sH As String, sMn As String, sS As String
    lngTime = GetDuree(lv.SelectedItem.SubItems(2))
    sH = CStr(Int(lngTime / 3600))
    lngTime = lngTime - CLng(sH) * 3600
    sMn = CStr(Int(lngTime / 60))
    lngTime = lngTime - CLng(sMn) * 60
    sS = CStr(Int(lngTime))
    frmDuree.txtH = sH
    frmDuree.txtMn = sMn
    frmDuree.txtS = sS

    frmDuree.Show vbModal
    ActuCompteur
End Function
Private Function AjouteProjet()
    Dim objVBPrj As VBProject
    Dim sc2iMsgBox As VbMsgBoxResult

    For Each objVBPrj In VBInstance.VBProjects
        If objVBPrj.FileName = "" Then
            MsgBox "Impossible d'ajouter ce projet :" + vbCrLf + objVBPrj.Name + vbCrLf + "Sauvegardez-le avant", vbInformation
        Else
            sc2iMsgBox = MsgBox("Voulez-vous ajouter ce projet :" + vbCrLf + objVBPrj.Name + vbCrLf + "à vos compteurs ?", vbQuestion + vbYesNo, "c2iExplorer")
            Select Case sc2iMsgBox
                Case vbYes
                    SaveSetting App.EXEName, "Durees", objVBPrj.FileName, 0
                    ActuCompteur
            End Select
        End If
    Next
End Function

Private Function SupprimeCompteur()
    On Error Resume Next
    If Not lv.SelectedItem Is Nothing Then
        DeleteSetting App.EXEName, "Durees", lv.SelectedItem.Key
        ActuCompteur
    End If
End Function

Private Sub Timer1_Timer()
    Static iNum As Long
    Dim objVBPrj As VBProject

    If Not bSauve Then Exit Sub

    On Error GoTo Fin                                      'accès interdit à la collection de Projects
    If iNum = lngDureeSauve Then
        'sauve données
        For Each objVBPrj In VBInstance.VBProjects
            SauveDuree objVBPrj
        Next
        ActuCompteur
        Set objVBPrj = Nothing
        iNum = -1
    End If
    iNum = iNum + 1

Fin:
End Sub

Private Sub UserDocument_Initialize()
    ActuCompteur
    ChargeInfos
End Sub

Private Sub UserDocument_Resize()
    With lv
        .Left = 0
        .Width = ScaleWidth
        .Top = tb.Height
        .Height = ScaleHeight - .Top
    End With
End Sub

Public Function ActuCompteur()
    Dim tbSettings As Variant, i As Long, lItem As ListItem
    Dim sFileName As String, objVBPrj As VBProject
    Dim sFileTitle As String

    On Error GoTo Fin
    tbSettings = GetAllSettings(App.EXEName, "Durees")

    lv.ListItems.Clear
    For i = 0 To UBound(tbSettings)
        sFileName = tbSettings(i, 0)
        sFileTitle = ExtraitFileTitle(sFileName)
        Set lItem = lv.ListItems.Add(, sFileName, sFileTitle)
        lItem.SubItems(1) = ConvertHeuresMinutesSecondes(GetDuree(sFileName))
        lItem.SubItems(2) = sFileName
        Set objVBPrj = Nothing
        For Each objVBPrj In VBInstance.VBProjects
            If objVBPrj.FileName = sFileName Then
                lItem.ForeColor = vbRed
                Exit For
            End If
        Next
    Next i
Fin:
    Set lItem = Nothing
    Set objVBPrj = Nothing
End Function

Private Function ConvertHeuresMinutesSecondes(ByVal lngTime As Long) As String
    Dim sH As String, sMn As String, sS As String

    sH = CStr(Int(lngTime / 3600))
    lngTime = lngTime - CLng(sH) * 3600
    sMn = CStr(Int(lngTime / 60))
    lngTime = lngTime - CLng(sMn) * 60
    sS = CStr(Int(lngTime))

    ConvertHeuresMinutesSecondes = sH + " h " + sMn + " mn " + sS + " s"
End Function

Private Sub UserDocument_Show()
    ActuCompteur
End Sub

Private Function ChargeInfos()
    Dim fso As FileSystemObject
    Dim txtS As TextStream, sFile As String

    sFile = App.Path + "\data\duree.txt"

    On Error Resume Next
    Err.Clear
    Set fso = New FileSystemObject
    If fso.FileExists(sFile) Then
        Set txtS = fso.OpenTextFile(sFile)
        bSauve = CBool(txtS.ReadLine)
        If Err.Number <> 0 Then
            bSauve = True
            Err.Clear
        End If
        lngDureeSauve = CLng(txtS.ReadLine)
        If Err.Number <> 0 Then
            lngDureeSauve = 2                              'sauvegarde par defaut toutes les 2 minutes
            Err.Clear
        End If
    Else                                                   'le fichier n'existe pas , on le crée
        bSauve = True
        lngDureeSauve = 2
        Set txtS = fso.CreateTextFile(sFile)
        txtS.WriteLine CStr(bSauve)
        txtS.WriteLine CStr(lngDureeSauve)
    End If
    txtS.Close
    Set txtS = Nothing
    Set fso = Nothing
    If Not bSauve Then
        Timer1.Enabled = False
    End If
End Function

