Option Explicit
Private Const conSecH As Long = 3600
Private Const conSecMn As Long = 60
Private Const conActu As String = "actu"
Private Const conDelete As String = "delete"
Private Const conAddprj As String = "addprj"
Private Const conProp As String = "prop"
Private Const conNomUD As String = "UDCompteur"

'Note par René Rhéaume, 7 janvier 2002 (RÉSOLUE)
' Il semble y avoir une ou des erreurs algorithmiques
'Note par René Rhéaume le 5 juillet 2002
' La soit disant erreur algorithmique était causée par le nom de la fonction
'Fonction modifiée par René Rhéaume le 5 juillet 2002
' Tiré de http://www.xbeat.net/vbspeed/c_GetFile.htm
' L'ancienne fonction faisait un Right$ à l'intérieur de la boucle
Private Function ExtraireNomFichier(ByVal strChemin As String) As String
' by Donald, donald@xbeat.net, 20001010
' by Peter Weighill, pweighill@btinternet.com, 20001020
    Dim iPos As Long
#If VersionVB <> 6 Then
    Dim iPosPrev As Long
#End If
  
    ' search last backslash
#If VersionVB = 6 Then
    iPos = InStrRev(strChemin, "\", -1, vbBinaryCompare)
#Else
    Do
        iPosPrev = iPos
        iPos = InStr(iPos + 1, strChemin, "\", vbBinaryCompare)
    Loop While iPos > 0
#End If

#If VersionVB = 6 Then
    If iPos > 0 Then
        ExtraireNomFichier = Mid$(strChemin, iPos + 1)
#Else
    If iPosPrev > 0 Then
        ExtraireNomFichier = Mid$(strChemin, iPosPrev + 1)
#End If
    Else
        ExtraireNomFichier = strChemin
    End If
End Function

Private Sub lv_ColumnClick(ByVal ColumnHeader As MSComctlLib.ColumnHeader)
    lv.SortKey = ColumnHeader.Index - 1
    lv.Sorted = conVrai
End Sub

Private Sub tb_ButtonClick(ByVal Button As MSComctlLib.Button)
    Select Case Button.Key
        Case conActu
            ActuCompteur
        Case conDelete
            SupprimeCompteur
        Case conAddprj
            AjouteProjet
        Case conProp
            ModifDuree
    End Select
End Sub

Private Sub ModifDuree()
    Dim strNomProjet As String
    Dim lngTime As Long
    Dim lngH As Long, lngMn As Long, lngS As Long
    '    On Error Resume Next
    If (Not lv.SelectedItem Is Nothing) Then
        Load frmDuree
        strNomProjet = lv.SelectedItem.SubItems(2)
        frmDuree.lblProjectName = strNomProjet

        lngTime = GetDuree(strNomProjet)
        lngH = lngTime \ conSecH
        lngTime = lngTime - (lngH * conSecH)
        lngMn = lngTime \ conSecMn
        lngS = lngTime - (lngMn * conSecMn)

        With frmDuree
            .txtH = CStr(lngH)
            .txtMn = CStr(lngMn)
            .txtS = CStr(lngS)
            .Show vbModal
        End With
        ActuCompteur
    End If
End Sub

'Procédure modifiée par René Rhéaume le 20 juin 2002
' Support multilingue
Private Sub AjouteProjet()
    Const conL10nAjoutPrj As String = "Code.AjouteProjet."
    Static mlgarMsgImpossibleAjouterPrj() As String
    Static mlgarQuestionAjouterPrj() As String
    Static blnLangOK As Boolean
    Dim I As Long
    If (Not blnLangOK) Then
        StrArray mlgarMsgImpossibleAjouterPrj, _
            "Impossible d'ajouter le projet", "Sauvegardez-le avant."
        StrArray mlgarQuestionAjouterPrj, "Voulez-vous ajouter le projet", "à vos compteurs ?"
        If (blnMultilingueActive) Then
            For I = 0 To 1
                mlgarMsgImpossibleAjouterPrj(I) = LireChaineLocalisee(conNomUD, _
                    conL10nAjoutPrj & "mlgarMsgImpossibleAjouterPrj(" & I & conPF, _
                    mlgarMsgImpossibleAjouterPrj(I))
                mlgarQuestionAjouterPrj(I) = LireChaineLocalisee(conNomUD, _
                    conL10nAjoutPrj & "mlgarQuestionAjouterPrj(" & I & conPF, _
                    mlgarQuestionAjouterPrj(I))
            Next I
        End If
        blnLangOK = conVrai
    End If

    Dim objVBPrj As VBProject
    Dim sc2iMsgBox As VbMsgBoxResult

    For Each objVBPrj In VBInstance.VBProjects
        If (objVBPrj.Filename = vbNullString) Then
            MsgBox mlgarMsgImpossibleAjouterPrj(0) & vbCrLf & objVBPrj.Name & vbCrLf & _
                    mlgarMsgImpossibleAjouterPrj(1), vbInformation
        Else
            sc2iMsgBox = MsgBox(mlgarQuestionAjouterPrj(0) & vbCrLf & objVBPrj.Name & _
                            vbCrLf & mlgarQuestionAjouterPrj(1), vbQuestion + vbYesNo)
            If (sc2iMsgBox = vbYes) Then
                'Modification par René Rhéaume 2 août 2001
                Call WritePrivateProfileString(conSecDurees, objVBPrj.Filename, conAZero, c2iINIFile)
                '                SaveSetting App.EXEName, conSecDurees, objVBPrj.Filename, 0
                ActuCompteur
            End If
        End If
    Next
End Sub

Private Sub SupprimeCompteur()
    On Error Resume Next
    If (Not lv.SelectedItem Is Nothing) Then
        'Modification par René Rhéaume 2 août 2001
        Call WritePrivateProfileString(conSecDurees, lv.SelectedItem.Key, vbNullString, c2iINIFile)
        '        DeleteSetting App.EXEName, conSecDurees, lv.SelectedItem.Key
        ActuCompteur
    End If
End Sub

Private Sub Timer1_Timer()
    Static iNum As Long
    Dim objVBPrj As VBProject

    On Error GoTo Fin                                      'accès interdit à la collection de Projects
    If (bSauve) Then
        '        If (iNum Mod lngDureeSauve = 0) Then
        If ((iNum \ lngDureeSauve) * lngDureeSauve = iNum) Then
            'sauve données
            For Each objVBPrj In VBInstance.VBProjects
                SauveDuree objVBPrj
            Next
            ActuCompteur
            Set objVBPrj = Nothing
        End If
        iNum = iNum + 1
    End If

Fin:
End Sub

'Procédure modifiée par René Rhéaume le 19 juin 2002
' Support multilingue
Private Sub UserDocument_Initialize()
    Dim I As Long
    ActuCompteur
    ChargerOptions
    
    tb.Buttons(conActu).ToolTipText = mlgLibelActu
    tb.Buttons(conAddprj).ToolTipText = LireChaineLocalisee(conNomUD, _
            "Obj.tb.Buttons(3-->'addprj').ToolTipText", "Ajouter les projets")
    tb.Buttons(conProp).ToolTipText = LireChaineLocalisee(conNomUD, _
            "Obj.tb.Buttons(4-->'prop').ToolTipText", "Modifier la durée")
    tb.Buttons(conDelete).ToolTipText = mlgLibelDelete

    If (blnMultilingueActive) Then
        For I = 1 To 3
            lv.ColumnHeaders(I).Text = LireChaineLocalisee(conNomUD, _
                    "Obj.lv.ColumnHeaders(" & I & ").Text", lv.ColumnHeaders(I).Text)
        Next I
    End If
    
    UserDocument_Resize
'    ExtraireImageList imgTB, "UDCompteur.imgTB"
End Sub

Private Sub UserDocument_Resize()
    Dim sngHauteurBO As Single
    sngHauteurBO = tb.Height
    On Error Resume Next
    lv.Move 0, sngHauteurBO, ScaleWidth, ScaleHeight - sngHauteurBO
End Sub

' Procédure modifiée par René Rhéaume 25 août 2001
' Utilise le fichier INI au lieu de la base de registres
Public Sub ActuCompteur()
    ' Ancienne version
    '    Dim tbSettings As Variant, I As Long
    '    Dim sFileName As String, sFileTitle As String
    '    Dim objVBPrj As VBProject, lItem As ListItem
    '
    '    On Error GoTo Fin
    '    tbSettings = GetAllSettings(App.EXEName, conSecDurees)
    '
    '    lv.ListItems.Clear
    '    For I = 0 To UBound(tbSettings)
    '        sFileName = tbSettings(I, 0)
    '        sFileTitle = ExtraireNomFichier(sFileName)
    '        Set lItem = lv.ListItems.Add(, sFileName, sFileTitle)
    '        lItem.SubItems(1) = ConvertHeuresMinutesSecondes(GetDuree(sFileName))
    '        lItem.SubItems(2) = sFileName
    '        Set objVBPrj = Nothing
    '        For Each objVBPrj In VBInstance.VBProjects
    '            If objVBPrj.Filename = sFileName Then
    '                lItem.ForeColor = vbRed
    '                Exit For
    '            End If
    '        Next
    '    Next I
    'Fin:
    '    Set lItem = Nothing
    '    Set objVBPrj = Nothing

    ' Nouvelle version
    Dim objVBPrj As VBProject, lItem As ListItem
    Dim chnContenuSectionDurees As String, tblSectionDurees() As String
    Dim I As Long, iPos As Long
    Dim chnCheminFichier As String, chnTitreProjet As String
    Dim lngDernIdxATraiter As Long

    On Error GoTo Fin

    #If VersionVB = 6 Then
        ' Importe les durées et
        ' Vérifie si la conversion Base de registres -> c2iExplorer.ini
        ' a été réussie. Si oui, supprime la clé de registre devenue obsolète.
        If (ImporterDurees = 0) Then
            DeleteSetting App.EXEName
        End If
    #End If

    chnContenuSectionDurees = LireSectionFichierINI(conSecDurees, c2iINIFile)
    SplitB chnContenuSectionDurees, tblSectionDurees(), vbNullChar

    lv.ListItems.Clear
    lngDernIdxATraiter = UBound(tblSectionDurees()) - 1
    For I = 0 To lngDernIdxATraiter
        iPos = InStr(1, tblSectionDurees(I), "=")
        chnCheminFichier = Trim$(Left$(tblSectionDurees(I), iPos - 1))
        chnTitreProjet = ExtraireNomFichier(chnCheminFichier)
        Set lItem = lv.ListItems.Add(, chnCheminFichier, chnTitreProjet)
        lItem.SubItems(1) = ConvertHeuresMinutesSecondes(GetDuree(chnCheminFichier))
        lItem.SubItems(2) = chnCheminFichier
        Set objVBPrj = Nothing
        For Each objVBPrj In VBInstance.VBProjects
            If objVBPrj.Filename = chnCheminFichier Then
                lItem.Bold = conVrai
                Exit For
            End If
        Next
    Next I

Fin:
    Set lItem = Nothing
    Set objVBPrj = Nothing
End Sub

Private Function ConvertHeuresMinutesSecondes(ByVal lngTime As Long) As String
    Dim lngH As Long, lngMn As Long, lngS As Long

    lngH = lngTime \ conSecH
    lngTime = lngTime - (lngH * conSecH)
    lngMn = lngTime \ conSecMn
    lngS = lngTime - (lngMn * conSecMn)

    ConvertHeuresMinutesSecondes = CStr(lngH) & conEsp & mlgarUniteTemps(0) & conEsp & _
                                    CStr(lngMn) & conEsp & mlgarUniteTemps(1) & conEsp & _
                                    CStr(lngS) & conEsp & mlgarUniteTemps(2)
End Function

Private Sub UserDocument_Show()
    ActuCompteur
End Sub

'Procédure modifiée par René Rhéaume 30 juillet 2001
' Utilise un fichier INI et les fonctions API au lieu
' d'un fichier texte et du FileSystemObject
'Procédure modifiée par René Rhéaume le 21 juin 2002
Private Sub ChargerOptions()
    Dim lngSauvegarder As Long, lngIntervalle As Long

    lngSauvegarder = GetPrivateProfileInt(conSecGen, conValSauveDur, 1, c2iINIFile)
    Select Case lngSauvegarder
        Case 1
            bSauve = conVrai
        Case 0
            bSauve = conFaux
        Case Else
            bSauve = conVrai
            WritePrivateProfileString conSecGen, conValSauveDur, "1", c2iINIFile
    End Select

    lngIntervalle = GetPrivateProfileInt(conSecGen, conValDurSavNtrv, 2, c2iINIFile)
    Select Case (conVrai)
        Case Err <> 0, lngIntervalle < 0
            lngDureeSauve = 2
            WritePrivateProfileString conSecGen, conValDurSavNtrv, "2", c2iINIFile
        Case Else
            lngDureeSauve = lngIntervalle
    End Select

    '    If Not bSauve Then
    '        Timer1.Enabled = conFaux
    '    End If
    Timer1.Enabled = bSauve
End Sub

#If VersionVB = 6 Then
'Ajouté par René Rhéaume 25 août 2001
' Importe les durées de la base de registres vers le fichier INI
' Utile pour les versions VB6 seulement
' Retourne 0 s'il n'y a pas d'erreur
'Fonction modifiée par René Rhéaume le 20 juin 2002
' Support multilingue
'Fonction modifiée par René Rhéaume le 14 septembre 2002
' Retrait du code de déboguage
Public Function ImporterDurees() As Byte
    Static mlgarErrImportation() As String
    Static blnLangOK As Boolean
    Dim J As Long
    If (Not blnLangOK) Then
        StrArray mlgarErrImportation, "Une erreur est survenue lors de l'importation des durées", _
            "de la base de registres vers le fichier INI."
        If (blnMultilingueActive) Then
            For J = 0 To 1
                mlgarErrImportation(J) = LireChaineLocalisee(conNomUD, _
                    "Code.ImporterDurees.mlgarErrImportation(" & J & conPF, mlgarErrImportation(J))
            Next J
        End If
        blnLangOK = conVrai
    End If

    Dim tbSettings As Variant, I As Long
    Dim sFileName As String
    Dim chnDuree As String                ' Un peu bizarre, mais pas de conversions inutiles
    Dim lngFinTab As String

    On Error GoTo GestErr
    tbSettings = GetAllSettings(conNomApp, conSecDurees)

    If (IsEmpty(tbSettings) = conFaux) Then
        lngFinTab = UBound(tbSettings)
        For I = 0 To lngFinTab
            sFileName = tbSettings(I, 0)
            chnDuree = tbSettings(I, 1)
            Call WritePrivateProfileString(conSecDurees, sFileName, chnDuree, c2iINIFile)
        Next I
    End If
    ImporterDurees = 0

Fin:
    Exit Function
GestErr:
    GererErrInattendue mlgarErrImportation(0) & vbNewLine & _
                        mlgarErrImportation(1), "UDCompteur.ImporterDurees"
    ImporterDurees = 1
End Function
#End If

'Déplacé de MExtraitIcone par René Rhéaume le 18 mai 2002
' Optimisation de taille mémoire indiquée dans les manuels en ligne
' ~/Guide de l'utilisateur/Partie 2/Optimisation et compatibilité/Optimisation de la taille/Réduction de la taille du code
Public Function GetDuree(ByVal sFileName As String) As Long
    Dim sM As String
    Dim I As Long, iNumPrj As Long

    iNumPrj = -1

    If (sFileName = vbNullString) Then
        GetDuree = -1
        Exit Function
    End If

    On Error GoTo Suivant
    For I = 0 To UBound(DuréePrj)
        If (DuréePrj(I).Filename = sFileName) Then
            iNumPrj = I
            Exit For
        End If
    Next I

Suivant:
    On Error GoTo Fin

    ' Modification par René Rhéaume 2 août 2001
    '    sM = GetSetting(App.EXEName, conSecDurees, sFileName, vbNullString)
    sM = LireChaineFichierINI(conSecDurees, sFileName, vbNullString, c2iINIFile)
    If (sM <> vbNullString) Then                           'on la trouvé dans le fichier INI
        If (iNumPrj = -1) Then
            GetDuree = CLng(sM)
        Else
            GetDuree = timeGetTime / 1000 - DuréePrj(iNumPrj).Durée + CLng(sM)
        End If
    Else                                                   'il n'est pas dans le fichier INI
        GetDuree = -1
    End If
    Exit Function

Fin:
    GetDuree = -1
End Function

'Déplacé de MExtraitIcone par René Rhéaume le 18 mai 2002
' Optimisation de taille mémoire indiquée dans les manuels en ligne
' ~/Guide de l'utilisateur/Partie 2/Optimisation et compatibilité/Optimisation de la taille/Réduction de la taille du code
Public Sub SauveDuree(objPrj As VBProject)
    Dim lngDuree As Long

    On Error GoTo Fin
    lngDuree = GetDuree(objPrj.Filename)
    If (lngDuree <> -1) Then
        ' Modification par René Rhéaume 2 août 2001
        Call WritePrivateProfileString(conSecDurees, CStr(objPrj.Filename), CStr(lngDuree), c2iINIFile)
        '        SaveSetting App.EXEName, conSecDurees, objPrj.Filename, lngDuree
    End If

Fin:
End Sub
