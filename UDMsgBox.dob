Private Sub chk1Plan_Click()
    MiseAJourCode
End Sub

Private Sub chkHelpButton_Click()
    MiseAJourCode
End Sub

Private Sub chkTextAlign_Click()
    MiseAJourCode
End Sub

Private Sub cmdParcoursFile_Click()
    On Error GoTo Fin
    Dim cCommonDialog As cDlgCom
    Set cCommonDialog = New cDlgCom
    With cCommonDialog
        .DefaultEx = ".hlp"
        .Flags = OFN_HIDEREADONLY + OFN_PATHMUSTEXIST + OFN_FILEMUSTEXIST + OFN_EXPLORER + OFN_LONGNAMES
        .Filter = "Fichiers d'aide (*.chm;*.hlp)|*.chm;*.hlp|Tous les fichiers (*.*)|*.*"
        .FilterIndex = 1
        .Filename = txtHelpFile.Text
        .ShowOpen
        txtHelpFile = .Filename
    End With

Fin:
    Set cCommonDialog = Nothing
End Sub

Private Sub ShowMsgBox()
    Dim sTitre As String, sMessage As String
    'le titre et le message
    sTitre = txtTitle.Text

    sMessage = txtMessage

    'l'icone
    Dim lngButtonsIcones As Long
    lngButtonsIcones = lngRetourneIcones

    'les boutons
    Dim lngButtons As Long
    lngButtons = lngRetourneBoutons

    'le bouton default
    Dim lngDefaultButton As Long
    lngDefaultButton = lngRetourneDefaultBoutons

    'la modalité
    Dim lngModal As Long
    If (lblModal(1).FontBold) Then
        lngModal = vbSystemModal
    End If

    '********************* le code total
    '//  le string du bouton
    Dim lngButtonsDef As Long
    lngButtonsDef = lngButtonsIcones + lngButtons + lngDefaultButton + lngModal

    'les divers
    If (chkHelpButton.Value = vbChecked) Then
        lngButtonsDef = lngButtonsDef + vbMsgBoxHelpButton
    End If

    If (chk1Plan.Value = vbChecked) Then
        lngButtonsDef = lngButtonsDef + vbMsgBoxSetForeground
    End If

    If (chkTextAlign.Value = vbChecked) Then
        lngButtonsDef = lngButtonsDef + vbMsgBoxRight
    End If

    '// fin du string
    On Error GoTo Fin
    If (sTitre <> vbNullString) Then
        If (txtHelpFile <> vbNullString) Then
            MsgBox sMessage, lngButtonsDef, sTitre, txtHelpFile, txtContext
        Else
            MsgBox sMessage, lngButtonsDef, sTitre
        End If
    Else
        If (txtHelpFile <> vbNullString) Then
            MsgBox sMessage, lngButtonsDef, , txtHelpFile, txtContext
        Else
            MsgBox sMessage, lngButtonsDef
        End If
    End If

    Exit Sub
Fin:
    MsgBox "Erreur dans le code", vbCritical, "c2iMsgBox"
End Sub

Private Sub lblButtons_Click(Index As Integer)
    Dim iNum As Long

    For iNum = 0 To lblButtons.UBound
        lblButtons(iNum).FontBold = conFaux
        lblButtons(iNum).BorderStyle = 0
    Next
    lblButtons(Index).FontBold = conVrai
    lblButtons(Index).BorderStyle = 1
    lngIdxButtons = Index
    MiseAJourCode
End Sub

Private Sub lblDefaultButton_Click(Index As Integer)
    Dim iNum As Long

    For iNum = 0 To lblDefaultButton.UBound
        lblDefaultButton(iNum).FontBold = conFaux
        lblDefaultButton(iNum).BorderStyle = 0
    Next
    lblDefaultButton(Index).FontBold = conVrai
    lblDefaultButton(Index).BorderStyle = 1
    lngIdxDefaultButton = Index
    MiseAJourCode
End Sub

Private Sub lblIconesInfos_Click(Index As Integer)
    picIcones_Click Index
End Sub

Private Sub lblModal_Click(Index As Integer)
    Dim iNum As Long

    For iNum = 0 To lblModal.UBound
        lblModal(iNum).FontBold = conFaux
        lblModal(iNum).BorderStyle = 0
    Next
    lblModal(Index).FontBold = conVrai
    lblModal(Index).BorderStyle = 1

    MiseAJourCode
End Sub

Private Sub MiseAJourCode()
    Const conPlus As String = " + "
    Const con1V As String = ","
    Const con2V As String = ",,"
    Const con3V As String = ",,,"
    Const conVEV As String = ", ,"
    Const conCasVbOK As String = "Case vbOK"
    Const conCasVbCancel As String = "Case vbCancel"
    Const conCasVbAbort As String = "Case vbAbort"
    Const conCasVbRetry As String = "Case vbRetry"
    Const conCasVbIgnore As String = "Case vbIgnore"
    Const conCasVbYes As String = "Case vbYes"
    Const conCasVbNo As String = "Case vbNo"
    Const conFinCas As String = "End Select"
    Const conVbMsgBoxHelpButton As String = "vbMsgBoxHelpButton"
    Const conVbMsgBoxSetForeground As String = "vbMsgBoxSetForeground"
    Const conVbMsgBoxRight As String = "vbMsgBoxRight"
    Dim sTitre As String, sMessage As String
    Dim sButtonsIcones As String
    Dim sButtons As String
    Dim strCode As String
    Dim sDefaultButton As String
    Dim sModal As String
    Dim sButtonsDef As String                              '//  le string du bouton
    Dim blnButtonsDef As Boolean
    Dim strHelpFile As String
    Dim strVirgule As String

    '    txtCode = vbNullString
    'le titre et le message
    sTitre = txtTitle.Text
    If (sTitre <> vbNullString) Then
        sTitre = conGlmt & sTitre & conGlmt
    End If

    sMessage = ExtraitSautDeLigne(txtMessage.Text)

    sButtonsIcones = RetourneIcones                        'l'icone
    sButtons = RetourneBoutons                             'les boutons
    sDefaultButton = RetourneDefaultBoutons                'le bouton default

    'la modalité
    If (lblModal(1).FontBold) Then
        sModal = "vbSystemModal"
    End If

    '********************* le code total
    'l'icone
    sButtonsDef = sButtonsIcones
    blnButtonsDef = (sButtonsDef <> vbNullString)
    'les boutons
    If (sButtons <> vbNullString) Then
        If (blnButtonsDef) Then
            sButtonsDef = sButtonsDef & conPlus & sButtons
        Else
            sButtonsDef = sButtons
            blnButtonsDef = conVrai
        End If
    End If
    'le bouton par default
    If (sDefaultButton <> vbNullString) Then
        If (blnButtonsDef) Then
            sButtonsDef = sButtonsDef & conPlus & sDefaultButton
        Else
            sButtonsDef = sDefaultButton
            blnButtonsDef = conVrai
        End If
    End If
    'la modalité
    If (sModal <> vbNullString) Then
        If (blnButtonsDef) Then
            sButtonsDef = sButtonsDef & conPlus & sModal
        Else
            sButtonsDef = sModal
            blnButtonsDef = conVrai
        End If
    End If
    'les divers
    If (chkHelpButton.Value = vbChecked) Then
        If (blnButtonsDef) Then
            sButtonsDef = sButtonsDef & conPlus & conVbMsgBoxHelpButton
        Else
            sButtonsDef = conVbMsgBoxHelpButton
            blnButtonsDef = conVrai
        End If
    End If
    If (chk1Plan.Value = vbChecked) Then
        If (blnButtonsDef) Then
            sButtonsDef = sButtonsDef & conPlus & conVbMsgBoxSetForeground
        Else
            sButtonsDef = conVbMsgBoxSetForeground
            blnButtonsDef = conVrai
        End If
    End If
    If (chkTextAlign.Value = vbChecked) Then
        If (blnButtonsDef) Then
            sButtonsDef = sButtonsDef & conPlus & conVbMsgBoxRight
        Else
            sButtonsDef = conVbMsgBoxRight
            blnButtonsDef = conVrai
        End If
    End If
    '// fin du string
    If (sButtons <> vbNullString) Then                     'il y a un code retour
        strCode = "Dim sc2iMsgBox As VbMsgBoxResult" & (vbCrLf & vbCrLf) & "sc2iMsgBox = MsgBox(" & sMessage
    Else                                                   'sans retour de code
        strCode = "MsgBox " & sMessage
    End If

    If (blnButtonsDef) Then
        strCode = strCode & con1V & sButtonsDef
    End If
    If (sTitre <> vbNullString) Then
        If (blnButtonsDef) Then
            strCode = strCode & conVEV & sTitre
        Else
            strCode = strCode & con1V & sTitre
        End If
    End If
    strHelpFile = Trim$(txtHelpFile)
    If (strHelpFile <> vbNullString) Then
        If (sTitre <> vbNullString) Then
            strVirgule = con1V
        Else
            If (sButtons = vbNullString) Then
                strVirgule = con3V
            Else
                strVirgule = con2V
            End If
        End If
        strCode = strCode & (strVirgule & conGlmt) & strHelpFile & (conGlmt & con1V) & txtContext
    End If

    If (sButtons <> vbNullString) Then
        strCode = strCode & (")" & vbCrLf) & "Select Case sc2iMsgbox" & vbCrLf

        Select Case sButtons
            Case conVbOKCancel
                strCode = strCode & vbTab & conCasVbOK & vbCrLf & _
                        vbTab & conCasVbCancel & vbCrLf & conFinCas
            Case conVbAbortRetryIgnore
                strCode = strCode & vbTab & conCasVbAbort & vbCrLf & _
                        vbTab & conCasVbRetry & (vbCrLf & vbTab) & _
                        conCasVbIgnore & vbCrLf & conFinCas
            Case conVbYesNoCancel
                strCode = strCode & vbTab & conCasVbYes & vbCrLf _
                        & vbTab & conCasVbNo & (vbCrLf & vbTab) _
                        & conCasVbCancel & vbCrLf & conFinCas
            Case conVbYesNo
                strCode = strCode & vbTab & conCasVbYes & vbCrLf & _
                        vbTab & conCasVbNo & vbCrLf & conFinCas
            Case conVbRetryCancel
                strCode = strCode & vbTab & conCasVbRetry & vbCrLf _
                        & vbTab & conCasVbCancel & vbCrLf & conFinCas
        End Select
    End If

    txtCode.Text = strCode
End Sub

Private Sub txtContext_Change()
    MiseAJourCode
End Sub

Private Sub txtHelpFile_Change()
    MiseAJourCode
End Sub

Private Sub txtMessage_Change()
    MiseAJourCode
End Sub

Private Sub txtTitle_Change()
    MiseAJourCode
End Sub

Private Sub UserDocument_Resize()
    On Error Resume Next
    txtCode.Width = ScaleWidth - txtCode.Left
    txtCode.Height = ScaleHeight - txtCode.Top
End Sub
