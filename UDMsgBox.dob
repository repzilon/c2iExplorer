Option Explicit

Private Const conVbOKCancel As String = "vbOKCancel"
Private Const conVbAbortRetryIgnore As String = "vbAbortRetryIgnore"
Private Const conVbYesNoCancel As String = "vbYesNoCancel"
Private Const conVbYesNo As String = "vbYesNo"
Private Const conVbRetryCancel As String = "vbRetryCancel"

Private lngIdxButtons As Long
Private lngIdxDefaultButton As Long
Private lngIdxIcones As Long

'Note par René Rhéaume 1er août 2001
'Avant de compiler :
'Seul le dernier c2iContainerIntMsg (index 6) doit être ouvert
'(Ouvert = conVrai) dans la fenêtre de conception. Tous les autres doivent
'être fermés.

Private Sub c2iContainerIntMsg_OuvertureChange(Index As Integer)
    Dim iNum As Long
    Dim intDernIdx As Integer, sngGaucheCont As Single
    intDernIdx = c2iContainerIntMsg.UBound
    If (c2iContainerIntMsg(Index).Ouvert) Then
        For iNum = 0 To intDernIdx
            If (iNum <> Index) Then
                c2iContainerIntMsg(iNum).Ouvert = conFaux
            End If
        Next
    End If
    sngGaucheCont = c2iContainerIntMsg(0).Left
    For iNum = 1 To intDernIdx
        c2iContainerIntMsg(iNum).Top = c2iContainerIntMsg(iNum - 1).Top + c2iContainerIntMsg(iNum - 1).Height
        c2iContainerIntMsg(iNum).Left = sngGaucheCont
    Next

End Sub

Private Sub c2iContainerIntMsg_TitleDblClick(Index As Integer)
    c2iContainerIntMsg(Index).Ouvert = Not c2iContainerIntMsg(Index).Ouvert
End Sub

Private Sub picIcones_Click(Index As Integer)
    Dim iNum As Long, iUnPixel As Long, intFinTab As Integer

    iUnPixel = ScaleX(2, vbPixels, vbTwips)
    intFinTab = picIcones.UBound
    For iNum = 0 To intFinTab
        picIcones(iNum).BorderStyle = 0
        lblIconesInfos(iNum).FontBold = conFaux
    Next
    picIcones(Index).BorderStyle = 1
    lblIconesInfos(Index).FontBold = conVrai
    shpIconesOmbre.Left = picIcones(Index).Left + iUnPixel
    shpIconesOmbre.Top = picIcones(Index).Top + iUnPixel
    lngIdxIcones = Index
    MiseAJourCode
End Sub

Private Sub tbMain_ButtonClick(ByVal Button As MSComctlLib.Button)
    Dim lngStartLine As Long, lngStartColumn As Long, lngEndLine As Long, lngEndColumn As Long

    Select Case Button.Image
        Case "voir"
            ShowMsgBox
        Case "copie"
            If (Not VBInstance.ActiveCodePane Is Nothing) Then
                With VBInstance.ActiveCodePane
                    .GetSelection lngStartLine, lngStartColumn, lngEndLine, lngEndColumn
                    .CodeModule.InsertLines lngStartLine, txtCode
                End With
            Else
                MsgBox "Il n'y a pas de fenêtre de code active", vbInformation
                Exit Sub
            End If
    End Select
End Sub

Private Sub UserDocument_Initialize()
    Dim iNum As Long
    Dim lngCompte As Long
    Dim oleFermee As IPictureDisp, oleOuvert As IPictureDisp
    lngCompte = c2iContainerIntMsg.UBound
    Set oleFermee = imgFermee.Picture
    Set oleOuvert = imgOuvert.Picture
    For iNum = 0 To lngCompte
        With c2iContainerIntMsg(iNum)
            Set .PictureFerméeDown = oleFermee
            Set .PictureFerméeUp = oleFermee
            Set .PictureOuvertDown = oleOuvert
            Set .PictureOuvertUp = oleOuvert
        End With
    Next iNum
    Set oleFermee = Nothing
    Set oleOuvert = Nothing

    Select Case lngLanguage
        Case c2i_Langue_Anglais
            c2iContainerIntMsg(0).Caption = "Icons"
            c2iContainerIntMsg(1).Caption = "Buttons"
            c2iContainerIntMsg(2).Caption = "Default button"
            c2iContainerIntMsg(3).Caption = "Modal"
            c2iContainerIntMsg(4).Caption = "Help"
            c2iContainerIntMsg(5).Caption = "Miscellaneous"
            c2iContainerIntMsg(6).Caption = "Message - Title"
            lblInvite(0).Caption = "Title"
            txtMessage.Text = "Your message"
        Case Else
            c2iContainerIntMsg(0).Caption = "Icônes"
            c2iContainerIntMsg(1).Caption = "Boutons"
            c2iContainerIntMsg(2).Caption = "Bouton par défaut"
            c2iContainerIntMsg(3).Caption = "Modalité"
            c2iContainerIntMsg(4).Caption = "Aide"
            c2iContainerIntMsg(5).Caption = "Divers"
            c2iContainerIntMsg(6).Caption = "Message - Titre"
            lblInvite(0).Caption = "Titre"
            txtMessage.Text = "Votre message"
    End Select

    picIcones_Click 0
    lblButtons_Click 0
    lblDefaultButton_Click 0
    lblModal_Click 0
End Sub

Private Function ExtraitSautDeLigne(ByVal sMessage As String) As String
    Dim lngPos As Long

    lngPos = InStr(1, sMessage, vbCrLf)
    Do Until (lngPos = 0)
        sMessage = Left$(sMessage, lngPos - 1) & (conGlmt & " & vbCrLf & " & conGlmt) & Right$(sMessage, Len(sMessage) - lngPos - 1)
        lngPos = InStr(lngPos + 2, sMessage, vbCrLf)
    Loop

    If (sMessage = vbNullString) Then
        ExtraitSautDeLigne = vbNullString
    Else
        ExtraitSautDeLigne = conGlmt & sMessage & conGlmt
    End If

End Function

