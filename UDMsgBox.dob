                Case 2
                    lngRetourneBoutons = vbAbortRetryIgnore
                Case 3
                    lngRetourneBoutons = vbYesNoCancel
                Case 4
                    lngRetourneBoutons = vbYesNo
                Case 5
                    lngRetourneBoutons = vbRetryCancel
            End Select
            Exit For
        End If
    Next iNum
End Function

