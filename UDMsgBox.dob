Private Sub chk1Plan_Click()
    MiseAJourCode
End Sub

Private Sub chkHelpButton_Click()
    MiseAJourCode
End Sub

Private Sub chkTextAlign_Click()
    MiseAJourCode
End Sub


Private Sub cmdParcoursFile_Click()
    On Error GoTo Fin
    With cdlg
        .CancelError = True
        .Filter = "Fichiers d'aide (*.chm;*.hlp)|*.chm;*.hlp|Tous les fichiers (*.*)|*.*"
        .ShowOpen
        txtHelpFile = .FileName
    End With

Fin:
End Sub


Private Sub ShowMsgBox()
    Dim sTitre As String, sMessage As String
    'le titre et le message
    sTitre = txtTitle.Text

    sMessage = txtMessage

    'l'icone
    Dim lngButtonsIcones As Long
    lngButtonsIcones = lngRetourneIcones

    'les boutons
    Dim lngButtons As Long
    lngButtons = lngRetourneBoutons

    'le bouton default
    Dim lngDefaultButton As Long
    lngDefaultButton = lngRetourneDefaultBoutons

    'la modalité
    Dim lngModal As Long
    If lblModal(1).FontBold Then
        lngModal = vbSystemModal
    End If

    '********************* le code total
    '//  le string du bouton
    Dim lngButtonsDef As Long
    lngButtonsDef = lngButtonsIcones + lngButtons + lngDefaultButton + lngModal

    'les divers
    If chkHelpButton.Value = vbChecked Then
        lngButtonsDef = lngButtonsDef + vbMsgBoxHelpButton
    End If

    If chk1Plan.Value = vbChecked Then
        lngButtonsDef = lngButtonsDef + vbMsgBoxSetForeground
    End If

    If chkTextAlign.Value = vbChecked Then
        lngButtonsDef = lngButtonsDef + vbMsgBoxRight
    End If

    '// fin du string
    On Error GoTo Fin
    If sTitre <> "" Then
        If txtHelpFile <> "" Then
            MsgBox sMessage, lngButtonsDef, sTitre, txtHelpFile, txtContext
        Else
            MsgBox sMessage, lngButtonsDef, sTitre
        End If
    Else
        If txtHelpFile <> "" Then
            MsgBox sMessage, lngButtonsDef, , txtHelpFile, txtContext
        Else
            MsgBox sMessage, lngButtonsDef
        End If
    End If

    Exit Sub
Fin:
    MsgBox "Erreur dans le code", vbCritical, "c2iMsgBox"
End Sub





Private Sub lblButtons_Click(Index As Integer)
    Dim iNum As Long

    For iNum = 0 To lblButtons.UBound
        lblButtons(iNum).FontBold = False
        lblButtons(iNum).BorderStyle = 0
    Next
    lblButtons(Index).FontBold = True
    lblButtons(Index).BorderStyle = 1

    MiseAJourCode
End Sub

Private Sub lblDefaultButton_Click(Index As Integer)
    Dim iNum As Long

    For iNum = 0 To lblDefaultButton.UBound
        lblDefaultButton(iNum).FontBold = False
        lblDefaultButton(iNum).BorderStyle = 0
    Next
    lblDefaultButton(Index).FontBold = True
    lblDefaultButton(Index).BorderStyle = 1

    MiseAJourCode
End Sub

Private Sub lblIconesInfos_Click(Index As Integer)
    picIcones_Click Index
End Sub

Private Sub lblModal_Click(Index As Integer)
    Dim iNum As Long

    For iNum = 0 To lblModal.UBound
        lblModal(iNum).FontBold = False
        lblModal(iNum).BorderStyle = 0
    Next
    lblModal(Index).FontBold = True
    lblModal(Index).BorderStyle = 1

    MiseAJourCode
End Sub

Private Sub picIcones_Click(Index As Integer)
    Dim iNum As Long, iUnPixel As Long

    iUnPixel = ScaleX(2, vbPixels, vbTwips)

    For iNum = 0 To picIcones.UBound
        picIcones(iNum).BorderStyle = 0
        lblIconesInfos(iNum).FontBold = False
    Next
    picIcones(Index).BorderStyle = 1
    lblIconesInfos(Index).FontBold = True
    picIconesOmbre.Left = picIcones(Index).Left + iUnPixel
    picIconesOmbre.Top = picIcones(Index).Top + iUnPixel


    MiseAJourCode
End Sub

Private Function MiseAJourCode()
    Dim sTitre As String, sMessage As String

    txtCode = ""
    'le titre et le message
    If txtTitle.Text <> "" Then
        sTitre = """" + txtTitle.Text + """"
    End If

    sMessage = ExtraitSautDeLigne(txtMessage.Text)

    'l'icone
    Dim sButtonsIcones As String
    sButtonsIcones = RetourneIcones

    'les boutons
    Dim sButtons As String
    sButtons = RetourneBoutons

    'le bouton default
    Dim sDefaultButton As String
    sDefaultButton = RetourneDefaultBoutons

    'la modalité
    Dim sModal As String
    If lblModal(1).FontBold Then
        sModal = "vbSystemModal"
    End If

    '********************* le code total
    '//  le string du bouton
    Dim sButtonsDef As String
    'l'icone
    sButtonsDef = sButtonsIcones
    'les boutons
    If sButtons <> "" Then
        If sButtonsDef <> "" Then
            sButtonsDef = sButtonsDef + " + " + sButtons
        Else
            sButtonsDef = sButtons
        End If
    End If
    'le bouton par default
    If sDefaultButton <> "" Then
        If sButtonsDef <> "" Then
            sButtonsDef = sButtonsDef + " + " + sDefaultButton
        Else
            sButtonsDef = sDefaultButton
        End If
    End If
    'la modalité
    If sModal <> "" Then
        If sButtonsDef <> "" Then
            sButtonsDef = sButtonsDef + " + " + sModal
        Else
            sButtonsDef = sModal
        End If
    End If
    'les divers
    If chkHelpButton.Value = vbChecked Then
        If sButtonsDef <> "" Then
            sButtonsDef = sButtonsDef + " + vbMsgBoxHelpButton"
        Else
            sButtonsDef = "vbMsgBoxHelpButton"
        End If
    End If
    If chk1Plan.Value = vbChecked Then
        If sButtonsDef <> "" Then
            sButtonsDef = sButtonsDef + " + vbMsgBoxSetForeground"
        Else
            sButtonsDef = "vbMsgBoxSetForeground"
        End If
    End If
    If chkTextAlign.Value = vbChecked Then
        If sButtonsDef <> "" Then
            sButtonsDef = sButtonsDef + " + vbMsgBoxRight"
        Else
            sButtonsDef = "vbMsgBoxRight"
        End If
    End If
    '// fin du string
    If sButtons <> "" Then                                 'il y a un code retour
        txtCode = txtCode + "Dim sc2iMsgBox As VbMsgBoxResult" + vbCrLf + vbCrLf
        txtCode = txtCode + "sc2iMsgBox = MsgBox(" + sMessage
        If sButtonsDef <> "" Then
            txtCode = txtCode + "," + sButtonsDef
        End If
        If sTitre <> "" Then
            If sButtonsDef = "" Then
                txtCode = txtCode + ", ," + sTitre
            Else
                txtCode = txtCode + "," + sTitre
            End If
        End If
        If Trim(txtHelpFile) <> "" Then
            If sTitre <> "" Then
                txtCode = txtCode + "," + txtHelpFile + "," + txtContext
            Else
                If sButtons = "" Then
                    txtCode = txtCode + ",,," + """" + txtHelpFile + """" + "," + txtContext
                Else
                    txtCode = txtCode + ",," + """" + txtHelpFile + """" + "," + txtContext
                End If
            End If
        End If
        txtCode = txtCode + ")"

        txtCode = txtCode + vbCrLf
        txtCode = txtCode + "Select Case sc2iMsgbox" + vbCrLf
        Select Case sButtons
            Case "vbOKCancel"
                txtCode = txtCode + Chr(9) + "Case vbOK" + vbCrLf + Chr(9) + "Case vbCancel" + vbCrLf
                txtCode = txtCode + "End Select"
            Case "vbAbortRetryIgnore"
                txtCode = txtCode + Chr(9) + "Case vbAbort" + vbCrLf + Chr(9) + "Case vbRetry" + vbCrLf + Chr(9) + "Case vbIgnore" + vbCrLf
                txtCode = txtCode + "End Select"
            Case "vbYesNoCancel"
                txtCode = txtCode + Chr(9) + "Case vbYes" + vbCrLf + Chr(9) + "Case vbNo" + vbCrLf + Chr(9) + "Case vbCancel" + vbCrLf
                txtCode = txtCode + "End Select"
            Case "vbYesNo"
                txtCode = txtCode + Chr(9) + "Case vbYes" + vbCrLf + Chr(9) + "Case vbNo" + vbCrLf
                txtCode = txtCode + "End Select"
            Case "vbRetryCancel"
                txtCode = txtCode + Chr(9) + "Case vbRetry" + vbCrLf + Chr(9) + "Case vCancel" + vbCrLf
                txtCode = txtCode + "End Select"
        End Select

    Else                                                   'sans retour de code
        txtCode = txtCode + "MsgBox " + sMessage
        If sButtonsDef <> "" Then
            txtCode = txtCode + "," + sButtonsDef
        End If
        If sTitre <> "" Then
            If sButtonsDef = "" Then
                txtCode = txtCode + ", ," + sTitre
            Else
                txtCode = txtCode + "," + sTitre
            End If
        End If
        If Trim(txtHelpFile) <> "" Then
            If sTitre <> "" Then
                txtCode = txtCode + "," + txtHelpFile + "," + txtContext
            Else
                If sButtons = "" Then
                    txtCode = txtCode + ",,," + """" + txtHelpFile + """" + "," + txtContext
                Else
                    txtCode = txtCode + ",," + """" + txtHelpFile + """" + "," + txtContext
                End If
            End If
        End If
    End If

End Function

Private Sub txtContext_Change()
    MiseAJourCode
End Sub

Private Sub txtHelpFile_Change()
    MiseAJourCode
End Sub


Private Sub txtMessage_Change()
    MiseAJourCode
End Sub

Private Sub txtTitle_Change()
    MiseAJourCode
End Sub

Private Sub UserDocument_Resize()
    On Error Resume Next
    txtCode.Width = ScaleWidth - txtCode.Left
    txtCode.Height = ScaleHeight - txtCode.Height
End Sub
