Attribute VB_Name = "UDMsgBox"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = True
Option Explicit



Private Sub c2iContainerIntMsg_OuvertureChange(Index As Integer)
    Dim iNum As Long, bOuvert As Boolean

    If c2iContainerIntMsg(Index).Ouvert Then
        For iNum = 0 To c2iContainerIntMsg.UBound
            If iNum <> Index Then
                c2iContainerIntMsg(iNum).Ouvert = False
            End If
        Next
    End If
    For iNum = 1 To c2iContainerIntMsg.UBound
        c2iContainerIntMsg(iNum).Top = c2iContainerIntMsg(iNum - 1).Top + c2iContainerIntMsg(iNum - 1).Height
        c2iContainerIntMsg(iNum).Left = c2iContainerIntMsg(0).Left
    Next

End Sub

Private Sub c2iContainerIntMsg_TitleDblClick(Index As Integer)
    c2iContainerIntMsg(Index).Ouvert = Not c2iContainerIntMsg(Index).Ouvert
End Sub

Private Sub tbMain_ButtonClick(ByVal Button As MSComctlLib.Button)
    Dim lngStartLine As Long, lngStartColumn As Long, lngEndLine As Long, lngEndColumn As Long

    Select Case Button.Image
        Case "voir"
            ShowMsgBox
        Case "copie"
            If VBInstance.ActiveCodePane.CodeModule Is Nothing Then
                MsgBox "Il n'y a pas de module actif"
                Exit Sub
            End If
            VBInstance.ActiveCodePane.GetSelection lngStartLine, lngStartColumn, lngEndLine, lngEndColumn
            VBInstance.ActiveCodePane.CodeModule.InsertLines lngStartLine, txtCode
    End Select
End Sub

Private Sub UserDocument_Initialize()
    Dim iNum As Long

    Select Case lngLanguage
        Case c2i_Langue_Français
            c2iContainerIntMsg(0).Caption = "Icônes"
            c2iContainerIntMsg(1).Caption = "Boutons"
            c2iContainerIntMsg(2).Caption = "Bouton par défaut"
            c2iContainerIntMsg(3).Caption = "Modalité"
            c2iContainerIntMsg(4).Caption = "Aide"
            c2iContainerIntMsg(5).Caption = "Divers"
            c2iContainerIntMsg(6).Caption = "Message - Titre"
            Label1 = "Titre"
        Case c2i_Langue_Anglais
            c2iContainerIntMsg(0).Caption = "Icons"
            c2iContainerIntMsg(1).Caption = "Buttons"
            c2iContainerIntMsg(2).Caption = "Default button"
            c2iContainerIntMsg(3).Caption = "Modal"
            c2iContainerIntMsg(4).Caption = "Help"
            c2iContainerIntMsg(5).Caption = "Divers"
            c2iContainerIntMsg(6).Caption = "Message - Title"
            Label1 = "Title"
    End Select

    For iNum = 0 To c2iContainerIntMsg.UBound
        c2iContainerIntMsg(iNum).Ouvert = False
    Next

    picIcones_Click 0
    lblButtons_Click 0
    lblDefaultButton_Click 0
    lblModal_Click 0
    c2iContainerIntMsg_OuvertureChange 0

    c2iContainerIntMsg(6).Ouvert = True

    txtMessage.Text = "Votre message"

End Sub


Private Function ExtraitSautDeLigne(ByVal sMessage As String) As String
    Dim lngPos As Long

    lngPos = InStr(1, sMessage, vbCrLf)
    Do Until lngPos = 0
        sMessage = Left(sMessage, lngPos - 1) + """" + "+ vbCrLf + " + """" + Right(sMessage, Len(sMessage) - lngPos - 1)
        lngPos = InStr(lngPos + 2, sMessage, vbCrLf)
    Loop

    If sMessage = "" Then
        ExtraitSautDeLigne = ""
    Else
        ExtraitSautDeLigne = """" + sMessage + """"
    End If

End Function

Private Function RetourneIcones() As String
    Dim iNum As Long

    For iNum = 0 To lblIconesInfos.UBound
        If lblIconesInfos(iNum).FontBold Then
            Select Case iNum
                Case 0                                     'aucunes
                    RetourneIcones = ""
                Case 1                                     'critique
                    RetourneIcones = "vbCritical"
                Case 2                                     'question
                    RetourneIcones = "vbQuestion"
                Case 3
                    RetourneIcones = "vbExclamation"
                Case 4
                    RetourneIcones = "vbInformation"
            End Select
            Exit For
        End If
    Next iNum
End Function

Private Function lngRetourneIcones() As Long
    Dim iNum As Long

    For iNum = 0 To lblIconesInfos.UBound
        If lblIconesInfos(iNum).FontBold Then
            Select Case iNum
                Case 0                                     'aucunes
                    lngRetourneIcones = 0
                Case 1                                     'critique
                    lngRetourneIcones = vbCritical
                Case 2                                     'question
                    lngRetourneIcones = vbQuestion
                Case 3
                    lngRetourneIcones = vbExclamation
                Case 4
                    lngRetourneIcones = vbInformation
            End Select
            Exit For
        End If
    Next iNum
End Function


Private Function RetourneBoutons() As String
    Dim iNum As Long

    For iNum = 0 To lblButtons.UBound
        If lblButtons(iNum).FontBold Then
            Select Case iNum
                Case 0
                    RetourneBoutons = ""
                Case 1
                    RetourneBoutons = "vbOKCancel"
                Case 2
                    RetourneBoutons = "vbAbortRetryIgnore"
                Case 3
                    RetourneBoutons = "vbYesNoCancel"
                Case 4
                    RetourneBoutons = "vbYesNo"
                Case 5
                    RetourneBoutons = "vbRetryCancel"
            End Select
            Exit For
        End If
    Next iNum
End Function
