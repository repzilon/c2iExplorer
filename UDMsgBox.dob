Option Explicit

Private Const conVbOKCancel As String = "vbOKCancel"
Private Const conVbAbortRetryIgnore As String = "vbAbortRetryIgnore"
Private Const conVbYesNoCancel As String = "vbYesNoCancel"
Private Const conVbYesNo As String = "vbYesNo"
Private Const conVbRetryCancel As String = "vbRetryCancel"
Private Const conV As String = ", "
Private Const conNomUD As String = "UDMsgBox"

Private lngIdxButtons As Long
Private lngIdxDefaultButton As Long
Private lngIdxIcones As Long
Private lngIdxModal As Long
Private intIdxPannOuvert As Integer

'Note par René Rhéaume 1er août 2001
'Avant de compiler :
'Seul le dernier c2iContainerIntMsg (indice 6) doit être ouvert
'(Ouvert = conVrai) dans la fenêtre de conception. Tous les autres
'doivent être fermés.

'Procédure optimisée par René Rhéaume le 30 juin 2002
Private Sub c2iContainerIntMsg_OuvertureChange(Index As Integer)
    Dim intPrem As Integer
    Dim intNum As Integer

    If (intIdxPannOuvert <> Index) Then
'        If (c2iContainerIntMsg(Index).Ouvert) Then
            c2iContainerIntMsg(intIdxPannOuvert).SilentClose
'        End If
    End If
    
    If (intIdxPannOuvert < Index) Then
        intPrem = intIdxPannOuvert
    Else
        intPrem = Index
    End If
    If (intPrem < 1) Then
        intPrem = 1
    End If
    
    For intNum = intPrem To 6
        c2iContainerIntMsg(intNum).Move 0, _
                c2iContainerIntMsg(intNum - 1).Top + c2iContainerIntMsg(intNum - 1).Height
    Next intNum
    
    intIdxPannOuvert = Index
End Sub

Private Sub c2iContainerIntMsg_TitleDblClick(Index As Integer)
    c2iContainerIntMsg(Index).Ouvert = Not c2iContainerIntMsg(Index).Ouvert
End Sub

'Procédure optimisée par René Rhéaume le 30 juin 2002
'Procédure optimisée par René Rhéaume le 18 décembre 2002
Private Sub picIcones_Click(Index As Integer)
    Dim iUnPixel As Long
    
    lblIconesInfos(lngIdxIcones).FontBold = conFaux
    picIcones(lngIdxIcones).BorderStyle = 0
    
    lblIconesInfos(Index).FontBold = conVrai
    With picIcones(Index)
        .BorderStyle = 1
        
        iUnPixel = ScaleX(2, vbPixels, vbTwips)
        shpIconesOmbre.Move .Left + iUnPixel, .Top + iUnPixel
    End With
    
    lngIdxIcones = Index
    MiseAJourCode
End Sub

' Procédure modifiée par René Rhéaume le 27 avril 2002
Private Sub tbMain_ButtonClick(ByVal Button As MSComctlLib.Button)
    Dim lngStartLine As Long, lngStartColumn As Long, lngEndLine As Long, lngEndColumn As Long

    Select Case Button.Key
        Case "voir"
            ShowMsgBox
        Case "copie"
            If (Not VBInstance.ActiveCodePane Is Nothing) Then
                With VBInstance.ActiveCodePane
                    .GetSelection lngStartLine, lngStartColumn, lngEndLine, lngEndColumn
                    .CodeModule.InsertLines lngStartLine, txtCode
                End With
            Else
                MsgBox mlgMsgAucuneFenetreCodeActive, vbInformation
'                Exit Sub
            End If
    End Select
End Sub

'Modifié par René Rhéaume le 19 juin 2002
Private Sub UserDocument_Initialize()
    Dim iNum As Long
    Dim lngCompte As Long
    Dim oleFermee As IPictureDisp, oleOuvert As IPictureDisp
    lngCompte = c2iContainerIntMsg.UBound
    Set oleFermee = imgFermee.Picture
    Set oleOuvert = imgOuvert.Picture
    For iNum = 0 To lngCompte
        With c2iContainerIntMsg(iNum)
            Set .PictureFerméeDown = oleFermee
            Set .PictureFerméeUp = oleFermee
            Set .PictureOuvertDown = oleOuvert
            Set .PictureOuvertUp = oleOuvert
        End With
    Next iNum
    Set oleFermee = Nothing
    Set oleOuvert = Nothing
            
    ChargerChainesLocales
    
    intIdxPannOuvert = 6
    picIcones_Click 0
    lblButtons_Click 0
    lblDefaultButton_Click 0
    lblModal_Click 0
'    ExtraireImageList ImageList1, "UDMsgBox.ImageList1"
End Sub

'Fonction modifiée par René Rhéaume le 22 juillet 2002
' Affiche "" s'il n'y a pas de texte
Private Function ExtraitSautDeLigne(ByVal sMessage As String) As String
    Dim lngPos As Long

    lngPos = InStr(1, sMessage, vbCrLf)
    Do Until (lngPos = 0)
        sMessage = Left$(sMessage, lngPos - 1) & (conGlmt & " & vbCrLf & " & conGlmt) & Right$(sMessage, Len(sMessage) - lngPos - 1)
        lngPos = InStr(lngPos + 2, sMessage, vbCrLf)
    Loop

    ExtraitSautDeLigne = conGlmt & sMessage & conGlmt
End Function

'Optimisé par René Rhéaume 2 septembre 2001
'Optimisé par René Rhéaume le 19 juin 2002
Private Function RetourneIcones() As String
    Static strarIcones() As String
    Static blnTabCree As Boolean
    If (Not blnTabCree) Then
        StrArray strarIcones, _
            vbNullString, "vbCritical", "vbQuestion", "vbExclamation", "vbInformation"
        blnTabCree = conVrai
    End If
    RetourneIcones = strarIcones(lngIdxIcones)
End Function

'Optimisé par René Rhéaume 2 septembre 2001
'Optimisé par René Rhéaume le 19 juin 2002
Private Function RetourneBoutons() As String
    Static strarBoutons() As String
    Static blnTabCree As Boolean
    If (Not blnTabCree) Then
        StrArray strarBoutons, _
            vbNullString, conVbOKCancel, conVbAbortRetryIgnore, _
            conVbYesNoCancel, conVbYesNo, conVbRetryCancel
        blnTabCree = conVrai
    End If
    RetourneBoutons = strarBoutons(lngIdxButtons)
End Function

'Optimisé par René Rhéaume 2 septembre 2001
'Optimisé par René Rhéaume le 19 juin 2002
Private Function RetourneDefaultBoutons() As String
    Static strarDefaultBoutons() As String
    Static blnTabCree As Boolean
    If (Not blnTabCree) Then
        StrArray strarDefaultBoutons, _
            vbNullString, "vbDefaultButton2", "vbDefaultButton3", "vbDefaultButton4"
        blnTabCree = conVrai
    End If
    RetourneDefaultBoutons = strarDefaultBoutons(lngIdxDefaultButton)
End Function

