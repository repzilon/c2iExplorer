Option Explicit

Private Const conVbOKCancel As String = "vbOKCancel"
Private Const conVbAbortRetryIgnore As String = "vbAbortRetryIgnore"
Private Const conVbYesNoCancel As String = "vbYesNoCancel"
Private Const conVbYesNo As String = "vbYesNo"
Private Const conVbRetryCancel As String = "vbRetryCancel"
Private Const conV As String = ", "

Private lngIdxButtons As Long
Private lngIdxDefaultButton As Long
Private lngIdxIcones As Long
Private lngIdxModal As Long

'Note par René Rhéaume 1er août 2001
'Avant de compiler :
'Seul le dernier c2iContainerIntMsg (index 6) doit être ouvert
'(Ouvert = conVrai) dans la fenêtre de conception. Tous les autres doivent
'être fermés.

Private Sub c2iContainerIntMsg_OuvertureChange(Index As Integer)
    Dim iNum As Long
    Dim intDernIdx As Integer, sngGaucheCont As Single
    intDernIdx = c2iContainerIntMsg.UBound
    If (c2iContainerIntMsg(Index).Ouvert) Then
        For iNum = 0 To intDernIdx
            If (iNum <> Index) Then
                c2iContainerIntMsg(iNum).Ouvert = conFaux
            End If
        Next
    End If
    sngGaucheCont = c2iContainerIntMsg(0).Left
    For iNum = 1 To intDernIdx
        c2iContainerIntMsg(iNum).Top = c2iContainerIntMsg(iNum - 1).Top + c2iContainerIntMsg(iNum - 1).Height
        c2iContainerIntMsg(iNum).Left = sngGaucheCont
    Next

End Sub

Private Sub c2iContainerIntMsg_TitleDblClick(Index As Integer)
    c2iContainerIntMsg(Index).Ouvert = Not c2iContainerIntMsg(Index).Ouvert
End Sub

Private Sub picIcones_Click(Index As Integer)
    Dim iNum As Long, iUnPixel As Long, intFinTab As Integer

    iUnPixel = ScaleX(2, vbPixels, vbTwips)
    intFinTab = picIcones.UBound
    For iNum = 0 To intFinTab
        picIcones(iNum).BorderStyle = 0
        lblIconesInfos(iNum).FontBold = conFaux
    Next
    picIcones(Index).BorderStyle = 1
    lblIconesInfos(Index).FontBold = conVrai
    shpIconesOmbre.Left = picIcones(Index).Left + iUnPixel
    shpIconesOmbre.Top = picIcones(Index).Top + iUnPixel
    lngIdxIcones = Index
    MiseAJourCode
End Sub

' Procédure modifiée par René Rhéaume le 27 avril 2002
Private Sub tbMain_ButtonClick(ByVal Button As MSComctlLib.Button)
    Dim lngStartLine As Long, lngStartColumn As Long, lngEndLine As Long, lngEndColumn As Long

    Select Case Button.Image
        Case "voir"
            ShowMsgBox
        Case "copie"
            If (Not VBInstance.ActiveCodePane Is Nothing) Then
                With VBInstance.ActiveCodePane
                    .GetSelection lngStartLine, lngStartColumn, lngEndLine, lngEndColumn
                    .CodeModule.InsertLines lngStartLine, txtCode
                End With
            Else
                MsgBox conMsgAucuneFenetreCodeActive, vbInformation
'                Exit Sub
            End If
    End Select
End Sub

Private Sub UserDocument_Initialize()
    Dim iNum As Long
    Dim lngCompte As Long
    Dim oleFermee As IPictureDisp, oleOuvert As IPictureDisp
    lngCompte = c2iContainerIntMsg.UBound
    Set oleFermee = imgFermee.Picture
    Set oleOuvert = ImgOuvert.Picture
    For iNum = 0 To lngCompte
        With c2iContainerIntMsg(iNum)
            Set .PictureFerméeDown = oleFermee
            Set .PictureFerméeUp = oleFermee
            Set .PictureOuvertDown = oleOuvert
            Set .PictureOuvertUp = oleOuvert
        End With
    Next iNum
    Set oleFermee = Nothing
    Set oleOuvert = Nothing

    Select Case lngLanguage
        Case c2i_Langue_Anglais
            c2iContainerIntMsg(0).Caption = "Icons"
            c2iContainerIntMsg(1).Caption = "Buttons"
            c2iContainerIntMsg(2).Caption = "Default button"
            c2iContainerIntMsg(3).Caption = "Modal"
            c2iContainerIntMsg(4).Caption = "Help"
            c2iContainerIntMsg(5).Caption = "Miscellaneous"
            c2iContainerIntMsg(6).Caption = "Message - Title"
            lblInvite(0).Caption = "Title"
            txtMessage.Text = "Your message"
        Case Else
            c2iContainerIntMsg(0).Caption = "Icônes"
            c2iContainerIntMsg(1).Caption = "Boutons"
            c2iContainerIntMsg(2).Caption = "Bouton par défaut"
            c2iContainerIntMsg(3).Caption = "Modalité"
            c2iContainerIntMsg(4).Caption = "Aide"
            c2iContainerIntMsg(5).Caption = "Divers"
            c2iContainerIntMsg(6).Caption = "Message - Titre"
            lblInvite(0).Caption = "Titre"
            txtMessage.Text = "Votre message"
    End Select

    picIcones_Click 0
    lblButtons_Click 0
    lblDefaultButton_Click 0
    lblModal_Click 0
'    ExtraireImageList ImageList1, "UDMsgBox.ImageList1"
End Sub

Private Function ExtraitSautDeLigne(ByVal sMessage As String) As String
    Dim lngPos As Long

    lngPos = InStr(1, sMessage, vbCrLf)
    Do Until (lngPos = 0)
        sMessage = Left$(sMessage, lngPos - 1) & (conGlmt & " & vbCrLf & " & conGlmt) & Right$(sMessage, Len(sMessage) - lngPos - 1)
        lngPos = InStr(lngPos + 2, sMessage, vbCrLf)
    Loop

    If (sMessage = vbNullString) Then
        ExtraitSautDeLigne = vbNullString
    Else
        ExtraitSautDeLigne = conGlmt & sMessage & conGlmt
    End If
End Function

'Optimisé par René Rhéaume 2 septembre 2001
Private Function RetourneIcones() As String
    '    Dim iNum As Long
    '
    '    For iNum = 0 To 4 'lblIconesInfos.UBound
    '        If (lblIconesInfos(iNum).FontBold) Then
    '            Exit For
    '        End If
    '    Next iNum
    Select Case lngIdxIcones
        Case 0                                             'aucune
            RetourneIcones = vbNullString
        Case 1                                             'critique
            RetourneIcones = "vbCritical"
        Case 2                                             'question
            RetourneIcones = "vbQuestion"
        Case 3
            RetourneIcones = "vbExclamation"
        Case 4
            RetourneIcones = "vbInformation"
    End Select
End Function

'Optimisé par René Rhéaume 2 septembre 2001
Private Function RetourneBoutons() As String
    '    Dim iNum As Long
    '
    '    For iNum = 0 To 5 'lblButtons.UBound
    '        If lblButtons(iNum).FontBold Then
    '            Exit For
    '        End If
    '    Next iNum
    Select Case lngIdxButtons
        Case 0
            RetourneBoutons = vbNullString
        Case 1
            RetourneBoutons = conVbOKCancel
        Case 2
            RetourneBoutons = conVbAbortRetryIgnore
        Case 3
            RetourneBoutons = conVbYesNoCancel
        Case 4
            RetourneBoutons = conVbYesNo
        Case 5
            RetourneBoutons = conVbRetryCancel
    End Select
End Function

' Optimisé par René Rhéaume 2 septembre 2001
Private Function RetourneDefaultBoutons() As String
    '    Dim iNum As Long
    '
    '    For iNum = 0 To 3 'lblDefaultButton.UBound
    '        If lblDefaultButton(iNum).FontBold Then
    '            Exit For
    '        End If
    '    Next iNum
    Select Case lngIdxDefaultButton
        Case 0
            RetourneDefaultBoutons = vbNullString
        Case 1
            RetourneDefaultBoutons = "vbDefaultButton2"
        Case 2
            RetourneDefaultBoutons = "vbDefaultButton3"
        Case 3
            RetourneDefaultBoutons = "vbDefaultButton4"
    End Select
End Function

Private Sub chk1Plan_Click()
    MiseAJourCode
End Sub

Private Sub chkHelpButton_Click()
    MiseAJourCode
End Sub

Private Sub chkTextAlign_Click()
    MiseAJourCode
End Sub

Private Sub cmdParcoursFile_Click()
    On Error GoTo Fin
    Dim cCommonDialog As cDlgCom
    Set cCommonDialog = New cDlgCom
    With cCommonDialog
        .DefaultEx = ".hlp"
        .Flags = OFN_HIDEREADONLY + OFN_PATHMUSTEXIST + OFN_FILEMUSTEXIST + OFN_EXPLORER + OFN_LONGNAMES
        .Filter = "Fichiers d'aide (*.chm;*.hlp)|*.chm;*.hlp|Tous les fichiers (*.*)|*.*"
        .FilterIndex = 1
        .Filename = txtHelpFile.Text
        .ShowOpen
        txtHelpFile = .Filename
    End With

Fin:
    Set cCommonDialog = Nothing
End Sub

' Procédure modifiée par René Rhéaume le 23 avril 2002
' Élimination de variables inutiles
' Procédure modifiée par René Rhéaume le 27 avril 2002
' Élimination de lngRetourneBoutons, lngRetourneDefaultBoutons
' et de lngRetourneIcones
Private Sub ShowMsgBox()
    Dim sTitre As String, sMessage As String
    'le titre et le message
    sTitre = txtTitle.Text
    sMessage = txtMessage.Text

    '********************* le code total
    'les options du MsgBox
    Dim lngButtonsDef As Long
    lngButtonsDef = lngIdxIcones * 16
    lngButtonsDef = lngButtonsDef + lngIdxButtons
    lngButtonsDef = lngButtonsDef + (lngIdxDefaultButton * 256)
    lngButtonsDef = lngButtonsDef + (lngIdxModal * vbSystemModal) '- (lblModal(1).FontBold * vbSystemModal) ' Parce que True vaut -1 sous VB classique

    'les divers
    If (chkHelpButton.Value = vbChecked) Then
        lngButtonsDef = lngButtonsDef + vbMsgBoxHelpButton
    End If

    If (chk1Plan.Value = vbChecked) Then
        lngButtonsDef = lngButtonsDef + vbMsgBoxSetForeground
    End If

    If (chkTextAlign.Value = vbChecked) Then
        lngButtonsDef = lngButtonsDef + vbMsgBoxRight
    End If
    ' fin des options
    
    On Error GoTo Fin
    If (sTitre <> vbNullString) Then
        If (txtHelpFile <> vbNullString) Then
            MsgBox sMessage, lngButtonsDef, sTitre, txtHelpFile, txtContext
        Else
            MsgBox sMessage, lngButtonsDef, sTitre
        End If
    Else
        If (txtHelpFile <> vbNullString) Then
            MsgBox sMessage, lngButtonsDef, , txtHelpFile, txtContext
        Else
            MsgBox sMessage, lngButtonsDef
        End If
    End If

    Exit Sub
Fin:
    MsgBox "Erreur dans le code", vbExclamation
End Sub

Private Sub lblButtons_Click(Index As Integer)
    Dim iNum As Long

    For iNum = 0 To lblButtons.UBound
        lblButtons(iNum).FontBold = conFaux
        lblButtons(iNum).BorderStyle = 0
    Next
    lblButtons(Index).FontBold = conVrai
    lblButtons(Index).BorderStyle = 1
    lngIdxButtons = Index
    MiseAJourCode
End Sub

Private Sub lblDefaultButton_Click(Index As Integer)
    Dim iNum As Long

    For iNum = 0 To lblDefaultButton.UBound
        lblDefaultButton(iNum).FontBold = conFaux
        lblDefaultButton(iNum).BorderStyle = 0
    Next
    lblDefaultButton(Index).FontBold = conVrai
    lblDefaultButton(Index).BorderStyle = 1
    lngIdxDefaultButton = Index
    MiseAJourCode
End Sub

Private Sub lblIconesInfos_Click(Index As Integer)
