Private Sub UserDocument_Resize()
    On Error Resume Next
    txtCode.Width = ScaleWidth - txtCode.Left
    txtCode.Height = ScaleHeight - txtCode.Top
End Sub

' Procédure ajoutée par René Rhéaume le 23 avril 2002
' Procédure ajoutée par René Rhéaume le 28 avril 2002
Private Sub ConcatenerOptionMsgBox(ByRef strDestination As String, ByVal strOptionAjout As String, _
                                   ByVal blnCondition As Boolean)
    Const conPlus As String = " + "
    If (blnCondition) Then
        If (strDestination <> vbNullString) Then
            strDestination = strDestination & (conPlus & strOptionAjout)
        Else
            strDestination = strOptionAjout
        End If
    End If
End Sub

' Procédure ajoutée par René Rhéaume le 28 avril 2002
Private Sub ConcatenerParamMsgBox(ByRef strDestination As String, ByVal strParamAjout As String, _
                                    Optional ByVal strEncadreur As String = vbNullString)
    If (strParamAjout <> vbNullString) Then
        strDestination = ((conV & strEncadreur) & (strParamAjout & strEncadreur)) & strDestination
    Else
        If (strDestination <> vbNullString) Then
            strDestination = conV & strDestination
        End If
    End If
End Sub

' Procédure ajoutée par René Rhéaume le 28 avril 2002
Private Sub ConcatenerCas(ByRef strCode As String, ByVal strCasAjout As String)
    strCode = strCode & ((vbTab & "Case ") & (strCasAjout & vbCrLf))
End Sub

'Procédure ajoutée par René Rhéaume le 19 juin 2002
' Support multilingue
Private Sub ChargerChainesLocales()
    Const conClefL10nProc As String = "Code.ChargerChainesLocales."
    Const conCaption As String = ").Caption"
    Dim I As Long
    Dim strarRangs() As String
    Dim strBouton As String
    Dim strIdTexte As String
    Dim strarModality() As String
    Dim strModal As String
    
    StrArray strarRangs, "er", "e", "e", "e"
    StrArray strarModality, "Application", "Système"
    
    strBouton = LireChaineLocalisee(conNomUD, conClefL10nProc & "strBouton", "bouton")
    strModal = LireChaineLocalisee(conNomUD, conClefL10nProc & "strModal", "Modal")
    chkHelpButton.Caption = LireChaineLocalisee(conNomUD, _
            "Obj.chkHelpButton.Caption", "Bouton d'aide")
    chk1Plan.Caption = LireChaineLocalisee(conNomUD, _
            "Obj.chk1Plan.Caption", "Fenêtre de 1er plan")
    chkTextAlign.Caption = LireChaineLocalisee(conNomUD, _
            "Obj.chkTextAlign.Caption", "Texte aligné à droite")
    txtMessage.Text = LireChaineLocalisee(conNomUD, "Obj.txtMessage.Text", "Votre message")
    
    If (blnMultilingueActive) Then
        For I = 0 To 6
            c2iContainerIntMsg(I).Caption = LireChaineLocalisee(conNomUD, _
                    "Obj.c2iContainerIntMsg(" & I & conCaption, c2iContainerIntMsg(I).Caption)
        Next I
        For I = 0 To 4
            lblIconesInfos(I).Caption = LireChaineLocalisee(conNomUD, _
                    "Obj.lblIconesInfos(" & I & conCaption, lblIconesInfos(I).Caption)
        Next I
        For I = 0 To 4
            lblInvite(I).Caption = LireChaineLocalisee(conNomUD, _
                    "Obj.lblInvite(" & I & conCaption, lblInvite(I).Caption)
        Next I
        For I = 0 To 3
            strIdTexte = CStr(I + 1)
            strarRangs(I) = LireChaineLocalisee(conNomUD, _
                    conClefL10nProc & "strarRangs(" & strIdTexte & ")", strarRangs(I))
            lblDefaultButton(I).Caption = strIdTexte & strarRangs(I) & conEsp & strBouton
        Next I
        For I = 0 To 1
            strarModality(I) = LireChaineLocalisee(conNomUD, _
                    conClefL10nProc & "strarModality(" & I & ")", strarRangs(I))
            lblModal(I).Caption = strModal & " / " & strarModality(I)
        Next I
    End If
End Sub
