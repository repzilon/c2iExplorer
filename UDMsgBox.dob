End Sub

Private Sub lblModal_Click(Index As Integer)
    Dim iNum As Long

    For iNum = 0 To lblModal.UBound
        lblModal(iNum).FontBold = conFaux
        lblModal(iNum).BorderStyle = 0
    Next
    lblModal(Index).FontBold = conVrai
    lblModal(Index).BorderStyle = 1
    lngIdxModal = Index
    MiseAJourCode
End Sub

' Procédure modifiée par René Rhéaume le 23 avril 2002
' Appels à ConcatenerOptionMsgBox
' Procédure modifiée par René Rhéaume le 28 avril 2002
' Nouvel algorithme implanté (voir MiseAJourCode.doc)
Private Sub MiseAJourCode()
    Const conVbOK As String = "vbOK"
    Const conVbCancel As String = "vbCancel"
    Const conVbAbort As String = "vbAbort"
    Const conVbRetry As String = "vbRetry"
    Const conVbIgnore As String = "vbIgnore"
    Const conVbYes As String = "vbYes"
    Const conVbNo As String = "vbNo"
    Const conVarResultat As String = "lngC2iMsgBox"
    
    Dim strMessage As String
    'Dim strIcone As String
    Dim strBoutons As String
    Dim strBoutonParDefaut As String
    'Dim intModalite As Integer 'lngIdxModal à la place
    Dim intPremierPlan As Integer
    Dim intBtnAide As Integer
    Dim intADroite As Integer
    Dim strTitre As String
    Dim strFichierAide As String
    Dim strContexte As String
    Dim strCode As String
    Dim strCodeParametres As String
    Dim strToutesOptions As String
    Dim blnBoutonsPresents As Boolean
    
    strMessage = ExtraitSautDeLigne(txtMessage.Text)
    'strIcone = RetourneIcones
    strToutesOptions = RetourneIcones
    strBoutons = RetourneBoutons
    strBoutonParDefaut = RetourneDefaultBoutons
    intPremierPlan = chk1Plan.Value
    intBtnAide = chkHelpButton.Value
    intADroite = chkTextAlign.Value
    strTitre = Trim$(txtTitle.Text)
    strFichierAide = Trim$(txtHelpFile.Text)
    strContexte = Trim$(txtContext.Text)
    If (Not IsNumeric(strContexte)) Then
        strContexte = vbNullString
    End If
    blnBoutonsPresents = (strBoutons <> vbNullString)
    
    If (blnBoutonsPresents) Then
        strCode = "Dim " & conVarResultat & " As VbMsgBoxResult" & (vbCrLf & vbCrLf) & conVarResultat & " = MsgBox(" & strMessage
    Else
        strCode = "MsgBox " & strMessage
    End If
    
    'strToutesOptions = strIcone
    ConcatenerOptionMsgBox strToutesOptions, strBoutons, blnBoutonsPresents
    ConcatenerOptionMsgBox strToutesOptions, strBoutonParDefaut, (strBoutonParDefaut <> vbNullString)
    ConcatenerOptionMsgBox strToutesOptions, "vbSystemModal", lngIdxModal
    ConcatenerOptionMsgBox strToutesOptions, "vbMsgBoxHelpButton", intBtnAide
    ConcatenerOptionMsgBox strToutesOptions, "vbMsgBoxSetForeground", intPremierPlan
    ConcatenerOptionMsgBox strToutesOptions, "vbMsgBoxRight", intADroite
    
    ' Attention, la concaténation se fait à l'envers pour simplifier la gestion de la virgule
    If (strContexte <> vbNullString) Then
        strCodeParametres = conV & strContexte
    End If
    ConcatenerParamMsgBox strCodeParametres, strFichierAide, conGlmt
    ConcatenerParamMsgBox strCodeParametres, strTitre, conGlmt
    ConcatenerParamMsgBox strCodeParametres, strToutesOptions, vbNullString
    ' Retour à la normale
    strCode = strCode & strCodeParametres
    If (blnBoutonsPresents) Then
        strCode = strCode & ")" & vbCrLf & "Select Case " & conVarResultat & vbCrLf
        Select Case (strBoutons)
            Case conVbOKCancel
                ConcatenerCas strCode, conVbOK
                ConcatenerCas strCode, conVbCancel
            Case conVbAbortRetryIgnore
                ConcatenerCas strCode, conVbAbort
                ConcatenerCas strCode, conVbRetry
                ConcatenerCas strCode, conVbIgnore
            Case conVbYesNoCancel
                ConcatenerCas strCode, conVbYes
                ConcatenerCas strCode, conVbNo
                ConcatenerCas strCode, conVbCancel
            Case conVbYesNo
                ConcatenerCas strCode, conVbYes
                ConcatenerCas strCode, conVbNo
            Case conVbRetryCancel
                ConcatenerCas strCode, conVbRetry
                ConcatenerCas strCode, conVbCancel
        End Select
        strCode = strCode & "End Select"
    End If
    
    txtCode.Text = strCode
End Sub

Private Sub txtContext_Change()
    MiseAJourCode
End Sub

Private Sub txtHelpFile_Change()
    MiseAJourCode
End Sub

Private Sub txtMessage_Change()
    MiseAJourCode
End Sub

Private Sub txtTitle_Change()
    MiseAJourCode
End Sub

Private Sub UserDocument_Resize()
    On Error Resume Next
    txtCode.Width = ScaleWidth - txtCode.Left
    txtCode.Height = ScaleHeight - txtCode.Top
End Sub

' Procédure ajoutée par René Rhéaume le 23 avril 2002
' Procédure ajoutée par René Rhéaume le 28 avril 2002
Private Sub ConcatenerOptionMsgBox(ByRef strDestination As String, ByVal strOptionAjout As String, _
                                   ByVal blnCondition As Boolean)
    Const conPlus As String = " + "
    If (blnCondition) Then
        If (strDestination <> vbNullString) Then
            strDestination = strDestination & (conPlus & strOptionAjout)
        Else
            strDestination = strOptionAjout
        End If
    End If
End Sub

' Procédure ajoutée par René Rhéaume le 28 avril 2002
Private Sub ConcatenerParamMsgBox(ByRef strDestination As String, ByVal strParamAjout As String, _
                                    Optional ByVal strEncadreur As String = vbNullString)
    If (strParamAjout <> vbNullString) Then
        strDestination = ((conV & strEncadreur) & (strParamAjout & strEncadreur)) & strDestination
    Else
        If (strDestination <> vbNullString) Then
            strDestination = conV & strDestination
        End If
    End If
End Sub

' Procédure ajoutée par René Rhéaume le 28 avril 2002
Private Sub ConcatenerCas(ByRef strCode As String, ByVal strCasAjout As String)
    strCode = strCode & ((vbTab & "Case ") & (strCasAjout & vbCrLf))
End Sub
