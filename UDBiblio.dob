Option Explicit
Private Const conNom As String = "Nom"
Private Const conDescription As String = "Description"
Private Const conDeclareProc As String = "DeclareProc"
Private Const conHeadProc As String = "HeadProc"
Private Const conInLineProc As String = "InLineProc"
Private Const conEndProc As String = "EndProc"
Private Const conWeb As String = "web"
Private Const conMail As String = "mail"
Private Const conBiblio As String = "biblio"
Private Const conNewdata As String = "newdata"
Private Const conSave As String = "save"
Private Const conNewbiblio As String = "newbiblio"
Private Const conNewcategorie As String = "newcategorie"
Private Const conDelete As String = "delete"
Private Const conVoir As String = "voir"
Private Const conCopie As String = "copie"
Private Const conExtBD As String = ".mdb"
Private Const conRSElements As String = "Elements"
Private Const conNomUD As String = "UDBiblio"
Private Enum TypePosition
    posDeclarations = 1
    posPostDeclar = 2
    posEntreDeuxProc = 3
    posDansProc = 4
    posFinModule = 5
End Enum
Private Enum Direction
    enAvant = 1
    enArriere = -1
End Enum
Private strFiltreBD As String

Public bFrmBiblio As Boolean
Public TVEx As TreeView

'Procédure modifiée par René Rhéaume le 24 avril 2002
' Regroupement des opérations du Select Case
'Procédure modifiée par René Rhéaume le 2 mai 2002
' Vérification de l'existence de base.c2i
'Procédure modifiée par René Rhéaume le 20 juin 2002
' Support multilingue
Private Sub Enregistrement(ByVal sFile As String)
    Const conClefL10nEnr As String = "Code.Enregistrement."
    Static mlgarMsgBaseC2iAbsent() As String
    Static mlgarMsgErrSauvegarde() As String
    Static blnLangEnrOK As Boolean
    Dim I As Long
    If (Not blnLangEnrOK) Then
        StrArray mlgarMsgBaseC2iAbsent, "Ce fichier est le modèle de structure de bibliothèque de code.", _
            "Veuillez réinstaller l'application."
        StrArray mlgarMsgErrSauvegarde, _
            "Il y a eu une erreur lors de l'initialisation de la sauvegarde.", _
            "a peut-être créé un fichier de sauvegarde sous le nom de"
            If (blnMultilingueActive) Then
                For I = 0 To 1
                    mlgarMsgBaseC2iAbsent(I) = LireChaineLocalisee(conNomUD, _
                            conClefL10nEnr & "mlgarMsgBaseC2iAbsent(" & I & conPF, _
                            mlgarMsgBaseC2iAbsent(I))
                    mlgarMsgErrSauvegarde(I) = LireChaineLocalisee(conNomUD, _
                            conClefL10nEnr & "mlgarMsgErrSauvegarde(" & I & conPF, _
                            mlgarMsgErrSauvegarde(I))
                Next I
            End If
        blnLangEnrOK = conVrai
    End If

    Const conExtBak As String = ".bak"
    Const conNomMeth As String = "UDBiblio.Enregistrement"
    Dim db As Database, rs As Recordset
    Dim mNode As Node, objE As cElement

    If (FichierExiste(c2iDataFileNameOrigine)) Then
        On Error GoTo RestaurerSauvegarde
        'Modifié par René Rhéaume, 29 juillet 2001
        If (FichierExiste(sFile)) Then
            'Copie de sauvegarde du fichier
            FileCopy sFile, sFile & conExtBak
            'destruction du fichier
            Kill sFile
        End If
        'copie du fichier de base
        FileCopy c2iDataFileNameOrigine, sFile
    
        On Error GoTo Fin
        Set db = OpenDatabase(sFile)
        Set rs = db.OpenRecordset(conRSElements, dbOpenDynaset)
        For Each mNode In tv.Nodes
            Select Case mNode.Image
                Case conElement, conWeb, conMail
                    rs.AddNew
                    Set objE = Explorer.Elements(mNode.FullPath)
                    rs.Fields(conNom) = objE.Nom
                    rs.Fields(conDescription) = objE.Description
                    If (mNode.Image = conElement) Then
                        rs.Fields(conDeclareProc) = objE.DeclareProc
                        rs.Fields(conHeadProc) = objE.HeadProc
                        rs.Fields(conInLineProc) = objE.InLineProc
                        rs.Fields(conEndProc) = objE.EndProc
                    End If
                    rs.Update
            End Select
        Next
        If FichierExiste(sFile & conExtBak) Then
            Kill sFile & conExtBak
        End If
    Else
        MsgBox mlgarFichExistePas(0) & c2iDataFileNameOrigine & mlgarFichExistePas(1) & vbNewLine & _
                mlgarMsgBaseC2iAbsent(0) & vbNewLine & mlgarMsgBaseC2iAbsent(1), vbCritical
    End If

SortieFunc:
    'On Error Resume Next
    rs.Close
    db.Close
    Set rs = Nothing
    Set db = Nothing
    Exit Sub
RestaurerSauvegarde:
    GererErrInattendue mlgarMsgErrSauvegarde(0) & vbCrLf & _
            conNomApp & mlgarMsgErrSauvegarde(1) & vbCrLf & _
            sFile & conExtBak & " .", conNomMeth
    Resume SortieFunc
Fin:
    GererErrInattendue , conNomMeth
    Resume SortieFunc
End Sub

Private Sub ValideInsertion(ByVal objE As cElement)
    Dim sDP As String, sH As String, sI As String, sE As String

    If (tbMain.Buttons(conDeclareProc).Value = tbrPressed) Then
        sDP = objE.DeclareProc
    End If
    If (tbMain.Buttons(conHeadProc).Value = tbrPressed) Then
        sH = objE.HeadProc
    End If
    If (tbMain.Buttons(conInLineProc).Value = tbrPressed) Then
        sI = objE.InLineProc
    End If
    If (tbMain.Buttons(conEndProc).Value = tbrPressed) Then
        sE = objE.EndProc
    End If

    InsertCode sDP, sH, sI, sE
End Sub

Private Sub tv_DblClick()
    tbMain_ButtonClick tbMain.Buttons(conCopie)
End Sub

Private Sub tv_NodeClick(ByVal Node As MSComctlLib.Node)
    Dim objE As cElement

    On Error Resume Next
    Select Case Node.Image
        Case conElement
            Set objE = Explorer.Elements(Node.FullPath)
            'Optimisation par René Rhéaume 2 septembre 2001
            'Ne fonctionnerait pas sous .net car True = 1 sur .net
            'alors que dans VB 5/6, True = -1
            'Équivalent à :
            '            If Trim$(objE.DeclareProc) = vbNullString Then
            '                tbMain.Buttons(conDeclareProc).Value = tbrUnpressed
            '            Else
            '                tbMain.Buttons(conDeclareProc).Value = tbrPressed
            '            End If
            '            .
            '            .
            '            .
            With tbMain
                .Buttons(conDeclareProc).Value = (Trim$(objE.DeclareProc) = vbNullString) + 1
                .Buttons(conHeadProc).Value = (Trim$(objE.HeadProc) = vbNullString) + 1
                .Buttons(conInLineProc).Value = (Trim$(objE.InLineProc) = vbNullString) + 1
                .Buttons(conEndProc).Value = (Trim$(objE.EndProc) = vbNullString) + 1
            End With
            'mise à jour de l'affichage du détail
            If (bFrmBiblio) Then
                Set frmBiblio.Element = objE
            End If
        Case Else
            With tbMain
                .Buttons(conDeclareProc).Value = tbrUnpressed
                .Buttons(conHeadProc).Value = tbrUnpressed
                .Buttons(conInLineProc).Value = tbrUnpressed
                .Buttons(conEndProc).Value = tbrUnpressed
            End With
    End Select
End Sub

'Procédure modifiée par René Rhéaume le 29 juillet 2001
' Lecture du fichier INI
'Procédure modifiée par René Rhéaume le 3 mai 2002
' Retrait du message d'erreur si le fichier de base de
' données spécifié dans le fichier INI n'existe pas
'Procédure modifiée par René Rhéaume le 20 juin 2002
' Support multilingue
Private Sub UserDocument_Initialize()
    Dim strDebutFiltreBD As String

    c2iCurrentDataFileName = LireChaineFichierINI(conSecGen, conValData, vbNullString, c2iINIFile)
    bFrmBiblio = conFaux
    If (FichierExiste(c2iCurrentDataFileName)) Then
        ChargeBase c2iCurrentDataFileName
    End If
    
    MakeToolBar
    strDebutFiltreBD = LireChaineLocalisee(conNomUD, _
            "Code.UserDocument_Initialize.strDebutFiltreBD", "Bases de données")
    strFiltreBD = strDebutFiltreBD & " (*.mdb)|*.mdb"
    
    UserDocument_Resize
    Set TVEx = tv
'    ExtraireImageList imgTB, "UDBiblio.imgTB"
'    ExtraireImageList imgTV, "UDBiblio.imgTV"
End Sub

Private Sub RempliTV()
    Dim objElement As cElement

    For Each objElement In Explorer.Elements
        AddElement objElement
    Next
    Set objElement = Nothing
End Sub

Public Sub AddElement(ByVal objElement As cElement)
    Dim iNum As Long
    Dim mNodeParent As Node, mNodeNewRep As Node, sM As String

    On Error Resume Next
'    MsgBox objElement.Ident, vbInformation
    For iNum = 0 To objElement.Ident - 1
        sM = objElement.CheminComplet(iNum)
'        MsgBox sM, vbInformation
        Set mNodeNewRep = Nothing
        Set mNodeNewRep = tv.Nodes(sM)
        If (mNodeNewRep Is Nothing) Then
            If (iNum = 0) Then
                Set mNodeParent = tv.Nodes.Add(, , sM, sM, conBiblio)
            Else
                Set mNodeParent = tv.Nodes.Add(mNodeParent, tvwChild, sM, objElement.NomRepertoire(iNum), "categorie")
            End If
        Else
            Set mNodeParent = mNodeNewRep
        End If
    Next
    'Optimisation par René Rhéaume 2 septembre 2001
    Select Case objElement.Titre
        Case "[Web Site]"
            tv.Nodes.Add mNodeParent, tvwChild, objElement.Nom, objElement.Titre, conWeb
        Case "[Mail]"
            tv.Nodes.Add mNodeParent, tvwChild, objElement.Nom, objElement.Titre, conMail
        Case Else
            tv.Nodes.Add mNodeParent, tvwChild, objElement.Nom, objElement.Titre, conElement
    End Select
    Set mNodeParent = Nothing
    Set mNodeNewRep = Nothing
End Sub

' Note par René Rhéaume le 7 janvier 2002 :
' Nouvel algorithme demandé (RÉSOLU)
' 17 janvier 2002 :
' Description de la procédure :
' BUT : Insérer le code défini par les quatre sections : déclarations,
' en-tête, corps, pied.
' 12 avril 2002 :
' la description est devenue obsolète
' nouvel algorithme développé par René Rhéaume (voir InsertCode.doc)
Private Sub InsertCode(ByVal strDeclaration As String, ByVal strEnTete As String, _
                        ByVal strContenu As String, ByVal strPied As String)
    Dim objCodeModule As VBIDE.CodeModule
    Dim lngNbLignesDeclar As Long
    Dim blnEnTetePresent As Boolean, blnContenuPresent As Boolean, blnPiedPresent As Boolean
    Dim lngCodePresence As Long
    Dim lngTypePosCurseur As TypePosition
    Dim lngLigneCurseur As Long
    Dim lngStartColumn As Long, lngEndLine As Long, lngEndColumn As Long
    
    If (VBInstance.ActiveCodePane.CodeModule Is Nothing) Then
        MsgBox mlgMsgAucuneFenetreCodeActive, vbExclamation
    Else
        Set objCodeModule = VBInstance.ActiveCodePane.CodeModule
        lngNbLignesDeclar = objCodeModule.CountOfDeclarationLines
        If (LenB(strDeclaration) > 0) Then
            objCodeModule.InsertLines lngNbLignesDeclar + 1, strDeclaration
            lngNbLignesDeclar = objCodeModule.CountOfDeclarationLines
        End If
        blnEnTetePresent = (LenB(strEnTete) > 0)
        blnContenuPresent = (LenB(strContenu) > 0)
        blnPiedPresent = (LenB(strPied) > 0)
        lngCodePresence = (blnEnTetePresent * -4) + (blnContenuPresent * -2) - blnPiedPresent
        objCodeModule.CodePane.GetSelection lngLigneCurseur, lngStartColumn, lngEndLine, lngEndColumn
        'MsgBox "lngCodePresence = " & lngCodePresence, vbInformation
        lngTypePosCurseur = DeterminerPositionCurseur(lngLigneCurseur)
'        MsgBox "lngTypePosCurseur = " & lngTypePosCurseur & vbNewLine & _
                "lngCodePresence = " & lngCodePresence, vbInformation
        Select Case (lngCodePresence)
            Case 5, 7
                Select Case (lngTypePosCurseur)
                    Case posDeclarations, posDansProc
                        lngLigneCurseur = objCodeModule.CountOfLines + 2
                End Select
            Case 4
                Select Case (lngTypePosCurseur)
                    Case posDeclarations
                        lngLigneCurseur = lngNbLignesDeclar + 2
                    Case posDansProc
                        lngLigneCurseur = objCodeModule.CountOfLines + 2
                End Select
        End Select
        ' Condition optimisée avec des tableaux de Karnaugh
        ' Si (codePresence <> 1) OU ((codePresence = 1) ET ((typePosCurseur = 4) OU (typePosCurseur = 5))) Alors
        Select Case conVrai
            Case (lngCodePresence <> 1), (lngTypePosCurseur = posDansProc), (lngTypePosCurseur = posFinModule)
                objCodeModule.InsertLines lngLigneCurseur, strEnTete & vbNewLine _
                                            & strContenu & vbNewLine & strPied
        End Select
        Set objCodeModule = Nothing
    End If
End Sub

' Fonction ajoutée par René Rhéaume le 12 avril 2002
' Fonction subordonnée à la nouvelle version de InsertCode
Private Function DeterminerPositionCurseur(ByVal lngLigneCurseur As Long) As TypePosition
    ' Si seulement on pouvait faire des tableaux de constantes avec VB
    Dim strarDebutProc(0 To 2) As String
    Dim strarFinProc(0 To 2) As String
    Dim lngNbLignesDeclar As Long
    Dim lngNoLignePremProc As Long
    Dim lngNoLigneDebProcAvant As Long, lngNoLigneFinProcAvant As Long
    Dim objCodeModule As VBIDE.CodeModule
    
    DeterminerPositionCurseur = 0
    Set objCodeModule = VBInstance.ActiveCodePane.CodeModule
    ' Gardez l'espace après pour rechercher le mor entier
    strarDebutProc(0) = "Sub "
    strarDebutProc(1) = "Function "
    strarDebutProc(2) = "Property "
    strarFinProc(0) = "End Sub"
    strarFinProc(1) = "End Function"
    strarFinProc(2) = "End Property"
    
    lngNbLignesDeclar = objCodeModule.CountOfDeclarationLines
    If (lngLigneCurseur <= lngNbLignesDeclar) Then
        DeterminerPositionCurseur = posDeclarations
    Else
        lngNoLignePremProc = ChercherCode(lngNbLignesDeclar + 1, enAvant, strarDebutProc)
'        MsgBox "lngNoLignePremProc  = " & lngNoLignePremProc & vbNewLine & _
                "lngLigneCurseur = " & lngLigneCurseur, vbInformation
        Select Case conVrai
            Case (lngNoLignePremProc = 0), (lngLigneCurseur < lngNoLignePremProc)
                DeterminerPositionCurseur = posPostDeclar
            Case Else
                If (lngLigneCurseur < objCodeModule.CountOfLines) Then
                    lngNoLigneDebProcAvant = ChercherCode(lngLigneCurseur, enArriere, strarDebutProc)
                    lngNoLigneFinProcAvant = ChercherCode(lngLigneCurseur, enArriere, strarFinProc)
                    If (lngNoLigneDebProcAvant > lngNoLigneFinProcAvant) Then
                        DeterminerPositionCurseur = posDansProc
                    Else
                        DeterminerPositionCurseur = posEntreDeuxProc
                    End If
                Else
                    DeterminerPositionCurseur = posFinModule
                End If
        End Select
    End If
    Set objCodeModule = Nothing
End Function

' Fonction ajoutée par René Rhéaume le 12 avril 2002
' Fonction subordonnée à DeterminerPositionCurseur
Private Function ChercherCode(ByVal lngDebut As Long, ByVal lngSens As Direction, strarTermes() As String) As Long
    Dim blnTrouve As Boolean
    Dim lngPremTerme As Long, lngDernTerme As Long, lngNoTerme As Long
    Dim lngPosCode As Long, lngPosAposthophe As Long, lngPosGuillemet As Long
    Dim lngNbLignes As Long
    Dim objCodeModule As VBIDE.CodeModule
    Dim strContenuLigne As String
    
    ChercherCode = lngDebut
    Set objCodeModule = VBInstance.ActiveCodePane.CodeModule
    lngNbLignes = objCodeModule.CountOfLines
    lngPremTerme = LBound(strarTermes)
    lngDernTerme = UBound(strarTermes)
    
    Do Until ((blnTrouve) Or (ChercherCode > lngNbLignes) Or (ChercherCode < 1))
        strContenuLigne = objCodeModule.Lines(ChercherCode, 1)
        lngNoTerme = lngPremTerme
        blnTrouve = conFaux
        Do Until ((blnTrouve) Or (lngNoTerme > lngDernTerme))
            lngPosCode = InStr(strContenuLigne, strarTermes(lngNoTerme))
            If (lngPosCode > 0) Then
                lngPosAposthophe = InStr(strContenuLigne, "'")
                lngPosGuillemet = InStr(strContenuLigne, conGlmt)
                Select Case conVrai
                    Case (lngPosAposthophe = 0), (lngPosAposthophe > lngPosCode), _
                            ((lngPosGuillemet > 0) And (lngPosGuillemet < lngPosAposthophe))
                        blnTrouve = conVrai
                End Select
            End If
            lngNoTerme = lngNoTerme + 1
        Loop
        ChercherCode = ChercherCode + lngSens
    Loop
    If (blnTrouve) Then
    ' Une fois que l'on a trouvé le bout de code recherché, il y a une
    ' incrémentation de trop. Réglons ça.
        ChercherCode = ChercherCode - 1
    Else
    ' Retournons comme InStr si ce n'a pas été trouvé
        ChercherCode = 0
    End If
    Set objCodeModule = Nothing
End Function

