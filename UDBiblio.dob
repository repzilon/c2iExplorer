Option Explicit
Private Const conNom As String = "Nom"
Private Const conDescription As String = "Description"
Private Const conDeclareProc As String = "DeclareProc"
Private Const conHeadProc As String = "HeadProc"
Private Const conInLineProc As String = "InLineProc"
Private Const conEndProc As String = "EndProc"
Private Const conWeb As String = "web"
Private Const conMail As String = "mail"
Private Const conBiblio As String = "biblio"
Private Const conNewdata As String = "newdata"
Private Const conSave As String = "save"
Private Const conNewbiblio As String = "newbiblio"
Private Const conNewcategorie As String = "newcategorie"
Private Const conDelete As String = "delete"
Private Const conVoir As String = "voir"
Private Const conCopie As String = "copie"
Private Const conExtBD As String = ".mdb"
Private Const conFiltreBD As String = "Bases de données (*.mdb)|*.mdb"
Private Const conDossierData As String = "\data"
Private Const conRSElements As String = "Elements"
Public bFrmBiblio As Boolean
Public TVEx As TreeView

Private Sub Enregistrement(ByVal sFile As String)
    Const conExtBak As String = ".bak"
    Dim db As Database, rs As Recordset
    Dim mNode As Node, objE As cElement
    
    On Error GoTo RestaurerSauvegarde
    'Modifié par René Rhéaume, 29 juillet 2001
    If (FichierExiste(sFile)) Then
        'Copie de sauvegarde du fichier
        FileCopy sFile, sFile & conExtBak
        'destruction du fichier
        Kill sFile
    End If
    'copie du fichier de base
    FileCopy c2iDataFileNameOrigine, sFile

    On Error GoTo Fin
    Set db = OpenDatabase(sFile)
    Set rs = db.OpenRecordset(conRSElements, dbOpenDynaset)
    For Each mNode In tv.Nodes
        Select Case mNode.Image
            Case conElement
                rs.AddNew
                Set objE = Explorer.Elements(mNode.FullPath)
                rs.Fields(conNom) = objE.Nom
                rs.Fields(conDescription) = objE.Description
                rs.Fields(conDeclareProc) = objE.DeclareProc
                rs.Fields(conHeadProc) = objE.HeadProc
                rs.Fields(conInLineProc) = objE.InLineProc
                rs.Fields(conEndProc) = objE.EndProc
                rs.Update
            Case conWeb
                rs.AddNew
                Set objE = Explorer.Elements(mNode.FullPath)
                rs.Fields(conNom) = objE.Nom
                rs.Fields(conDescription) = objE.Description
                rs.Update
            Case conMail
                rs.AddNew
                Set objE = Explorer.Elements(mNode.FullPath)
                rs.Fields(conNom) = objE.Nom
                rs.Fields(conDescription) = objE.Description
                rs.Update
        End Select
    Next
    If FichierExiste(sFile & conExtBak) Then Kill sFile & conExtBak
    
SortieFunc:
    rs.Close
    db.Close
    Set rs = Nothing
    Set db = Nothing
    Exit Sub
RestaurerSauvegarde:
    MsgBox "Il y a eu une erreur lors de l'initialisation de la sauvegarde." & vbCrLf & _
            "c2iExplorer a cependant peut-être créé un fichier de sauvegarde sous le nom de" & vbCrLf & _
            sFile & conExtBak & " ." & vbCrLf & _
            conErrNo & Err.Number & vbCrLf & Err.Description & vbCrLf & Err.Source, vbExclamation
    Resume SortieFunc
Fin:
    MsgBox conErrNo & Err.Number & vbCrLf & Err.Description & vbCrLf & Err.Source, vbExclamation
    Resume SortieFunc
End Sub

Private Sub ValideInsertion(ByVal objE As cElement)
    Dim sDP As String, sH As String, sI As String, sE As String

    If (tbMain.Buttons(conDeclareProc).Value = tbrPressed) Then
        sDP = objE.DeclareProc
    End If
    If (tbMain.Buttons(conHeadProc).Value = tbrPressed) Then
        sH = objE.HeadProc
    End If
    If (tbMain.Buttons(conInLineProc).Value = tbrPressed) Then
        sI = objE.InLineProc
    End If
    If (tbMain.Buttons(conEndProc).Value = tbrPressed) Then
        sE = objE.EndProc
    End If

    InsertCode sDP, sH, sI, sE
End Sub

Private Sub tv_DblClick()
    tbMain_ButtonClick tbMain.Buttons(conCopie)
End Sub

Private Sub tv_NodeClick(ByVal Node As MSComctlLib.Node)
    Dim objE As cElement

    On Error Resume Next
    Select Case Node.Image
        Case conElement
            Set objE = Explorer.Elements(Node.FullPath)
            'Optimisation par René Rhéaume 2 septembre 2001
            'Ne fonctionnerait pas sous .net car conVrai = 1 sur .net
            'alors que dans VB 5/6, conVrai = -1
            'Équivalent à :
'            If Trim$(objE.DeclareProc) = vbNullString Then
'                tbMain.Buttons(conDeclareProc).Value = tbrUnpressed
'            Else
'                tbMain.Buttons(conDeclareProc).Value = tbrPressed
'            End If
'            .
'            .
'            .
            With tbMain
                .Buttons(conDeclareProc).Value = (Trim$(objE.DeclareProc) = vbNullString) + 1
                .Buttons(conHeadProc).Value = (Trim$(objE.HeadProc) = vbNullString) + 1
                .Buttons(conInLineProc).Value = (Trim$(objE.InLineProc) = vbNullString) + 1
                .Buttons(conEndProc).Value = (Trim$(objE.EndProc) = vbNullString) + 1
            End With
            'mise à jour de l'affichage du détail
            If (bFrmBiblio) Then
                Set frmBiblio.Element = objE
            End If
        Case Else
            With tbMain
                .Buttons(conDeclareProc).Value = tbrUnpressed
                .Buttons(conHeadProc).Value = tbrUnpressed
                .Buttons(conInLineProc).Value = tbrUnpressed
                .Buttons(conEndProc).Value = tbrUnpressed
            End With
    End Select
End Sub

Private Sub UserDocument_Initialize()
    'Modifié par rené Rhéaume 29 juillet 2001
    c2iCurrentDataFileName = LireChaineFichierINI(conSecGen, conValData, vbNullString, c2iINIFile)
    'Fin de modification
    
    MakeToolBar
    bFrmBiblio = conFaux

    If (c2iCurrentDataFileName <> vbNullString) Then
        ChargeBase c2iCurrentDataFileName
    End If
    
    UserDocument_Resize
    Set TVEx = tv
End Sub

Private Sub RempliTV()
    Dim objElement As cElement

    For Each objElement In Explorer.Elements
        AddElement objElement
    Next
    Set objElement = Nothing
End Sub

Public Sub AddElement(ByVal objElement As cElement)
    Dim iNum As Long
    Dim mNodeParent As Node, mNodeNewRep As Node, sM As String

    On Error Resume Next
    For iNum = 0 To objElement.Ident - 1
        sM = objElement.CheminComplet(iNum)
        Set mNodeNewRep = Nothing
        Set mNodeNewRep = tv.Nodes(sM)
        If (mNodeNewRep Is Nothing) Then
            If (iNum = 0) Then
                Set mNodeParent = tv.Nodes.Add(, , sM, sM, conBiblio)
            Else
                Set mNodeParent = tv.Nodes.Add(mNodeParent, tvwChild, sM, objElement.NomRepertoire(iNum), "categorie")
            End If
        Else
            Set mNodeParent = mNodeNewRep
        End If
    Next
    'Optimisation par René Rhéaume 2 septembre 2001
    Select Case objElement.Titre
        Case "[Web Site]"
            tv.Nodes.Add mNodeParent, tvwChild, objElement.Nom, objElement.Titre, conWeb
        Case "[Mail]"
            tv.Nodes.Add mNodeParent, tvwChild, objElement.Nom, objElement.Titre, conMail
        Case Else
            tv.Nodes.Add mNodeParent, tvwChild, objElement.Nom, objElement.Titre, conElement
    End Select
    Set mNodeParent = Nothing
    Set mNodeNewRep = Nothing
End Sub

' Note par René Rhéaume le 7 janvier 2002 :
' Nouvel algorithme demandé
' 17 janvier 2002 :
' Description de la procédure :
' BUT : Insérer le code défini par les quatre sections : déclarations,
' en-tête, corps, pied.
' S'il y a un module actif, Alors obtenir sa sélection ainsi que le type
' de la procédure sélectionnée.
'   S'il n'y a pas de procédure à cet endroit OU Si la procédure n'est
'   pas une propriété ET que le numéro de ligne du début de la sélection
'   est <= à la ligne où est située la procédure, Alors insérer le code
'   tout de suite après la section (Déclarations).
'   Sinon, placer dans une variable la ligne où du début de la procédure
'   ou de la propriété, chercher la fin de la procédure
Private Sub InsertCode(ByVal sDeclare As String, ByVal sHead As String, ByVal sInLine As String, ByVal sEnd As String)
    Dim objCodeModule As VBIDE.CodeModule
    Dim lngStartLine As Long, lngStartColumn As Long, lngEndLine As Long, lngEndColumn As Long
    Dim objMember As VBIDE.Member
    Dim lngLine As Long, bTrouve As Boolean, sTexte As String
    Dim lngCodeLocation As Long
    Dim lngNbLignesDeclar As Long

    On Error Resume Next
    If (VBInstance.ActiveCodePane.CodeModule Is Nothing) Then
        MsgBox "Il n'y a pas de module actif"
        Exit Sub
    End If
    Set objCodeModule = VBInstance.ActiveCodePane.CodeModule

    'détermination du membre
    objCodeModule.CodePane.GetSelection lngStartLine, lngStartColumn, lngEndLine, lngEndColumn
    On Error Resume Next
    Set objMember = objCodeModule.Members(objCodeModule.ProcOfLine(lngStartLine, vbext_pk_Proc))
    Select Case conFaux
        Case objMember.Type <> vbext_mt_Property, lngStartLine <= objMember.CodeLocation
        Case Else
            Err.Raise 13
    End Select
    If (Err.Number <> 0) Then
        With objCodeModule
            .InsertLines .CountOfDeclarationLines + 1, sDeclare
            lngNbLignesDeclar = .CountOfDeclarationLines
            .InsertLines lngNbLignesDeclar + .CountOfLines + 1, sHead
            .InsertLines lngNbLignesDeclar + .CountOfLines + 1, sInLine
            .InsertLines lngNbLignesDeclar + .CountOfLines + 1, sEnd
        End With
        Exit Sub
    End If
    
    On Error GoTo 0
    If (objMember.Type = vbext_mt_Property) Then
        lngCodeLocation = lngStartLine
        TypePropriete objCodeModule, lngCodeLocation
    Else
        lngCodeLocation = objMember.CodeLocation
    End If
'    MsgBox lngCodeLocation & vbTab & lngStartLine & vbTab & objMember.CodeLocation

    'on détermine si on est a la fin du code
    lngLine = lngCodeLocation + 1
    bTrouve = conFaux
    On Error Resume Next
    Err.Clear
    
    Do Until ((bTrouve) Or (lngLine > objCodeModule.CountOfLines))
        sTexte = objCodeModule.Lines(lngLine, 1)
        If Err.Number <> 0 Then Exit Do
        Select Case conVrai
            Case RechercheString(sTexte, "End Sub"), RechercheString(sTexte, "End Function"), RechercheString(sTexte, "End Property")
                bTrouve = conVrai
            Case Else
                lngLine = lngLine + 1
        End Select
    Loop
    
    On Error GoTo 0
    'Insertion de la déclaration
    If (Trim$(sDeclare) <> vbNullString) Then
        objCodeModule.InsertLines objCodeModule.CountOfDeclarationLines + 1, sDeclare
    End If

    'Insertion du HEAD
    'redétermination du début
    If (objMember.Type = vbext_mt_Property) Then
        lngCodeLocation = lngStartLine
        TypePropriete objCodeModule, lngCodeLocation
    Else
        lngCodeLocation = objMember.CodeLocation
    End If
'    MsgBox lngCodeLocation & vbTab & lngStartLine & vbTab & objMember.CodeLocation

    If (Trim$(sHead) <> vbNullString) Then
        If (bTrouve) Then
            objCodeModule.InsertLines lngCodeLocation + 1, sHead
        Else
            objCodeModule.InsertLines objCodeModule.CountOfLines + 1, sHead
        End If
    End If

    'Insertion du InLine
    If (Trim$(sInLine) <> vbNullString) Then
        If bTrouve Then
            objCodeModule.CodePane.GetSelection lngStartLine, lngStartColumn, lngEndLine, lngEndColumn
            objCodeModule.InsertLines lngStartLine, sInLine
        Else
            objCodeModule.InsertLines objCodeModule.CountOfLines + 1, sInLine
        End If
    End If

    'Insertion du End
    'redétermination du début
    If (objMember.Type = vbext_mt_Property) Then
        lngCodeLocation = lngStartLine
        TypePropriete objCodeModule, lngCodeLocation
    Else
        lngCodeLocation = objMember.CodeLocation
    End If
'    MsgBox lngCodeLocation & vbTab & lngStartLine & vbTab & objMember.CodeLocation

    If (Trim$(sEnd) <> vbNullString) Then
        If (bTrouve) Then
            lngLine = lngCodeLocation + 1
            bTrouve = conFaux
            On Error Resume Next
            Err.Clear
            Do Until (bTrouve)
                sTexte = objCodeModule.Lines(lngLine, 1)
                If Err.Number <> 0 Then Exit Do
                Select Case conVrai
                    Case RechercheString(sTexte, "End Sub"), RechercheString(sTexte, "End Function"), RechercheString(sTexte, "End Property")
                        bTrouve = conVrai
                    Case Else
                        lngLine = lngLine + 1
                End Select
            Loop
            objCodeModule.InsertLines lngLine, sEnd
        Else
            objCodeModule.InsertLines objCodeModule.CountOfLines + 1, sEnd
        End If
    End If

    Set objCodeModule = Nothing
    Set objMember = Nothing
End Sub

' Optimisé par René Rhéaume 2 septembre 2001
' 5 janvier 2002 : nouvel algorithme demandé
Public Sub TypePropriete(ByVal objCodeModule As VBIDE.CodeModule, ByRef lngStartLine As Long)
    'retourne la ligne de début de la propriété
    Dim lngDummy As Long, bTrouve As Boolean, sTexte As String
    'on stocke la valeur initiale
    lngDummy = lngStartLine

    bTrouve = conFaux
    On Error Resume Next
    Do Until bTrouve
        sTexte = objCodeModule.Lines(lngStartLine, 1)
        If Err.Number <> 0 Then Exit Do
        If lngStartLine > objCodeModule.CountOfLines Then Exit Do
        ' Si sTexte contient soit "Property Let", "Property Get" ou "Property Set"
        Select Case conVrai
            Case InStr(1, sTexte, "Property Let") > 0, InStr(1, sTexte, "Property Get") > 0, InStr(1, sTexte, "Property Set") > 0
                If Left$(sTexte, 1) <> "'" Then
                    bTrouve = conVrai
                    Exit Do
                End If
        End Select
        If RechercheString(sTexte, "End Property") Then
            bTrouve = conFaux
            Exit Do
        End If
        lngStartLine = lngStartLine + 1
    Loop
    'si bTrouve, on se casse
    If bTrouve Then Exit Sub
    'sinon, il faut faire une recherche arrière
    lngStartLine = lngDummy                                'on recommence du début
    Do Until bTrouve
        sTexte = objCodeModule.Lines(lngStartLine, 1)
        If Err.Number <> 0 Then Exit Do
        ' Si sTexte contient soit "Property Let", "Property Get" ou "Property Set"
        Select Case conVrai
            Case InStr(1, sTexte, "Property Let") > 0, InStr(1, sTexte, "Property Get") > 0, InStr(1, sTexte, "Property Set") > 0
                If Left$(sTexte, 1) <> "'" Then
                    bTrouve = conVrai
                    Exit Do
                End If
        End Select
        If RechercheString(sTexte, "End Property") Then
            lngStartLine = lngStartLine + 1
            Exit Do
        End If
        lngStartLine = lngStartLine - 1
    Loop

End Sub

Private Sub MakeToolBar()

    Dim objButton As Button

    With tbMain
        Set .ImageList = imgTB
        Set .HotImageList = imgTB
                
        Set objButton = .Buttons.Add(, conNewdata, , , conNewdata)
        Set objButton = .Buttons.Add(, conBiblio, , , conBiblio)
        Set objButton = .Buttons.Add(, conSave, , , conSave)
        Set objButton = .Buttons.Add(, , , tbrSeparator)
        
        Set objButton = .Buttons.Add(, conNewbiblio, , , conNewbiblio)
        Set objButton = .Buttons.Add(, conNewcategorie, , , conNewcategorie)
        Set objButton = .Buttons.Add(, , , tbrSeparator)
        
        Set objButton = .Buttons.Add(, conDelete, , , conDelete)
        Set objButton = .Buttons.Add(, , , tbrSeparator)
        
        Set objButton = .Buttons.Add(, conVoir, , , conVoir)
        Set objButton = .Buttons.Add(, conCopie, , , conCopie)
        Set objButton = .Buttons.Add(, , , tbrSeparator)
        
        Set objButton = .Buttons.Add(, conDeclareProc, , tbrCheck, conDeclareProc)
        Set objButton = .Buttons.Add(, conHeadProc, , tbrCheck, conHeadProc)
        Set objButton = .Buttons.Add(, conInLineProc, , tbrCheck, conInLineProc)
        Set objButton = .Buttons.Add(, conEndProc, , tbrCheck, conEndProc)
        Set objButton = .Buttons.Add(, , , tbrSeparator)
        

        'Set objButton = .Buttons.Add(, , , tbrSeparator)
        'Set objButton = .Buttons.Add(, "export", , , "export")
        'Set objButton = .Buttons.Add(, "import", , , "import")
        'Set objButton = .Buttons.Add(, , , tbrSeparator)


        Select Case lngLanguage
            Case c2i_Langue_Anglais
                .Buttons(conNewdata).ToolTipText = "New database"
                .Buttons(conBiblio).ToolTipText = "Load a database"
                .Buttons(conSave).ToolTipText = "Save database"
                
                .Buttons(conNewbiblio).ToolTipText = "Create a new library"
                .Buttons(conNewcategorie).ToolTipText = "Create a new folder"

                .Buttons(conDelete).ToolTipText = conDelete

                .Buttons(conVoir).ToolTipText = "View/Add element"
                .Buttons(conCopie).ToolTipText = "Insert code"
                
                .Buttons(conDeclareProc).ToolTipText = "Insert declaration code"
                .Buttons(conHeadProc).ToolTipText = "Insert head code"
                .Buttons(conInLineProc).ToolTipText = "Insert inline code"
                .Buttons(conEndProc).ToolTipText = "Insert end code"
                
                '.Buttons("export").ToolTipText = "Export"
                '.Buttons("import").ToolTipText = "Import"
            Case Else
                .Buttons(conNewdata).ToolTipText = "Nouvelle base de données"
                .Buttons(conBiblio).ToolTipText = "Charger une base de données"
                .Buttons(conSave).ToolTipText = "Sauvegarder la base de données"
                
                .Buttons(conNewbiblio).ToolTipText = "Créer une bibliothèque"
                .Buttons(conNewcategorie).ToolTipText = "Créer une catégorie"

                .Buttons(conDelete).ToolTipText = "Supprimer"
                
                .Buttons(conVoir).ToolTipText = "Voir/ajouter un élément"
                .Buttons(conCopie).ToolTipText = "Insérer le code"

                .Buttons(conDeclareProc).ToolTipText = "Insérer le code des déclarations"
                .Buttons(conHeadProc).ToolTipText = "Insérer le code de début de procédure"
                .Buttons(conInLineProc).ToolTipText = "Insérer le code interne"
                .Buttons(conEndProc).ToolTipText = "Insérer le code de fin deprocédure"

                '.Buttons("export").ToolTipText = "Exporter"
                '.Buttons("import").ToolTipText = "Importer"
        End Select
    End With

    Set objButton = Nothing
End Sub

Private Sub tbMain_ButtonClick(ByVal Button As MSComctlLib.Button)
    Dim objE As cElement

    On Error Resume Next
    Select Case Button.Key
        Case conNewdata
            If (tv.Nodes.Count > 0) Then
                If (LenB(c2iCurrentDataFileName) > 0) Then
                    Enregistrement c2iCurrentDataFileName
                Else
                    SaveLibrary
                End If
            End If
            tv.Nodes.Clear
            c2iCurrentDataFileName = vbNullString
        Case conBiblio
            OpenBiblio
        Case conNewbiblio
            AddBiblio
        Case conNewcategorie
            AddCategorie
        Case conDelete
            If tv.SelectedItem Is Nothing Then Exit Sub
            DeleteNode
        Case conCopie
            If (Not tv.SelectedItem Is Nothing) Then
                Select Case tv.SelectedItem.Image
                    Case conElement
                        Set objE = Explorer.Elements(tv.SelectedItem.FullPath)
                        ValideInsertion objE
                        Set objE = Nothing
                    Case conWeb
                        ConnectionInternet Explorer.Elements(tv.SelectedItem.FullPath).Description
                    Case conMail
                        MailInternet Explorer.Elements(tv.SelectedItem.FullPath).Description
                End Select
            End If
        Case conVoir
            If (Not tv.SelectedItem Is Nothing) Then
                Select Case tv.SelectedItem.Image
                    Case conElement
                        Load frmBiblio
                        Set frmBiblio.Element = Explorer.Elements(tv.SelectedItem.FullPath)
                        bFrmBiblio = conVrai
                        frmBiblio.Show
                    Case conWeb                             'connexion Internet
                        ConnectionInternet Explorer.Elements(tv.SelectedItem.FullPath).Description
                    Case conMail
                        MailInternet Explorer.Elements(tv.SelectedItem.FullPath).Description
                    Case Else
                        Load frmBiblio
                        Set frmBiblio.Element = Nothing
                        bFrmBiblio = conVrai
                        frmBiblio.Show
                End Select
            End If
        Case conSave
            SaveLibrary
    End Select
End Sub

Private Sub MailInternet(ByVal sMail As String)
    Dim lngRep As Long
    lngRep = ShellExecute(0, "open", "mailto:" + sMail, vbNullString, vbNullString, SW_NORMAL)
    If (lngRep = 0) Then
        Select Case lngLanguage
            Case c2i_Langue_Anglais
                MsgBox "Impossible to connect to Internet", vbInformation
            Case Else
                MsgBox "Impossible d'établir la connection Internet", vbInformation
        End Select
    End If

End Sub

'Fonction modifiée par René Rhéaume, 29 juillet 2001
'Renvoie 0 s'il n'y a pas d'erreur, 1 si l'erreur provient de l'absence
'de nom de fichier dans la boîte de dialogue ou 2 dans le cas d'une autre
'erreur.
Private Function SaveLibrary() As Byte
    On Error GoTo Fin
    Dim cCommonDialog As cDlgCom
    Set cCommonDialog = New cDlgCom
    With cCommonDialog
        .DefaultEx = conExtBD
        .Filter = conFiltreBD
        .FilterIndex = 1
        .Filename = c2iCurrentDataFileName
        .Flags = OFN_HIDEREADONLY + OFN_NOREADONLYRETURN
        .InitDir = strCheminApp & conDossierData
        .ShowSave
        If .Filename = vbNullString Then
            SaveLibrary = 1
        Else
            Enregistrement .Filename
            c2iCurrentDataFileName = .Filename
            SaveLibrary = 0
        End If
    End With
    Set cCommonDialog = Nothing
    Exit Function
    
Fin:
    Set cCommonDialog = Nothing
    SaveLibrary = 2
    Exit Function
End Function

Private Sub DeleteNode()
    tv.Nodes.Remove tv.SelectedItem.Key
End Sub

'Fonction modifiée par René Rhéaume, 29 juillet 2001
'Renvoie 0 s'il n'y a pas d'erreur, 1 si l'erreur provient de l'absence
'de nom de fichier dans la boîte de dialogue ou 2 dans le cas d'une autre
'erreur.
Private Function OpenBiblio() As Byte
    On Error GoTo Fin
    Dim cCommonDialog As cDlgCom
    Set cCommonDialog = New cDlgCom
    With cCommonDialog
        .DefaultEx = conExtBD
        .Filter = conFiltreBD
        .FilterIndex = 1
        .Filename = c2iCurrentDataFileName
        .Flags = OFN_HIDEREADONLY + OFN_PATHMUSTEXIST + OFN_FILEMUSTEXIST + OFN_EXPLORER + OFN_LONGNAMES
        .InitDir = strCheminApp & conDossierData
        .ShowOpen
        If .Filename = vbNullString Then
            OpenBiblio = 1
        Else
            OpenBiblio = 0
            ChargeBase .Filename
            c2iCurrentDataFileName = .Filename
        End If
    End With
    Set cCommonDialog = Nothing
    Exit Function
    
Fin:
    Set cCommonDialog = Nothing
    OpenBiblio = 2
    Exit Function
End Function

Private Sub ChargeBase(ByVal sFileName As String)
    tv.Nodes.Clear

    On Error GoTo GestErr
    'destruction de la hiérarchie
    Set Explorer = Nothing
    Set Explorer = New cExplorer

    Dim db As DAO.Database
    Dim rs As DAO.Recordset

    Set db = OpenDatabase(sFileName)
    Set rs = db.OpenRecordset(conRSElements, dbOpenDynaset)
    Do Until rs.EOF
        Explorer.Elements.Add AnnuleNull(rs, conDeclareProc), AnnuleNull(rs, conHeadProc), AnnuleNull(rs, conInLineProc), AnnuleNull(rs, conEndProc), AnnuleNull(rs, conDescription), AnnuleNull(rs, conNom), AnnuleNull(rs, conNom)
        rs.MoveNext
    Loop
    
    rs.Close
    Set rs = Nothing
    db.Close
    Set db = Nothing
    'on lance le remplissage de la bibliothèque
    RempliTV
    Exit Sub

GestErr:
    Set rs = Nothing
    If (Not db Is Nothing) Then
        db.Close
    End If
    Set db = Nothing
    If (lngLanguage = c2i_Langue_Anglais) Then
        MsgBox "Error in loading database", vbExclamation, "c2iExplorer : Library"
    Else
        MsgBox "Erreur dans le chargement de la base", vbExclamation, "c2iExplorer : Bibliothèque"
    End If
    MsgBox conErrNo & Err.Number & vbCrLf & Err.Description & vbCrLf & Err.Source, vbExclamation
    'destruction de la hiérarchie
    Set Explorer = Nothing
    Set Explorer = New cExplorer
End Sub

Private Function AnnuleNull(rs As Recordset, sField As String) As String
    If (IsNull(rs.Fields(sField))) Then
        AnnuleNull = vbNullString
    Else
        AnnuleNull = rs.Fields(sField)
    End If
End Function

Private Sub AddBiblio()
    Dim sTitle As String, sMessage As String, sM2 As String
    Dim sResult As String

    sTitle = conNomApp
    Select Case lngLanguage
        Case c2i_Langue_Anglais
            sMessage = "Input the name of the new library"
            sM2 = "Impossible, this library is still used"
        Case Else
            sMessage = "Saisissez le nom de la nouvelle bibliothèque"
            sM2 = "Impossible, cette bibliothèque existe déjà"
    End Select

    sResult = InputBox(sMessage, sTitle)

    Dim mNode As Node
    On Error Resume Next
    Set mNode = tv.Nodes(sResult)
    If (mNode Is Nothing) Then
        If (Trim$(sResult) <> vbNullString) Then
            On Error GoTo Fin
            tv.Nodes.Add , , sResult, sResult, conBiblio
        End If
    Else
        MsgBox sM2, , sTitle
    End If
    Set mNode = Nothing

    Exit Sub
Fin:
    Set mNode = Nothing
    Select Case lngLanguage
        Case c2i_Langue_Anglais
            MsgBox "The library name is invalid", vbInformation
        Case Else
            MsgBox "Le nom de la bibliothèque n'est pas correct", vbInformation
    End Select
End Sub

Private Sub AddCategorie()
    Dim sMessage As String, sM2 As String
    Dim sResult As String

    If (tv.SelectedItem Is Nothing) Then Exit Sub

    If (tv.SelectedItem.Image <> conElement) Then
        Select Case lngLanguage
            Case c2i_Langue_Anglais
                sMessage = "Input the name of the new folder"
                sM2 = "Impossible, this folder is still used"
            Case Else
                sMessage = "Saisissez le nom de la nouvelle catégorie"
                sM2 = "Impossible, cette catégorie existe déjà"
        End Select

        sResult = InputBox(sMessage, conNomApp)
        If (sResult = vbNullString) Then Exit Sub

        Dim mNode As Node
        On Error Resume Next
        Set mNode = tv.Nodes(tv.SelectedItem.Key + tv.PathSeparator + sResult)
        If (mNode Is Nothing) Then
            tv.Nodes.Add tv.SelectedItem, tvwChild, tv.SelectedItem.Key + tv.PathSeparator + sResult, sResult, "categorie"
        Else
            MsgBox sM2, , conNomApp
        End If
    Else
        If lngLanguage = c2i_Langue_Anglais Then
            MsgBox "Select a library or a folder to add a folder", vbInformation, conNomApp
        Else
            MsgBox "Sélectionnez une bibliothèque ou une catégorie pour ajouter une catégorie", vbInformation, conNomApp
        End If
    End If

End Sub

Private Sub UserDocument_Paint()
    UserDocument_Resize
End Sub

Private Sub UserDocument_Resize()
    Dim sngLargeurBOutils As Single
    sngLargeurBOutils = tbMain.Width
    On Error Resume Next
    tv.Height = ScaleHeight
    tv.Top = 0
    tv.Left = sngLargeurBOutils
    tv.Width = ScaleWidth - sngLargeurBOutils
End Sub

Private Sub UserDocument_Terminate()
    Set TVEx = Nothing
End Sub

