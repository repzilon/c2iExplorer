' Procédure modifiée par René Rhéaume le 24 avril 2002
' Plus d'appels de procédure pour clarifier
Private Sub tbMain_ButtonClick(ByVal Button As MSComctlLib.Button)
    On Error Resume Next
    Select Case Button.Key
        Case conNewdata
            GererBoutonNouvBD
        Case conBiblio
            OpenBiblio
        Case conNewbiblio
            AddBiblio
        Case conNewcategorie
            AddCategorie
        Case conDelete
            If (Not tv.SelectedItem Is Nothing) Then
                DeleteNode
            End If
        Case conCopie
            If (Not tv.SelectedItem Is Nothing) Then
                GererBoutonCopie
            End If
        Case conVoir
            If (Not tv.SelectedItem Is Nothing) Then
                GererBoutonVoir
            End If
        Case conSave
            SauvegarderBibliotheque conVrai, c2iCurrentDataFileName
    End Select
End Sub

'Fonction modifiée par René Rhéaume, 29 juillet 2001
'Renvoie 0 s'il n'y a pas d'erreur, 1 si l'erreur provient de l'absence
'de nom de fichier dans la boîte de dialogue ou 2 dans le cas d'une autre
'erreur.
'Fonction renommée et modifiée par René Rhéaume le 23 mars 2003
' réorganisation du code de sauvegarde
Private Function ObtenirNomFichier(ByVal strNomFichier As String, _
Optional ByVal blnOuvrir As Boolean = conFaux) As String
    Dim cCommonDialog As cDlgCom
    Dim strNouvNomFichier As String
    On Error GoTo Fin
    Set cCommonDialog = New cDlgCom
    With cCommonDialog
        .DefaultEx = conExtBD
        .Filter = strFiltreBD
        .FilterIndex = 1
        .Filename = strNomFichier
        .InitDir = strCheminApp & conDossierData
        If (blnOuvrir) Then
            .Flags = conFanionsOuvrir
            .ShowOpen
        Else
            .Flags = OFN_HIDEREADONLY + OFN_NOREADONLYRETURN + OFN_OVERWRITEPROMPT
            .ShowSave
        End If
        strNouvNomFichier = .Filename
    End With
    If (LenB(strNouvNomFichier) > 0) Then
        ObtenirNomFichier = strNouvNomFichier
    End If
    Set cCommonDialog = Nothing
    Exit Function

Fin:
    Set cCommonDialog = Nothing
    ObtenirNomFichier = vbNullString
End Function

' Modifié par René Rhéaume le 19 octobre 2002
'  Supprime également l'élément de la collection.
'  Corrige un bogue qui empêchait d'ajouter un élément
'  du même nom qu'un élément effacé auparavant.
' Modifié par René Rhéaume le 5 avril 2003
'  Supprime aussi les éléments dans les catégories
'  Notifie aussi pour la sauvegarde
Private Sub DeleteNode()
    With tv.SelectedItem
        Select Case .Image
            Case conElement, conWeb, conMail
                ElementsBiblio.Remove .Key
            Case conBiblio, "categorie"
                Do Until (.Children = 0)
                    ElementsBiblio.Remove .Child.Key
                    tv.Nodes.Remove .Child.Key
                Loop
        End Select
        tv.Nodes.Remove .Key
        blnModifie = conVrai
    End With
End Sub

'Fonction modifiée par René Rhéaume, 29 juillet 2001
'Renvoie 0 s'il n'y a pas d'erreur, 1 si l'erreur provient de l'absence
'de nom de fichier dans la boîte de dialogue ou 2 dans le cas d'une autre
'erreur.
'Procédure modifiée par René Rhéaume, 23 mars 2003
' simplification en utilisant ObtenirNomFichier
' invite de sauvegarde si la bibliothèque à décharger a été modifiée
Private Sub OpenBiblio()
    Dim strBiblioAOuvrir As String
    
    If (SauvegarderAncienneBiblio(c2iCurrentDataFileName)) Then
        strBiblioAOuvrir = ObtenirNomFichier(c2iCurrentDataFileName, conVrai)
        If (LenB(strBiblioAOuvrir) > 0) Then
            ChargeBase strBiblioAOuvrir
            c2iCurrentDataFileName = strBiblioAOuvrir
            blnModifie = conFaux
        End If
    End If
End Sub

'Procédure modifiée par René Rhéaume le 20 juin 2002
' Support multilingue
'Procédure optimisée par René Rhéaume le 5 juillet 2002
Private Sub ChargeBase(ByVal sFileName As String)
    Static mlgMsgErrChargeBase As String
    If (LenB(mlgMsgErrChargeBase) = 0) Then
        mlgMsgErrChargeBase = LireChaineLocalisee(conNomUD, _
            "Code.ChargeBase.mlgMsgErrChargeBase", "Erreur lors du chargement de la base")
    End If

    tv.Nodes.Clear

    On Error GoTo GestErr
    ViderElementsBiblio

    Dim db As DAO.Database
    Dim rs As DAO.Recordset

    Set db = OpenDatabase(sFileName)
    Set rs = db.OpenRecordset(conRSElements, dbOpenDynaset)
    Do Until rs.EOF
        ElementsBiblio.Add AnnuleNull(rs, conDeclareProc), AnnuleNull(rs, conHeadProc), _
                AnnuleNull(rs, conInLineProc), AnnuleNull(rs, conEndProc), _
                AnnuleNull(rs, conDescription), AnnuleNull(rs, conNom), AnnuleNull(rs, conNom)
        rs.MoveNext
    Loop

    rs.Close
    'on lance le remplissage de la bibliothèque
    RempliTV
    
SortieProc:
    Set rs = Nothing
    If (Not db Is Nothing) Then
        db.Close
    End If
    Set db = Nothing
    Exit Sub
GestErr:
    GererErrInattendue mlgMsgErrChargeBase, "UDBiblio.ChargeBase"
    ViderElementsBiblio
    Resume SortieProc
End Sub

Private Function AnnuleNull(rs As Recordset, sField As String) As String
    If (IsNull(rs.Fields(sField))) Then
        AnnuleNull = vbNullString
    Else
        AnnuleNull = rs.Fields(sField)
    End If
End Function

'Procédure modifiée par René Rhéaume le 20 juin 2002
' Support multilingue
Private Sub AddBiblio()
    Const conClefL10nBibl As String = "Code.AddBiblio."
    Static mlgarMsgBibl() As String
    Static blnLangOK As Boolean
    Dim I As Long
    If (Not blnLangOK) Then
        StrArray mlgarMsgBibl, "Saisissez le nom de la nouvelle bibliothèque :", _
            "Ce nom de bibliothèque est déjà utilisé.", _
            "Le nom de la bibliothèque n'est pas correct."
        If (blnMultilingueActive) Then
            For I = 0 To 2
                mlgarMsgBibl(I) = LireChaineLocalisee(conNomUD, _
                        conClefL10nBibl & "mlgarMsgBibl(" & I & conPF, mlgarMsgBibl(I))
            Next I
        End If
        blnLangOK = conVrai
    End If
    
    Dim sResult As String
    Dim mNode As Node
    sResult = Trim$(InputBox(mlgarMsgBibl(0)))
    
    On Error Resume Next
    Set mNode = tv.Nodes(sResult)
    If (mNode Is Nothing) Then
        If (LenB(sResult) > 0) Then
            On Error GoTo GestErr
            tv.Nodes.Add , , sResult, sResult, conBiblio
        End If
    Else
        MsgBox mlgarMsgBibl(1), vbInformation
    End If

SortieProc:
    Set mNode = Nothing
    Exit Sub
GestErr:
    MsgBox mlgarMsgBibl(2), vbInformation
    Resume SortieProc
End Sub

'Procédure modifiée par René Rhéaume le 18 juin 2002
' Optimisation de la lisibilité et de la vitesse (un peu)
'Procédure modifiée par René Rhéaume le 20 juin 2002
' Support multilingue
'Procédure modifiée par René Rhéaume le 23 février 2003
' On peut ajouter une catégorie si un élément est sélectionné.
' Il sera placé dans le même endroit que cet élément.
Private Sub AddCategorie()
    Const conClefL10nCat As String = "Code.AddCategorie."
    Static mlgarMsgCat() As String
    Static blnLangOK As Boolean
    Dim I As Long
    If (Not blnLangOK) Then
        StrArray mlgarMsgCat, "Saisissez le nom de la nouvelle catégorie :", _
            "Ce nom de catégorie est déjà utilisé."
        If (blnMultilingueActive) Then
            For I = 0 To 1
                mlgarMsgCat(I) = LireChaineLocalisee(conNomUD, _
                        conClefL10nCat & "mlgarMsgCat(" & I & conPF, mlgarMsgCat(I))
            Next I
        End If
        blnLangOK = conVrai
    End If
    
    Dim sResult As String
    Dim mNode As Node, nodBase As Node
    Dim strClef As String

    If (Not tv.SelectedItem Is Nothing) Then
        Set nodBase = tv.SelectedItem
        Select Case nodBase.Image
            Case conElement, conMail, conWeb
                Set nodBase = nodBase.Parent
        End Select
        
        sResult = Trim$(InputBox(mlgarMsgCat(0)))
        If (LenB(sResult) > 0) Then
            On Error Resume Next
            strClef = nodBase.Key & conSepChemBiblio & sResult
            Set mNode = tv.Nodes(strClef)
            If (mNode Is Nothing) Then
                tv.Nodes.Add nodBase, tvwChild, strClef, sResult, "categorie"
            Else
                MsgBox mlgarMsgCat(1), vbInformation
            End If
        End If
    End If
    Set mNode = Nothing
    Set nodBase = Nothing
End Sub

Private Sub UserDocument_Paint()
    UserDocument_Resize
End Sub

Private Sub UserDocument_Resize()
    Dim sngLargeurBOutils As Single
    sngLargeurBOutils = tbMain.Width
    On Error Resume Next
    tv.Height = ScaleHeight
    tv.Top = 0
    tv.Left = sngLargeurBOutils
    tv.Width = ScaleWidth - sngLargeurBOutils
End Sub

Private Sub UserDocument_Terminate()
    Set TVEx = Nothing
End Sub

'Procédure ajoutée par René Rhéaume le 24 avril 2002
' Pour alléger UDBiblio.tbMain_ButtonClick
'Procédure modifiée par René Rhéaume le 5 avril 2003
' Détruit aussi les objets dans la collection
Private Sub GererBoutonNouvBD()
    If (SauvegarderAncienneBiblio(c2iCurrentDataFileName)) Then
        tv.Nodes.Clear
        ViderElementsBiblio
        c2iCurrentDataFileName = vbNullString
        blnModifie = conFaux
    End If
End Sub

'Procédure ajoutée par René Rhéaume le 24 avril 2002
' Pour alléger UDBiblio.tbMain_ButtonClick
'Procédure optimisée par René Rhéaume le 17 janvier 2003
Private Sub GererBoutonCopie()
    Dim objE As cElement
    Dim strImage As String, strChemin As String
    
    With tv.SelectedItem
        strImage = .Image
        strChemin = .FullPath
    End With
    
    Select Case (strImage)
        Case conElement
            Set objE = ElementsBiblio(strChemin)
            ValideInsertion objE
            Set objE = Nothing
        Case conWeb, conMail
            ConnectionInternet ElementsBiblio(strChemin).Description, _
                IsSameString(strImage, conMail)
    End Select
End Sub

'Procédure ajoutée par René Rhéaume le 24 avril 2002
' Pour alléger UDBiblio.tbMain_ButtonClick
'Procédure optimisée par René Rhéaume le 13 janvier 2003
Private Sub GererBoutonVoir()
    Dim strImage As String
    Dim strChemin As String
    With tv.SelectedItem
        strImage = .Image
        strChemin = .FullPath
    End With
    Select Case (strImage)
        Case conWeb, conMail
            ConnectionInternet ElementsBiblio(strChemin).Description, _
                IsSameString(strImage, conMail)
        Case Else
            Load frmBiblio
            If (IsSameString(strImage, conElement)) Then
                Set frmBiblio.Element = ElementsBiblio(strChemin)
            Else
                Set frmBiblio.Element = Nothing
            End If
            bFrmBiblio = conVrai
            frmBiblio.Show
    End Select
End Sub

' Procédure ajoutée par René Rhéaume le 23 mars 2003
'  réorganisation de la sauvegarde
Public Sub SauvegarderBibliotheque(ByRef strNomFichier As String, _
Optional ByVal blnEnregistrerSous As Boolean = conFaux)
    Dim strNouvNomFichier As String
    Select Case conVrai
        Case blnEnregistrerSous, blnModifie
        Select Case conVrai
            Case blnEnregistrerSous, LenB(strNomFichier) = 0
                strNouvNomFichier = ObtenirNomFichier(strNomFichier)
                If (LenB(strNouvNomFichier) > 0) Then ' L'utilisateur n'a pas annulé
                    strNomFichier = strNouvNomFichier
                End If
        End Select
        ' La dernière condition évalue si un nom de fichier a été confirmé
        ' avec la boîte de dialogue Enregistrer sous
        If ((blnEnregistrerSous = conFaux) Or (strNouvNomFichier <> "")) Then
            EcrireBibliotheque strNomFichier
        End If
    End Select
End Sub

' Fonction ajoutée par René Rhéaume le 23 mars 2003
'  réorganisation de la sauvegarde
Public Function SauvegarderAncienneBiblio(ByRef strNomFichier As String) As Boolean
    Static mlgQuestion As String
    If (LenB(mlgQuestion) = 0) Then
        mlgQuestion = LireChaineLocalisee(conNomUD, _
            "Code.SauvegarderAncienneBiblio.mlgQuestion", _
            "Voulez-vous sauvegarder les modifications faites à cette bibliothèque ?")
    End If

    Dim strNouvNomFichier As String
    Dim lngAction As VbMsgBoxResult
    SauvegarderAncienneBiblio = conVrai
    
    If (blnModifie) Then
        lngAction = MsgBox(mlgQuestion, vbYesNoCancel + vbQuestion)
        Select Case lngAction
            Case vbYes
                If (LenB(strNomFichier) = 0) Then
                    strNouvNomFichier = ObtenirNomFichier(strNomFichier)
                    If (LenB(strNouvNomFichier) = 0) Then ' L'utilisateur a annulé
                        SauvegarderAncienneBiblio = conFaux
                    Else
                        strNomFichier = strNouvNomFichier
                    End If
                End If
                Select Case conVrai
                    Case LenB(strNomFichier) > 0, LenB(strNouvNomFichier) > 0
                        EcrireBibliotheque strNomFichier
                End Select
            Case vbCancel
                SauvegarderAncienneBiblio = conFaux
        End Select
    End If
End Function

' Procédure ajoutée par René Rhéaume le 5 avril 2003
Private Sub ViderElementsBiblio()
    Set ElementsBiblio = Nothing
    Set ElementsBiblio = New cElements
End Sub
