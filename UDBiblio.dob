Option Explicit
Public bFrmBiblio As Boolean
Public TVEx As TreeView

Private Sub Enregistrement(ByVal sFile As String)
    Dim db As Database, rs As Recordset
    Dim mNode As Node, objE As cElement
    
    On Error GoTo RestaurerSauvegarde
    'Modifié par René Rhéaume, 29 juillet 2001
    If FichierExiste(sFile) Then
        'Copie de sauvegarde du fichier
        FileCopy sFile, sFile & ".bak"
        'destruction du fichier
        Kill sFile
    End If
    'copie du fichier de base
    FileCopy c2iDataFileNameOrigine, sFile

    On Error GoTo Fin
    Set db = OpenDatabase(sFile)
    Set rs = db.OpenRecordset("Elements", dbOpenDynaset)
    For Each mNode In tv.Nodes
        Select Case mNode.Image
            Case "element"
                rs.AddNew
                Set objE = Explorer.Elements(mNode.FullPath)
                rs.Fields("Nom") = objE.Nom
                rs.Fields("Description") = objE.Description
                rs.Fields("DeclareProc") = objE.DeclareProc
                rs.Fields("HeadProc") = objE.HeadProc
                rs.Fields("InLineProc") = objE.InLineProc
                rs.Fields("EndProc") = objE.EndProc
                rs.Update
            Case "web"
                rs.AddNew
                Set objE = Explorer.Elements(mNode.FullPath)
                rs.Fields("Nom") = objE.Nom
                rs.Fields("Description") = objE.Description
                rs.Update
            Case "mail"
                rs.AddNew
                Set objE = Explorer.Elements(mNode.FullPath)
                rs.Fields("Nom") = objE.Nom
                rs.Fields("Description") = objE.Description
                rs.Update
        End Select
    Next

    rs.Close
    db.Close
    Set rs = Nothing
    Set db = Nothing
    If FichierExiste(sFile & ".bak") Then Kill sFile & ".bak"

SortieFunc:
    Exit Sub
RestaurerSauvegarde:
    MsgBox "Il y a eu une erreur lors de l'initialisation de la sauvegarde." & vbCrLf & _
            "c2iExplorer a cependant peut-être créé un fichier de sauvegarde sous le nom de" & vbCrLf & _
            sFile & ".bak" & " ." & vbCrLf & _
            "Erreur no " & Err.Number & vbCrLf & Err.Description & vbCrLf & Err.Source, vbExclamation
    Resume SortieFunc
Fin:
    MsgBox "Erreur no " & Err.Number & vbCrLf & Err.Description & vbCrLf & Err.Source, vbExclamation
    rs.Close
    db.Close
    Set rs = Nothing
    Set db = Nothing
    Resume SortieFunc
End Sub

Private Sub ValideInsertion(ByVal objE As cElement)
    Dim sDP As String, sH As String, sI As String, sE As String

    If tbMain.Buttons("declareproc").Value = tbrPressed Then
        sDP = objE.DeclareProc
    End If
    If tbMain.Buttons("headproc").Value = tbrPressed Then
        sH = objE.HeadProc
    End If
    If tbMain.Buttons("inlineproc").Value = tbrPressed Then
        sI = objE.InLineProc
    End If
    If tbMain.Buttons("endproc").Value = tbrPressed Then
        sE = objE.EndProc
    End If

    InsertCode sDP, sH, sI, sE
End Sub

Private Sub tv_DblClick()
    tbMain_ButtonClick tbMain.Buttons("copie")
End Sub

Private Sub tv_NodeClick(ByVal Node As MSComctlLib.Node)
    Dim objE As cElement

    On Error Resume Next
    Select Case Node.Image
        Case "element"
            Set objE = Explorer.Elements(Node.FullPath)
            'Optimisation par René Rhéaume 2 septembre 2001
            'Ne fonctionnerait pas sous .net car conVrai = 1 sur .net
            'alors que dans VB 5/6, conVrai = -1
            'Équivalent à :
'            If Trim$(objE.DeclareProc) = "" Then
'                tbMain.Buttons("declareproc").Value = tbrUnpressed
'            Else
'                tbMain.Buttons("declareproc").Value = tbrPressed
'            End If
'            .
'            .
'            .
            With tbMain
                .Buttons("declareproc").Value = (Trim$(objE.DeclareProc) = "") + 1
                .Buttons("headproc").Value = (Trim$(objE.HeadProc) = "") + 1
                .Buttons("inlineproc").Value = (Trim$(objE.InLineProc) = "") + 1
                .Buttons("endproc").Value = (Trim$(objE.EndProc) = "") + 1
            End With
            'mise à jour de l'affichage du détail
            If bFrmBiblio Then
                Set frmBiblio.Element = objE
            End If
        Case Else
            With tbMain
                .Buttons("declareproc").Value = tbrUnpressed
                .Buttons("headproc").Value = tbrUnpressed
                .Buttons("inlineproc").Value = tbrUnpressed
                .Buttons("endproc").Value = tbrUnpressed
            End With
    End Select
End Sub

Private Sub UserDocument_Initialize()
    'Modifié par rené Rhéaume 29 juillet 2001
    c2iCurrentDataFileName = LireChaineFichierINI("General", "Data", "", c2iINIFile)
    'Fin de modification
    
    MakeToolBar
    bFrmBiblio = conFaux

    If c2iCurrentDataFileName <> "" Then
        ChargeBase c2iCurrentDataFileName
    End If
    
    UserDocument_Resize
    Set TVEx = tv
End Sub

Private Sub RempliTV()
    Dim objElement As cElement

    For Each objElement In Explorer.Elements
        AddElement objElement
    Next
    Set objElement = Nothing
End Sub

Public Sub AddElement(ByVal objElement As cElement)
    Dim iNum As Long
    Dim mNodeParent As Node, mNodeNewRep As Node, sM As String

    On Error Resume Next
    For iNum = 0 To objElement.Ident - 1
        sM = objElement.CheminComplet(iNum)
        Set mNodeNewRep = Nothing
        Set mNodeNewRep = tv.Nodes(sM)
        If mNodeNewRep Is Nothing Then
            If iNum = 0 Then
                Set mNodeParent = tv.Nodes.Add(, , sM, sM, "biblio")
            Else
                Set mNodeParent = tv.Nodes.Add(mNodeParent, tvwChild, sM, objElement.NomRepertoire(iNum), "categorie")
            End If
        Else
            Set mNodeParent = mNodeNewRep
        End If
    Next
    'Optimisation par René Rhéaume 2 septembre 2001
    Select Case objElement.Titre
        Case "[Web Site]"
            tv.Nodes.Add mNodeParent, tvwChild, objElement.Nom, objElement.Titre, "web"
        Case "[Mail]"
            tv.Nodes.Add mNodeParent, tvwChild, objElement.Nom, objElement.Titre, "mail"
        Case Else
            tv.Nodes.Add mNodeParent, tvwChild, objElement.Nom, objElement.Titre, "element"
    End Select
    Set mNodeParent = Nothing

End Sub

Private Sub InsertCode(ByVal sDeclare As String, ByVal sHead As String, ByVal sInLine As String, ByVal sEnd As String)
    Dim objCodeModule As VBIDE.CodeModule
    Dim lngStartLine As Long, lngStartColumn As Long, lngEndLine As Long, lngEndColumn As Long
    Dim objMember As VBIDE.Member
    Dim lngLine As Long, bTrouve As Boolean, sTexte As String
    Dim lngCodeLocation As Long

    On Error Resume Next
    If VBInstance.ActiveCodePane.CodeModule Is Nothing Then
        MsgBox "Il n'y a pas de module actif"
        Exit Sub
    End If
    Set objCodeModule = VBInstance.ActiveCodePane.CodeModule

    'détermination du membre
    objCodeModule.CodePane.GetSelection lngStartLine, lngStartColumn, lngEndLine, lngEndColumn
    On Error Resume Next
    Set objMember = objCodeModule.Members(objCodeModule.ProcOfLine(lngStartLine, vbext_pk_Proc))
    Select Case conFaux
        Case objMember.Type <> vbext_mt_Property, lngStartLine <= objMember.CodeLocation
        Case Else
            Err.Raise 13
    End Select
    If Err.Number <> 0 Then
        objCodeModule.InsertLines objCodeModule.CountOfDeclarationLines + 1, sDeclare
        objCodeModule.InsertLines objCodeModule.CountOfDeclarationLines + 1, sHead
        objCodeModule.InsertLines objCodeModule.CountOfDeclarationLines + 1, sInLine
        objCodeModule.InsertLines objCodeModule.CountOfDeclarationLines + 1, sEnd
        Exit Sub
    End If

    If objMember.Type = vbext_mt_Property Then
        lngCodeLocation = lngStartLine
        TypePropriete objCodeModule, lngCodeLocation
    Else
        lngCodeLocation = objMember.CodeLocation
    End If

    'on détermine si on est a la fin du code
    lngLine = lngCodeLocation + 1
    bTrouve = conFaux
    On Error Resume Next
    Err.Clear
    Do Until bTrouve
        sTexte = objCodeModule.Lines(lngLine, 1)
        If Err.Number <> 0 Then Exit Do
        If lngLine > objCodeModule.CountOfLines Then Exit Do
        If RechercheString(sTexte, "End Sub") Then
            bTrouve = conVrai
            Exit Do
        End If
        If RechercheString(sTexte, "End Function") Then
            bTrouve = conVrai
            Exit Do
        End If
        If RechercheString(sTexte, "End Property") Then
            bTrouve = conVrai
            Exit Do
        End If
        lngLine = lngLine + 1
    Loop

    'Insertion de la déclaration
    If Trim$(sDeclare) <> "" Then
        objCodeModule.InsertLines objCodeModule.CountOfDeclarationLines + 1, sDeclare
    End If

    'Insertion du HEAD
    'redétermination du début
    If objMember.Type = vbext_mt_Property Then
        lngCodeLocation = lngStartLine
        TypePropriete objCodeModule, lngCodeLocation
    Else
        lngCodeLocation = objMember.CodeLocation
    End If

    If Trim$(sHead) <> "" Then
        If bTrouve Then
            objCodeModule.InsertLines lngCodeLocation + 1, sHead
        Else
            objCodeModule.InsertLines objCodeModule.CountOfLines + 1, sHead
        End If
    End If

    'Insertion du InLine
    If Trim$(sInLine) <> "" Then
        If bTrouve Then
            objCodeModule.CodePane.GetSelection lngStartLine, lngStartColumn, lngEndLine, lngEndColumn
            objCodeModule.InsertLines lngStartLine, sInLine
        Else
            objCodeModule.InsertLines objCodeModule.CountOfLines + 1, sInLine
        End If
    End If

    'Insertion du End
    'redétermination du début
    If objMember.Type = vbext_mt_Property Then
        lngCodeLocation = lngStartLine
        TypePropriete objCodeModule, lngCodeLocation
    Else
        lngCodeLocation = objMember.CodeLocation
    End If

    If Trim$(sEnd) <> "" Then
        If bTrouve Then
            lngLine = lngCodeLocation + 1
            bTrouve = conFaux
            Err.Clear
            Do Until bTrouve
                sTexte = objCodeModule.Lines(lngLine, 1)
                If Err.Number <> 0 Then Exit Do
                If RechercheString(sTexte, "End Sub") Then Exit Do
                If RechercheString(sTexte, "End Function") Then Exit Do
                If RechercheString(sTexte, "End Property") Then Exit Do
                lngLine = lngLine + 1
            Loop
            objCodeModule.InsertLines lngLine, sEnd
        Else
            objCodeModule.InsertLines objCodeModule.CountOfLines + 1, sEnd
        End If
    End If

    Set objCodeModule = Nothing
End Sub

Private Sub MakeToolBar()
    Dim objButton As Button

    With tbMain
        Set .ImageList = imgTB
        Set .HotImageList = imgTB
                
        Set objButton = .Buttons.Add(, "newdata", , , "newdata")
        Set objButton = .Buttons.Add(, "biblio", , , "biblio")
        Set objButton = .Buttons.Add(, "save", , , "save")
        Set objButton = .Buttons.Add(, , , tbrSeparator)
        
        Set objButton = .Buttons.Add(, "newbiblio", , , "newbiblio")
        Set objButton = .Buttons.Add(, "newcategorie", , , "newcategorie")
        Set objButton = .Buttons.Add(, , , tbrSeparator)
        
        Set objButton = .Buttons.Add(, "delete", , , "delete")
        Set objButton = .Buttons.Add(, , , tbrSeparator)
        
        Set objButton = .Buttons.Add(, "voir", , , "voir")
        Set objButton = .Buttons.Add(, "copie", , , "copie")
        Set objButton = .Buttons.Add(, , , tbrSeparator)
        
        Set objButton = .Buttons.Add(, "declareproc", , tbrCheck, "declareproc")
        Set objButton = .Buttons.Add(, "headproc", , tbrCheck, "headproc")
        Set objButton = .Buttons.Add(, "inlineproc", , tbrCheck, "inlineproc")
        Set objButton = .Buttons.Add(, "endproc", , tbrCheck, "endproc")
        Set objButton = .Buttons.Add(, , , tbrSeparator)
        

        'Set objButton = .Buttons.Add(, , , tbrSeparator)
        'Set objButton = .Buttons.Add(, "export", , , "export")
        'Set objButton = .Buttons.Add(, "import", , , "import")
        'Set objButton = .Buttons.Add(, , , tbrSeparator)


        Select Case lngLanguage
            Case c2i_Langue_Français
                .Buttons("newdata").ToolTipText = "Nouvelle base de données"
                .Buttons("biblio").ToolTipText = "Charger une base de données"
                .Buttons("save").ToolTipText = "Sauvegarder la base de données"
                
                .Buttons("newbiblio").ToolTipText = "Créer une bibliothèque"
                .Buttons("newcategorie").ToolTipText = "Créer une catégorie"

                .Buttons("delete").ToolTipText = "Supprimer"
                
                .Buttons("voir").ToolTipText = "Voir/ajouter un élément"
                .Buttons("copie").ToolTipText = "Insérer le code"

                .Buttons("declareproc").ToolTipText = "Insérer le code des déclarations"
                .Buttons("headproc").ToolTipText = "Insérer le code de début de procédure"
                .Buttons("inlineproc").ToolTipText = "Insérer le code interne"
                .Buttons("endproc").ToolTipText = "Insérer le code de fin deprocédure"

                '.Buttons("export").ToolTipText = "Exporter"
                '.Buttons("import").ToolTipText = "Importer"
            Case Else
                .Buttons("newdata").ToolTipText = "New database"
                .Buttons("biblio").ToolTipText = "Load a database"
                .Buttons("save").ToolTipText = "Save database"
                
                .Buttons("newbiblio").ToolTipText = "Create a new library"
                .Buttons("newcategorie").ToolTipText = "Create a new folder"

                .Buttons("delete").ToolTipText = "Delete"

                .Buttons("voir").ToolTipText = "View/Add element"
                .Buttons("copie").ToolTipText = "Insert code"
                
                .Buttons("declareproc").ToolTipText = "Insert declaration code"
                .Buttons("headproc").ToolTipText = "Insert head code"
                .Buttons("inlineproc").ToolTipText = "Insert inline code"
                .Buttons("endproc").ToolTipText = "Insert end code"
                
                '.Buttons("export").ToolTipText = "Export"
                '.Buttons("import").ToolTipText = "Import"
                
        End Select
    End With

    Set objButton = Nothing
End Sub

Private Sub tbMain_ButtonClick(ByVal Button As MSComctlLib.Button)
    Dim objE As cElement

    On Error Resume Next
    Select Case Button.Key
        Case "newdata"
            If tv.Nodes.Count > 0 Then
                If Len(c2iCurrentDataFileName) > 0 Then
                    Enregistrement c2iCurrentDataFileName
                Else
                    SaveLibrary
                End If
            End If
            tv.Nodes.Clear
            c2iCurrentDataFileName = ""
        Case "biblio"
            OpenBiblio
        Case "newbiblio"
            AddBiblio
        Case "newcategorie"
            AddCategorie
        Case "delete"
            If tv.SelectedItem Is Nothing Then Exit Sub
            DeleteNode
        Case "copie"
            If Not tv.SelectedItem Is Nothing Then
                Select Case tv.SelectedItem.Image
                    Case "element"
                        Set objE = Explorer.Elements(tv.SelectedItem.FullPath)
                        ValideInsertion objE
                        Set objE = Nothing
                    Case "web"
                        ConnectionInternet Explorer.Elements(tv.SelectedItem.FullPath).Description
                    Case "mail"
                        MailInternet Explorer.Elements(tv.SelectedItem.FullPath).Description
                End Select
            End If
        Case "voir"
            If Not tv.SelectedItem Is Nothing Then
                Select Case tv.SelectedItem.Image
                    Case "element"
                        Load frmBiblio
                        Set frmBiblio.Element = Explorer.Elements(tv.SelectedItem.FullPath)
                        bFrmBiblio = conVrai
                        frmBiblio.Show
                    Case "web"                             'connexion Internet
                        ConnectionInternet Explorer.Elements(tv.SelectedItem.FullPath).Description
                    Case "mail"
                        MailInternet Explorer.Elements(tv.SelectedItem.FullPath).Description
                    Case Else
                        Load frmBiblio
                        Set frmBiblio.Element = Nothing
                        bFrmBiblio = conVrai
                        frmBiblio.Show
                End Select
            End If
        Case "save"
            SaveLibrary
    End Select
End Sub

Private Sub MailInternet(ByVal sMail As String)
    Dim lngRep As Long
    lngRep = ShellExecute(0, "open", "mailto:" + sMail, vbNullString, vbNullString, SW_NORMAL)
    If lngRep = 0 Then
        Select Case lngLanguage
            Case c2i_Langue_Français
                MsgBox "Impossible d'établir la connection Internet", vbInformation
            Case Else
                MsgBox "Impossible to connect to Internet", vbInformation
        End Select
    End If

End Sub

'Fonction modifiée par René Rhéaume, 29 juillet 2001
'Renvoie 0 s'il n'y a pas d'erreur, 1 si l'erreur provient de l'absence
'de nom de fichier dans la boîte de dialogue ou 2 dans le cas d'une autre
'erreur.
Private Function SaveLibrary() As Byte
    On Error GoTo Fin
    Dim cCommonDialog As cDlgCom
    Set cCommonDialog = New cDlgCom
    With cCommonDialog
        .DefaultEx = ".mdb"
        .Filter = "Bases de données (*.mdb)|*.mdb"
        .FilterIndex = 1
        .Filename = c2iCurrentDataFileName
        .Flags = OFN_HIDEREADONLY + OFN_NOREADONLYRETURN
        .InitDir = App.Path & "\data"
        .ShowSave
        If .Filename = "" Then
            SaveLibrary = 1
        Else
            Enregistrement .Filename
            c2iCurrentDataFileName = .Filename
            SaveLibrary = 0
        End If
    End With
    Set cCommonDialog = Nothing
    Exit Function
    
Fin:
    Set cCommonDialog = Nothing
    SaveLibrary = 2
    Exit Function
End Function

Private Sub DeleteNode()
    tv.Nodes.Remove tv.SelectedItem.Key
End Sub

'Fonction modifiée par René Rhéaume, 29 juillet 2001
'Renvoie 0 s'il n'y a pas d'erreur, 1 si l'erreur provient de l'absence
'de nom de fichier dans la boîte de dialogue ou 2 dans le cas d'une autre
'erreur.
Private Function OpenBiblio() As Byte
    On Error GoTo Fin
    Dim cCommonDialog As cDlgCom
    Set cCommonDialog = New cDlgCom
    With cCommonDialog
        .DefaultEx = ".mdb"
        .Filter = "Bases de données (*.mdb)|*.mdb"
        .FilterIndex = 1
        .Filename = c2iCurrentDataFileName
        .Flags = OFN_HIDEREADONLY + OFN_PATHMUSTEXIST + OFN_FILEMUSTEXIST + OFN_EXPLORER + OFN_LONGNAMES
        .InitDir = App.Path & "\data"
        .ShowOpen
        If .Filename = "" Then
            OpenBiblio = 1
        Else
            OpenBiblio = 0
            ChargeBase .Filename
            c2iCurrentDataFileName = .Filename
        End If
    End With
    Set cCommonDialog = Nothing
    Exit Function
    
Fin:
    Set cCommonDialog = Nothing
    OpenBiblio = 2
    Exit Function
End Function

Private Sub ChargeBase(ByVal sFileName As String)
    tv.Nodes.Clear

    On Error GoTo GestErr
    'destruction de la hiérarchie
    Set Explorer = Nothing
    Set Explorer = New cExplorer

    Dim db As DAO.Database
    Dim rs As DAO.Recordset

    Set db = OpenDatabase(sFileName)
    Set rs = db.OpenRecordset("Elements", dbOpenDynaset)
    Do Until rs.EOF
        Explorer.Elements.Add AnnuleNull(rs, "DeclareProc"), AnnuleNull(rs, "HeadProc"), AnnuleNull(rs, "InLineProc"), AnnuleNull(rs, "EndProc"), AnnuleNull(rs, "Description"), AnnuleNull(rs, "Nom"), AnnuleNull(rs, "Nom")
        rs.MoveNext
    Loop
    rs.Close

    Set rs = Nothing
    db.Close
    Set db = Nothing
    'on lance le remplissage de la bibliothèque
    RempliTV
    Exit Sub

GestErr:
    Set rs = Nothing
    If Not db Is Nothing Then
        db.Close
    End If
    Set db = Nothing
    If lngLanguage = c2i_Langue_Français Then
        MsgBox "Erreur dans le chargement de la base", vbExclamation, "c2iExplorer : Bibliothèque"
    Else
        MsgBox "Error in loading database", vbExclamation, "c2iExplorer : Library"
    End If
    MsgBox "Erreur no " & Err.Number & vbCrLf & Err.Description & vbCrLf & Err.Source, vbExclamation
    'destruction de la hiérarchie
    Set Explorer = Nothing
    Set Explorer = New cExplorer
End Sub

Private Function AnnuleNull(rs As Recordset, sField As String) As String
    If IsNull(rs.Fields(sField)) Then
        AnnuleNull = ""
    Else
        AnnuleNull = rs.Fields(sField)
    End If
End Function

Private Sub AddBiblio()
    Dim sTitle As String, sMessage As String, sM2 As String
    Dim sResult As String

    sTitle = "c2iExplorer"
    Select Case lngLanguage
        Case c2i_Langue_Français
            sMessage = "Saisissez le nom de la nouvelle bibliothèque"
            sM2 = "Impossible, cette bibliothèque existe déjà"
        Case Else
            sMessage = "Input the name of the new library"
            sM2 = "Impossible, this library is still used"
    End Select

    sResult = InputBox(sMessage, sTitle)

    Dim mNode As Node
    On Error Resume Next
    Set mNode = tv.Nodes(sResult)
    If mNode Is Nothing Then
        If Trim$(sResult) <> "" Then
            On Error GoTo Fin
            tv.Nodes.Add , , sResult, sResult, "biblio"
        End If
    Else
        MsgBox sM2, , sTitle
    End If
    Set mNode = Nothing

    Exit Sub
Fin:
    Set mNode = Nothing
    Select Case lngLanguage
        Case c2i_Langue_Français
            MsgBox "Le nom de la bibliothèque n'est pas correct", vbInformation
        Case Else
            MsgBox "The library name is invalid", vbInformation
    End Select
End Sub

Private Sub AddCategorie()
    Dim sTitle As String, sMessage As String, sM2 As String
    Dim sResult As String

    If tv.SelectedItem Is Nothing Then Exit Sub

    If tv.SelectedItem.Image <> "element" Then
        sTitle = "c2iExplorer"
        Select Case lngLanguage
            Case c2i_Langue_Français
                sMessage = "Saisissez le nom de la nouvelle catégorie"
                sM2 = "Impossible, cette catégorie existe déjà"
            Case Else
                sMessage = "Input the name of the new folder"
                sM2 = "Impossible, this folder is still used"
        End Select

        sResult = InputBox(sMessage, sTitle)
        If sResult = "" Then Exit Sub

        Dim mNode As Node
        On Error Resume Next
        Set mNode = tv.Nodes(tv.SelectedItem.Key + tv.PathSeparator + sResult)
        If mNode Is Nothing Then
            tv.Nodes.Add tv.SelectedItem, tvwChild, tv.SelectedItem.Key + tv.PathSeparator + sResult, sResult, "categorie"
        Else
            MsgBox sM2, , sTitle
        End If
    Else
        If lngLanguage = c2i_Langue_Français Then
            MsgBox "Sélectionnez une bibliothèque ou une catégorie pour ajouter une catégorie", vbInformation, "c2iExplorer"
        Else
            MsgBox "Select a library or a folder to add a folder", vbInformation, "c2iExplorer"
        End If
    End If

End Sub

Private Sub UserDocument_Paint()
    UserDocument_Resize
End Sub

Private Sub UserDocument_Resize()
    On Error Resume Next
    tv.Height = ScaleHeight
    tv.Top = 0
    tv.Left = tbMain.Width
    tv.Width = ScaleWidth - tbMain.Width
End Sub

Private Sub UserDocument_Terminate()
    Set TVEx = Nothing
End Sub
